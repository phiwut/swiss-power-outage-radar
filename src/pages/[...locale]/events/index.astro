---
import maplibreCss from "maplibre-gl/dist/maplibre-gl.css?url";
import RadarLayout from "../../../layouts/RadarLayout.astro";
import { Button } from "@/components/starwind/button";
import { Card } from "@/components/starwind/card";
import { Skeleton } from "@/components/starwind/skeleton";
import ArrowLeft from "@tabler/icons/outline/arrow-left.svg";
import "../../../styles/event-brief.css";
import { localeFromParam, localeStaticPaths, pathFor, t, type AppLocale } from "../../../i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
---

<RadarLayout
  title={`${t(locale, "nature.unplannedKind")} | outage.ch`}
  description={t(locale, "site.description")}
  robots="noindex,follow"
  shell="content"
  activeNav="radar"
  locale={locale}
>
  <link slot="head" rel="stylesheet" href={maplibreCss} />
  <section class="detail-page">
    <Button as="a" href={pathFor({ kind: "home" }, locale)} variant="ghost" size="sm" class="mb-2 -ml-2">
      <ArrowLeft class="size-4" />
      {t(locale, "event.backToRadar")}
    </Button>
    <div id="event-shell" aria-live="polite" aria-busy="true">
      <Card size="sm" class="grid gap-2.5 py-4" aria-label={t(locale, "event.loadingAria")}>
        <div class="px-(--card-spacing) grid gap-2.5">
          <Skeleton class="h-4 max-w-40" />
          <Skeleton class="h-10 max-w-lg" />
          <Skeleton class="h-4 max-w-md" />
          <Skeleton class="mt-2 h-48 w-full" />
        </div>
      </Card>
    </div>
  </section>

  <script>
    type Trust = "official" | "corroborated" | "reported";
    type DetailFact = {
      key: string;
      label: string;
      value: string;
      format: "text" | "datetime" | "duration";
    };
    type DetailSource = {
      publisher: string;
      url: string;
      domain: string;
      role: "operator" | "authority" | "media";
      title: string | null;
      published_at: string | null;
      excerpt: string | null;
      facts: Array<{ label: string; value: string; format: "text" | "datetime" }>;
    };
    type DetailResponse = {
      item: {
        id: number;
        location: string;
        url: string;
        received_at: string;
        summary: string;
        trust: Trust;
        status: "upcoming" | "active" | "resolved" | "stale_unconfirmed" | "historical" | null;
      };
      map: null | {
        query: string;
        label: string;
        latitude: number;
        longitude: number;
        precision: "address" | "locality" | "municipality" | "district" | "region";
      };
      facts: DetailFact[];
      timeline: Array<{ key: string; label: string; value: string }>;
      operator: null | {
        name: string;
        role: "Netzbetreiber" | "Behörde";
        area: string | null;
        url: string;
        domain: string;
        profile_url?: string | null;
      };
      sources: DetailSource[];
      evidence: Array<{ snapshot_id: number; image_url: string; source_url: string; publisher: string; captured_at: string; sha256: string; format: "png" }>;
    };

    const eventId = location.pathname.match(/(?:\/events\/|\/(?:stromausfall|panne-de-courant|interruzione-di-corrente|power-outage)\/[^/]*-)(\d+)\/?$/)?.[1];
    const shell = document.querySelector<HTMLElement>("#event-shell")!;
    const escapeHtml = (value: unknown) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
    const fmt = new Intl.DateTimeFormat("de-CH", {
      dateStyle: "long", timeStyle: "short", timeZone: "Europe/Zurich"
    });
    const formatDate = (value: string) => {
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : fmt.format(date);
    };
    const formatDuration = (value: string) => {
      const start = new Date(value).getTime();
      if (!Number.isFinite(start)) return value;
      const minutes = Math.max(0, Math.floor((Date.now() - start) / 60000));
      return minutes >= 60
        ? `${Math.floor(minutes / 60)} Std.${minutes % 60 ? ` ${minutes % 60} Min.` : ""}`
        : `${minutes} Min.`;
    };
    const formatFact = (fact: DetailFact) => {
      if (fact.format === "datetime") return formatDate(fact.value);
      if (fact.format === "duration") return formatDuration(fact.value);
      if (fact.key === "resolution_window" && fact.value.includes("|")) {
        const [from, to] = fact.value.split("|");
        return `zwischen ${formatDate(from)} und ${formatDate(to)}`;
      }
      return fact.value;
    };
    const trustText = (trust: Trust) => trust === "official"
      ? "Offiziell gemeldet"
      : trust === "corroborated"
        ? "Unabhängig bestätigt"
        : "Öffentlich gemeldet";
    const sourceRole = (role: DetailSource["role"]) => role === "operator"
      ? "Netzbetreiber"
      : role === "authority"
        ? "Behörde"
        : "Medienquelle";
    const statusLabel = (status: DetailResponse["item"]["status"]) => {
      if (status === "active") return "Aktiv";
      if (status === "upcoming") return "Bevorstehend";
      if (status === "resolved") return "Behoben";
      if (status === "stale_unconfirmed") return "Unbestätigt";
      if (status === "historical") return "Archiv";
      return "Meldung";
    };
    const zoomFor = (precision: NonNullable<DetailResponse["map"]>["precision"]) =>
      precision === "address" ? 14.2 : precision === "locality" ? 13 : precision === "municipality" ? 11.8 : 10.2;

    function factMarkup(facts: DetailFact[]): string {
      if (!facts.length) return "";
      return `<section class="fact-strip" aria-labelledby="facts-heading">
        <h2 id="facts-heading">Was bekannt ist</h2>
        <dl>${facts.map((fact) => `<div>
          <dt>${escapeHtml(fact.label)}</dt>
          <dd data-fact-key="${escapeHtml(fact.key)}">${escapeHtml(formatFact(fact))}</dd>
        </div>`).join("")}</dl>
      </section>`;
    }

    function timelineMarkup(entries: DetailResponse["timeline"]): string {
      if (!entries.length) return "";
      return `<ol class="brief__times">${entries.map((entry) => `<li>
        <span>${escapeHtml(entry.label)}</span>
        <strong>${escapeHtml(formatDate(entry.value))}</strong>
      </li>`).join("")}</ol>`;
    }

    function operatorMarkup(operator: DetailResponse["operator"]): string {
      if (!operator) return "";
      const profileLink = operator.profile_url
        ? `<a href="${escapeHtml(operator.profile_url)}">Meldungen von ${escapeHtml(operator.name)}</a>`
        : "";
      return `<aside class="operator-block" aria-labelledby="operator-heading">
        <div class="operator-copy">
          <span>${escapeHtml(operator.role)}</span>
          <h2 id="operator-heading">${escapeHtml(operator.name)}</h2>
          ${operator.area ? `<p>${escapeHtml(operator.area)}</p>` : ""}
        </div>
        <div class="operator-actions">
          ${profileLink}
          <a class="operator-official-btn" href="${escapeHtml(operator.url)}" target="_blank" rel="noreferrer">Offizielle Seite
            <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
        </div>
      </aside>`;
    }

    function sourcesMarkup(sources: DetailSource[]): string {
      if (!sources.length) return "";
      return `<section class="sources-block" aria-labelledby="sources-heading">
        <div class="section-heading"><span>Nachvollziehbar</span><h2 id="sources-heading">Meldung & Quellen</h2></div>
        <div class="source-list">${sources.map((source, index) => `<a href="${escapeHtml(source.url)}" target="_blank" rel="noreferrer">
          <span class="source-index">${String(index + 1).padStart(2, "0")}</span>
          <span class="source-copy"><small>${escapeHtml(sourceRole(source.role))}</small><strong>${escapeHtml(source.publisher)}</strong><span>${escapeHtml(source.domain)}</span></span>
          <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>`).join("")}</div>
      </section>`;
    }

    function evidenceMarkup(evidence: DetailResponse["evidence"]): string {
      if (!evidence?.length) return "";
      return `<section class="evidence-block" aria-labelledby="evidence-heading">
        <div class="section-heading"><span>Beweisstück</span><h2 id="evidence-heading">Archivierte Seitenansicht</h2></div>
        <div class="evidence-grid">${evidence.map((entry) => `<figure>
          <a href="${escapeHtml(entry.image_url)}" target="_blank"><img src="${escapeHtml(entry.image_url)}" alt="Archivierter Screenshot der Quelle ${escapeHtml(entry.publisher)}" loading="lazy"></a>
          <figcaption><strong>${escapeHtml(entry.publisher)}</strong><span>Erfasst ${escapeHtml(formatDate(entry.captured_at))} · PNG, verlustfrei</span><code title="${escapeHtml(entry.sha256)}">SHA-256 ${escapeHtml(entry.sha256.slice(0, 16))}…</code></figcaption>
        </figure>`).join("")}</div>
      </section>`;
    }

    async function initializeMap(data: DetailResponse): Promise<void> {
      if (!data.map) return;
      const container = document.querySelector<HTMLElement>("#event-map");
      if (!container) return;
      const hero = container.closest<HTMLElement>(".event-hero");
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let loaded = false;
      const markFailed = () => {
        if (loaded) return;
        hero?.classList.remove("map-loading");
        hero?.classList.add("map-failed");
        const message = hero?.querySelector<HTMLElement>(".map-fallback small");
        if (message) message.textContent = "Kartenansicht vorübergehend nicht verfügbar";
      };
      try {
        const { default: maplibregl } = await import("maplibre-gl");
        const map = new maplibregl.Map({
          container,
          style: "https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json",
          center: [data.map.longitude, data.map.latitude],
          zoom: zoomFor(data.map.precision),
          interactive: false,
          attributionControl: false,
          fadeDuration: reduceMotion ? 0 : 350
        });
        map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-right");
        map.once("load", () => {
          loaded = true;
          hero?.classList.remove("map-loading", "map-failed");
          hero?.classList.add("map-ready");
          map.resize();
          map.addSource("outage-location", {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: { type: "Point", coordinates: [data.map!.longitude, data.map!.latitude] }
            }
          });
          map.addLayer({
            id: "outage-halo",
            type: "circle",
            source: "outage-location",
            paint: { "circle-radius": 23, "circle-color": "#C41E3A", "circle-opacity": 0.16 }
          });
          map.addLayer({
            id: "outage-point",
            type: "circle",
            source: "outage-location",
            paint: {
              "circle-radius": 7,
              "circle-color": "#C41E3A",
              "circle-stroke-color": "#fffaf3",
              "circle-stroke-width": 3
            }
          });
        });
        map.on("error", markFailed);
        window.setTimeout(markFailed, 8_000);
      } catch {
        markFailed();
      }
    }

    async function load(): Promise<void> {
      if (!eventId) throw new Error("Meldung nicht gefunden.");
      const embedded = document.querySelector<HTMLScriptElement>("#outage-event-data")?.textContent;
      let data: DetailResponse;
      if (embedded) {
        data = JSON.parse(embedded) as DetailResponse;
        shell.setAttribute("aria-busy", "false");
        void initializeMap(data);
        return;
      } else {
        const response = await fetch(`/api/public/events/${eventId}`, { cache: "no-store" });
        if (!response.ok) throw new Error("Diese Meldung ist nicht mehr öffentlich verfügbar.");
        data = await response.json() as DetailResponse;
      }
      const hasMap = Boolean(data.map);
      const statusClass = data.item.status ?? "historical";
      const place = data.map?.query || data.item.location;
      shell.innerHTML = `<article class="event-brief" data-status="${escapeHtml(statusClass)}">
        <header class="brief">
          <div class="brief__copy">
            <div class="brief__kicker">
              <span class="radar-badge radar-badge--${escapeHtml(statusClass)}">${escapeHtml(statusLabel(data.item.status))}</span>
              <span class="trust-mark"><i aria-hidden="true"></i>${escapeHtml(trustText(data.item.trust))}</span>
              <span>Eingang ${escapeHtml(formatDate(data.item.received_at))}</span>
            </div>
            <p class="hero-statusline">${escapeHtml(statusLabel(data.item.status))} · Eingang ${escapeHtml(formatDate(data.item.received_at))}</p>
            <h1>Stromausfall in ${escapeHtml(place)}</h1>
            <p class="brief__lede">${escapeHtml(data.item.summary)}</p>
            ${factMarkup(data.facts)}
            ${timelineMarkup(data.timeline)}
            ${operatorMarkup(data.operator)}
          </div>
          <div class="brief__map event-hero ${hasMap ? "has-map map-loading" : "no-map"}">
            ${hasMap ? `<div id="event-map" role="img" aria-label="Karte von ${escapeHtml(data.map!.label)}"></div><div class="map-fallback" aria-hidden="true"><span></span><strong>${escapeHtml(data.map!.label)}</strong><small>Karte wird geladen</small></div>` : ""}
            <div class="hero-wash" aria-hidden="true"></div>
            ${hasMap ? `<span class="map-place">${escapeHtml(data.map!.label)}</span>` : ""}
          </div>
        </header>
        ${sourcesMarkup(data.sources)}
        ${evidenceMarkup(data.evidence)}
        <footer class="detail-note">outage.ch bündelt öffentliche Meldungen. Für Notfälle gelten die Hinweise der lokalen Behörden und Netzbetreiber.</footer>
      </article>`;
      shell.setAttribute("aria-busy", "false");
      void initializeMap(data);
      window.setInterval(() => {
        for (const fact of data.facts.filter((entry) => entry.format === "duration")) {
          const target = shell.querySelector<HTMLElement>(`[data-fact-key="${fact.key}"]`);
          if (target) target.textContent = formatFact(fact);
        }
      }, 60_000);
    }

    load().catch((error) => {
      shell.innerHTML = `<div class="detail-error"><strong>Meldung nicht verfügbar</strong><p>${escapeHtml(error instanceof Error ? error.message : String(error))}</p><a href="/">Zurück zur Übersicht</a></div>`;
      shell.setAttribute("aria-busy", "false");
    });
  </script>


</RadarLayout>
