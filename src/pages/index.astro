---
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Letzte Stromausfall-Meldungen Schweiz | outage.ch"
  description="Die zuletzt eingegangenen Stromausfall-Meldungen für die Schweiz – chronologisch und mit Originalquelle."
>
  <section class="feed-page">
    <header class="feed-intro">
      <p class="section-label text-accent">Schweiz · letzte Eingänge</p>
      <h1>Letzte Stromausfall-Meldungen</h1>
      <p>Chronologisch nach Eingang – mit Originalquelle und klarer Kennzeichnung, ob eine Meldung offiziell, bestätigt oder erst einmal gemeldet ist.</p>
    </header>

    <div class="feed-tools" aria-label="Meldungen filtern und aktualisieren">
      <label class="search-field">
        <span class="sr-only">Ort suchen</span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input id="event-search" type="search" placeholder="Ort suchen" autocomplete="off" />
      </label>
      <button id="refresh-button" type="button">Aktualisieren</button>
    </div>

    <main class="feed-shell" aria-live="polite" aria-busy="true">
      <div id="events-list" class="feed-list">
        <div class="feed-loading"></div>
        <div class="feed-loading"></div>
        <div class="feed-loading"></div>
      </div>
      <div class="feed-footer">
        <button id="load-more" type="button" hidden>Weitere laden</button>
        <p id="feed-note">Meldungen werden geladen …</p>
      </div>
    </main>

    <p class="public-note">outage.ch ist ein unabhängiger öffentlicher Radar und kein offizieller Notfallkanal.</p>
  </section>

  <script>
    type PublicItem = {
      id: number;
      location: string;
      received_at: string;
      started_at: string | null;
      resolved_at: string | null;
      status: "active" | "resolved" | null;
      summary: string;
      trust: "official" | "corroborated" | "reported";
      source: { publisher: string; url: string; domain: string };
    };

    const state: { items: PublicItem[]; nextCursor: string | null; query: string; loading: boolean; generatedAt: string | null } = {
      items: [],
      nextCursor: null,
      query: "",
      loading: false,
      generatedAt: null
    };
    const list = document.querySelector<HTMLElement>("#events-list")!;
    const shell = document.querySelector<HTMLElement>(".feed-shell")!;
    const note = document.querySelector<HTMLElement>("#feed-note")!;
    const loadMore = document.querySelector<HTMLButtonElement>("#load-more")!;
    const refresh = document.querySelector<HTMLButtonElement>("#refresh-button")!;

    const escapeHtml = (value: unknown) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

    const dateFormatter = new Intl.DateTimeFormat("de-CH", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Zurich"
    });
    const timeFormatter = new Intl.DateTimeFormat("de-CH", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Zurich"
    });
    const dayKey = (value: Date) => new Intl.DateTimeFormat("en-CA", {
      year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Europe/Zurich"
    }).format(value);

    function receivedLabel(value: string): { day: string; time: string; full: string } {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return { day: "Eingang", time: value, full: value };
      const now = new Date();
      const yesterday = new Date(now.getTime() - 86400000);
      const key = dayKey(date);
      const day = key === dayKey(now) ? "Heute" : key === dayKey(yesterday) ? "Gestern" : dateFormatter.format(date).split(",")[0];
      return { day, time: timeFormatter.format(date), full: dateFormatter.format(date) };
    }

    function visibleItems(): PublicItem[] {
      const query = state.query.trim().toLocaleLowerCase("de-CH");
      if (!query) return state.items;
      return state.items.filter((item) => `${item.location} ${item.summary} ${item.source.publisher}`.toLocaleLowerCase("de-CH").includes(query));
    }

    function render(): void {
      const items = visibleItems();
      list.innerHTML = items.map((item) => {
        const received = receivedLabel(item.received_at);
        const trust = item.trust === "official"
          ? "Offizielle Quelle"
          : item.trust === "corroborated"
            ? "Unabhängig bestätigt"
            : "Gemeldet";
        return `<a class="feed-row" href="/events/${item.id}" aria-label="Stromausfall-Meldung für ${escapeHtml(item.location)}, eingegangen ${escapeHtml(received.full)}">
          <time datetime="${escapeHtml(item.received_at)}" title="${escapeHtml(received.full)}">
            <span>${escapeHtml(received.day)}</span>
            <strong>${escapeHtml(received.time)}</strong>
          </time>
          <span class="feed-copy">
            <strong class="feed-location">${escapeHtml(item.location)}</strong>
            <span class="feed-summary">${escapeHtml(item.summary)}</span>
            <span class="feed-source">${escapeHtml(item.source.publisher)} · ${trust}</span>
          </span>
          <svg class="row-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>`;
      }).join("");

      if (!items.length) {
        list.innerHTML = `<div class="feed-empty"><strong>${state.query ? "Kein passender Ort" : "Keine Meldungen"}</strong><span>${state.query ? "Versuche einen anderen Suchbegriff." : "Sobald eine Meldung aus einer nachvollziehbaren Quelle eingeht, erscheint sie hier."}</span></div>`;
      }
      loadMore.hidden = !state.nextCursor || Boolean(state.query);
      note.textContent = state.query
        ? `${items.length} Treffer in ${state.items.length} geladenen Meldungen`
        : `${state.items.length} Meldung${state.items.length === 1 ? "" : "en"} geladen${state.generatedAt ? ` · Stand ${timeFormatter.format(new Date(state.generatedAt))}` : ""}`;
      shell.setAttribute("aria-busy", "false");
    }

    async function load(reset = false): Promise<void> {
      if (state.loading) return;
      state.loading = true;
      refresh.disabled = true;
      loadMore.disabled = true;
      try {
        const cursor = reset ? null : state.nextCursor;
        const params = new URLSearchParams({ limit: "10" });
        if (cursor) params.set("before", cursor);
        const response = await fetch(`/api/public/events?${params}`, { cache: "no-store" });
        if (!response.ok) throw new Error("Die Meldungen konnten nicht geladen werden.");
        const data = await response.json();
        state.items = reset ? (data.items ?? []) : [...state.items, ...(data.items ?? [])];
        state.nextCursor = data.next_cursor ?? null;
        state.generatedAt = data.generated_at ?? state.generatedAt;
        render();
      } catch (error) {
        list.innerHTML = `<div class="feed-error">${escapeHtml(error instanceof Error ? error.message : String(error))}</div>`;
        list.insertAdjacentHTML("beforeend", `<button class="feed-retry" type="button">Wiederholen</button>`);
        list.querySelector<HTMLButtonElement>(".feed-retry")?.addEventListener("click", () => load(true));
        note.textContent = "Bitte später erneut versuchen.";
        shell.setAttribute("aria-busy", "false");
      } finally {
        state.loading = false;
        refresh.disabled = false;
        loadMore.disabled = false;
      }
    }

    document.querySelector<HTMLInputElement>("#event-search")!.addEventListener("input", (event) => {
      state.query = (event.currentTarget as HTMLInputElement).value;
      render();
    });
    refresh.addEventListener("click", () => load(true));
    loadMore.addEventListener("click", () => load(false));
    load(true);
  </script>

  <style is:global>
    .feed-page { margin: 0 auto; max-width: 960px; padding: clamp(2.75rem, 7vw, 6rem) 0 4rem; }
    .feed-intro { max-width: 760px; }
    .feed-intro h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 6vw, 4.25rem); font-weight: 800; letter-spacing: -0.045em; line-height: .98; margin: .75rem 0 0; }
    .feed-intro > p:last-child { color: var(--color-muted); font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.65; margin: 1.25rem 0 0; max-width: 680px; }
    .feed-tools { align-items: center; display: flex; gap: .65rem; justify-content: space-between; margin: 2.5rem 0 .75rem; }
    .search-field { align-items: center; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-md); color: var(--color-muted); display: flex; gap: .65rem; max-width: 320px; padding: 0 .85rem; width: 100%; }
    .search-field input { background: transparent; border: 0; color: var(--color-ink); font: inherit; height: 2.75rem; min-width: 0; outline: 0; width: 100%; }
    .feed-tools button, .feed-footer button { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-md); color: var(--color-ink); font-size: .875rem; font-weight: 600; min-height: 2.75rem; padding: .65rem 1rem; }
    .feed-tools button:hover, .feed-footer button:hover { border-color: var(--color-rule-strong); background: var(--color-surface-2); }
    .feed-shell { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: .75rem; box-shadow: 0 18px 50px color-mix(in oklch, var(--color-ink) 7%, transparent); overflow: hidden; }
    .feed-list { display: grid; }
    .feed-row { align-items: center; border-bottom: 1px solid var(--color-rule); color: inherit; display: grid; gap: 1.25rem; grid-template-columns: 116px minmax(0, 1fr) 24px; min-height: 132px; padding: 1.35rem 1.5rem; text-decoration: none; }
    .feed-row:hover { background: color-mix(in oklch, var(--color-accent-soft) 34%, var(--color-surface)); }
    .feed-row time { display: grid; font-variant-numeric: tabular-nums; gap: .2rem; }
    .feed-row time span { color: var(--color-muted); font-family: var(--font-mono); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
    .feed-row time strong { font-family: var(--font-display); font-size: 1.35rem; }
    .feed-copy { display: grid; gap: .4rem; min-width: 0; }
    .feed-location { font-family: var(--font-display); font-size: clamp(1.2rem, 2.6vw, 1.6rem); letter-spacing: -.025em; line-height: 1.15; }
    .feed-summary { color: var(--color-muted); display: -webkit-box; font-size: .98rem; line-height: 1.55; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .feed-source { color: var(--color-faint); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .025em; }
    .row-arrow { height: 1.25rem; stroke: var(--color-faint); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; width: 1.25rem; }
    .feed-row:hover .row-arrow { stroke: var(--color-accent); transform: translateX(2px); }
    .feed-footer { align-items: center; display: flex; justify-content: space-between; min-height: 62px; padding: .65rem 1rem; }
    .feed-footer p { color: var(--color-faint); font-size: .78rem; margin-left: auto; }
    .feed-loading { animation: pulse 1.4s ease-in-out infinite; background: linear-gradient(90deg, var(--color-surface), var(--color-surface-2), var(--color-surface)); border-bottom: 1px solid var(--color-rule); height: 132px; }
    .feed-empty, .feed-error { display: grid; gap: .5rem; padding: 4rem 1.5rem; text-align: center; }
    .feed-empty span { color: var(--color-muted); }
    .feed-error { color: var(--color-danger); }
    .feed-retry { background: var(--color-ink); border: 0; border-radius: var(--radius-md); color: var(--color-surface); justify-self: center; margin: 0 0 2rem; min-height: 2.75rem; padding: .65rem 1rem; }
    .public-note { color: var(--color-faint); font-size: .78rem; line-height: 1.6; margin: 1rem .25rem 0; }
    @keyframes pulse { 50% { opacity: .58; } }
    @media (max-width: 640px) {
      .feed-page { padding-top: 2.5rem; }
      .feed-tools { align-items: stretch; flex-direction: column; margin-top: 2rem; }
      .search-field { max-width: none; }
      .feed-tools button { width: 100%; }
      .feed-row { align-items: start; gap: .85rem; grid-template-columns: minmax(0, 1fr) 18px; min-height: 0; padding: 1.15rem; }
      .feed-row time { display: flex; gap: .45rem; grid-column: 1 / -1; }
      .feed-row time strong { font-family: var(--font-mono); font-size: .72rem; }
      .feed-summary { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
      .row-arrow { align-self: center; }
      .feed-footer { align-items: stretch; flex-direction: column; gap: .65rem; }
      .feed-footer p { margin: 0; text-align: center; }
    }
  </style>
</RadarLayout>
