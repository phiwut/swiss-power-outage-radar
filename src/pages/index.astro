---
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout title="Stromausfall Radar">
  <section class="grid gap-3 py-3 xl:grid-cols-[minmax(0,1fr)_340px]">
    <div class="panel rounded-md p-3 sm:p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Chronologische Lage</p>
          <h1 class="mt-1 font-display text-2xl font-bold leading-tight sm:text-3xl">Alle Event-Akten, nach Zeit sortiert.</h1>
        </div>
        <div class="hidden items-center gap-2 lg:flex">
          <input id="event-search" class="w-64 rounded-md border border-rule bg-surface px-3 py-2 text-sm text-ink placeholder:text-faint" placeholder="Ort, Quelle, Ursache" />
          <select id="sort-select" class="rounded-md border border-rule bg-surface px-3 py-2 text-sm text-ink">
            <option value="newest">Neueste zuerst</option>
            <option value="oldest">Älteste zuerst</option>
            <option value="score">Höchster Score</option>
          </select>
          <button id="refresh-button" class="rounded-md border border-ink bg-ink px-3 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-surface" type="button">Aktualisieren</button>
        </div>
      </div>

      <div id="event-metrics" class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
        {["Aktiv", "Zu prüfen", "Belegt", "Verworfen", "Mails 24h"].map((label) => (
          <div class="loading-stripe h-20 rounded-md border border-rule bg-surface2 p-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">{label}</span>
          </div>
        ))}
      </div>

      <div class="mt-4 hidden items-center justify-between gap-3 border-t border-rule pt-3 lg:flex">
        <div id="status-filters" class="flex flex-wrap gap-2">
          {[
            ["all", "Alle"],
            ["active", "Aktiv"],
            ["needs_review", "Zu prüfen"],
            ["corroborated", "Belegt"],
            ["dismissed", "Archiv"]
          ].map(([value, label]) => (
            <button class="filter-button rounded-md border border-rule bg-surface px-3 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted hover:text-ink" data-status={value} type="button">{label}</button>
          ))}
        </div>
        <span id="event-count" class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[11px] text-muted">-</span>
      </div>
    </div>

    <aside class="panel rounded-md p-3">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="font-display text-lg font-bold">Signalfluss</h2>
          <p class="mt-1 text-sm text-muted">28 Tage Quellen, Events und Mails.</p>
        </div>
        <span id="activity-total" class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[11px] text-muted">-</span>
      </div>
      <div id="activity-grid" class="mt-4 grid grid-cols-7 gap-1">
        {Array.from({ length: 28 }).map(() => <span class="h-7 rounded bg-surface2"></span>)}
      </div>
      <div id="activity-legend" class="mt-3 grid grid-cols-3 gap-2 text-center font-mono text-[10px] uppercase tracking-[0.08em] text-muted">
        <span>Alerts</span>
        <span>Events</span>
        <span>Mails</span>
      </div>
    </aside>
  </section>

  <section class="grid gap-3 pb-24 lg:pb-4 xl:grid-cols-[minmax(0,1fr)_340px]">
    <section class="panel rounded-md">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule px-3 py-2 sm:px-4">
        <div>
          <h2 class="font-display text-lg font-bold">Event-Timeline</h2>
          <p class="text-sm text-muted">Zeit, Ort, Score, Quellenlage. Jede Zeile ist eine Akte.</p>
        </div>
        <span id="mobile-count-mirror" class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[11px] text-muted lg:hidden">-</span>
      </div>
      <div id="events-list" class="grid gap-0 p-2 sm:p-3">
        <div class="loading-stripe h-28 rounded-md bg-surface2"></div>
        <div class="loading-stripe mt-2 h-28 rounded-md bg-surface2"></div>
      </div>
    </section>

    <aside class="grid h-fit gap-3">
      <section class="panel rounded-md p-3">
        <h2 class="font-display text-lg font-bold">Was braucht Aufmerksamkeit?</h2>
        <div id="attention-list" class="mt-3 grid gap-2"></div>
      </section>

      <section id="system-strip" class="panel rounded-md p-3">
        <button id="system-toggle" class="flex w-full items-center justify-between gap-3 text-left" type="button">
          <span class="font-display text-lg font-bold">System</span>
          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Details</span>
        </button>
        <div id="system-panel" class="mt-3 hidden grid gap-2">
          <div id="run-summary" class="rounded-md border border-rule bg-surface2 p-3"></div>
          <div id="feed-health" class="grid gap-2"></div>
          <div class="rounded-md border border-rule bg-surface2 p-3">
            <label class="block font-mono text-[10px] uppercase tracking-[0.1em] text-muted" for="admin-token-input">Admin Login</label>
            <input id="admin-token-input" class="mt-2 w-full rounded-md border border-rule bg-surface px-3 py-2 font-mono text-xs text-ink" type="password" placeholder="Token lokal speichern" />
            <p id="admin-token-state" class="mt-2 font-mono text-[10px] text-muted">Nicht angemeldet</p>
          </div>
        </div>
      </section>
    </aside>
  </section>

  <nav class="fixed inset-x-2 bottom-2 z-40 grid gap-2 rounded-md border border-rule bg-surface/95 p-2 shadow-panel backdrop-blur lg:hidden">
    <input id="mobile-search" class="rounded-md border border-rule bg-surface2 px-3 py-2 text-sm text-ink placeholder:text-faint" placeholder="Suchen" />
    <div class="grid grid-cols-[1fr_1fr_auto_auto] gap-2">
      <select id="mobile-status" class="min-w-0 rounded-md border border-rule bg-surface2 px-2 py-2 text-sm text-ink">
        <option value="all">Alle</option>
        <option value="active">Aktiv</option>
        <option value="needs_review">Zu prüfen</option>
        <option value="corroborated">Belegt</option>
        <option value="dismissed">Archiv</option>
      </select>
      <select id="mobile-sort" class="min-w-0 rounded-md border border-rule bg-surface2 px-2 py-2 text-sm text-ink">
        <option value="newest">Neu</option>
        <option value="oldest">Alt</option>
        <option value="score">Score</option>
      </select>
      <button id="mobile-refresh" class="rounded-md border border-rule bg-surface2 px-3 py-2 font-mono text-[11px] uppercase text-ink" type="button">Neu</button>
      <button id="mobile-admin" class="rounded-md border border-ink bg-ink px-3 py-2 font-mono text-[11px] uppercase text-surface" type="button">Admin</button>
    </div>
  </nav>

  <script>
    const fmt = new Intl.DateTimeFormat("de-CH", {
      dateStyle: "short",
      timeStyle: "short",
      timeZone: "Europe/Zurich"
    });
    const dayFmt = new Intl.DateTimeFormat("de-CH", {
      weekday: "short",
      day: "2-digit",
      month: "2-digit",
      timeZone: "Europe/Zurich"
    });

    const viewState = {
      events: [],
      status: "all",
      query: "",
      sort: "newest"
    };

    const labels = {
      status: {
        needs_review: "Zu prüfen",
        corroborated: "Mehrfach belegt",
        dismissed: "Verworfen",
        resolved: "Behoben"
      },
      nature: {
        planned: "Geplant",
        unplanned: "Ungeplant",
        unknown: "Unklar"
      },
      cause: {
        planned_maintenance: "Wartung",
        weather: "Wetter",
        tree_or_overhead_line: "Baum / Freileitung",
        construction_damage: "Bauarbeiten",
        cable_damage: "Kabelschaden",
        transformer_or_substation: "Trafostation",
        technical_fault: "Technische Störung",
        fire: "Brand",
        overload: "Überlast",
        third_party_damage: "Dritteinwirkung",
        water_or_flooding: "Wasser",
        unknown: "Ursache unklar"
      },
      research: {
        not_started: "Nicht geprüft",
        running: "Prüft",
        completed: "Geprüft",
        failed: "Fehler"
      },
      evidence: {
        weak: "Schwach",
        plausible: "Plausibel",
        corroborated: "Mehrfach",
        official: "Offiziell"
      }
    };

    const label = (group, value) => labels[group]?.[value] ?? value ?? "-";
    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

    function normalize(value) {
      return String(value ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
    }

    function formatDate(value) {
      if (!value) return "-";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : fmt.format(date);
    }

    function formatDay(value) {
      if (!value) return "-";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : dayFmt.format(date);
    }

    function durationLabel(start, end) {
      if (!start || !end) return "-";
      const seconds = Math.max(0, Math.round((new Date(end) - new Date(start)) / 1000));
      if (!Number.isFinite(seconds)) return "-";
      if (seconds < 60) return "<1m";
      if (seconds < 3600) return `${Math.floor(seconds / 60)}m`;
      if (seconds < 86400) return `${Math.floor(seconds / 3600)}h`;
      return `${Math.floor(seconds / 86400)}d`;
    }

    function statusClass(status) {
      if (status === "corroborated") return "border-ok bg-oksoft text-ok";
      if (status === "dismissed") return "border-rule bg-surface2 text-muted";
      if (status === "resolved") return "border-accent bg-accentsoft text-accent";
      return "border-warn bg-warnsoft text-warn";
    }

    function railColor(status) {
      if (status === "corroborated") return "var(--color-ok)";
      if (status === "dismissed") return "var(--color-rule-strong)";
      if (status === "resolved") return "var(--color-accent)";
      return "var(--color-warn)";
    }

    function scoreOf(event) {
      return Math.max(0, Math.min(100, Math.round(Number(event.event_score ?? Number(event.confidence ?? 0) * 100))));
    }

    function statusCounts(rows) {
      return (rows ?? []).reduce((acc, row) => {
        acc[row.status] = Number(row.count ?? 0);
        return acc;
      }, {});
    }

    function visibleEvents() {
      const query = viewState.query.toLowerCase();
      const rows = (viewState.events ?? []).filter((event) => {
        const statusMatches =
          viewState.status === "all" ||
          (viewState.status === "active" ? event.status !== "dismissed" : event.status === viewState.status);
        const haystack = `${event.title ?? ""} ${event.location_text ?? ""} ${event.primary_source_title ?? ""} ${event.cause_category ?? ""} ${event.research_summary_de ?? ""}`.toLowerCase();
        return statusMatches && haystack.includes(query);
      });
      return rows.sort((a, b) => {
        if (viewState.sort === "score") return scoreOf(b) - scoreOf(a);
        const left = new Date(a.last_seen_at ?? a.first_seen_at).getTime();
        const right = new Date(b.last_seen_at ?? b.first_seen_at).getTime();
        return viewState.sort === "oldest" ? left - right : right - left;
      });
    }

    function renderEventMetrics(data) {
      const totals = data.totals ?? {};
      const counts = statusCounts(data.statusCounts);
      const active = (data.events ?? []).filter((event) => event.status !== "dismissed").length;
      const metrics = [
        ["Aktiv", active, "nicht verworfen"],
        ["Zu prüfen", counts.needs_review ?? 0, "manueller Blick"],
        ["Belegt", counts.corroborated ?? 0, "mehrere Signale"],
        ["Verworfen", counts.dismissed ?? 0, "bereinigt"],
        ["Mails 24h", totals.emails_last_24h ?? 0, "gesendet"]
      ];
      document.querySelector("#event-metrics").innerHTML = metrics.map(([name, value, hint]) => `
        <div class="rounded-md border border-rule bg-surface/90 p-3">
          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">${escapeHtml(name)}</span>
          <div class="mt-2 flex items-end justify-between gap-2">
            <strong class="metric-value block font-display text-3xl font-bold leading-none">${escapeHtml(value)}</strong>
            <span class="pb-1 text-right font-mono text-[10px] text-muted">${escapeHtml(hint)}</span>
          </div>
        </div>
      `).join("");
    }

    function renderActivity(days) {
      const rows = days ?? [];
      const max = Math.max(1, ...rows.map((row) => Number(row.items ?? 0) + Number(row.events ?? 0) + Number(row.emails ?? 0)));
      const total = rows.reduce((sum, row) => sum + Number(row.items ?? 0), 0);
      document.querySelector("#activity-total").textContent = `${total} Alerts`;
      document.querySelector("#activity-grid").innerHTML = rows.map((row) => {
        const value = Number(row.items ?? 0) + Number(row.events ?? 0) + Number(row.emails ?? 0);
        const level = value === 0 ? 0 : Math.max(1, Math.ceil((value / max) * 4));
        const classes = ["bg-surface2", "bg-accentsoft", "bg-[color:color-mix(in_oklch,var(--color-accent)_28%,var(--color-surface))]", "bg-[color:color-mix(in_oklch,var(--color-accent)_52%,var(--color-surface))]", "bg-accent"];
        return `<span title="${escapeHtml(row.day)} · ${value} Aktivität" class="h-7 rounded border border-rule ${classes[level]}"></span>`;
      }).join("");
    }

    function renderAttention(events) {
      const rows = [...(events ?? [])]
        .filter((event) => event.status !== "dismissed")
        .sort((a, b) => {
          const aWeight = (a.status === "needs_review" ? 30 : 0) + (a.research_status !== "completed" ? 20 : 0) + (100 - scoreOf(a));
          const bWeight = (b.status === "needs_review" ? 30 : 0) + (b.research_status !== "completed" ? 20 : 0) + (100 - scoreOf(b));
          return bWeight - aWeight;
        })
        .slice(0, 5);
      document.querySelector("#attention-list").innerHTML = rows.map((event) => `
        <a href="/events/${event.id}" class="rounded-md border border-rule bg-surface2 p-3 hover:border-rulestrong">
          <div class="flex items-center justify-between gap-2">
            <strong class="truncate text-sm">${escapeHtml(event.location_text || event.title)}</strong>
            <span class="font-mono text-[11px] text-muted">${scoreOf(event)}%</span>
          </div>
          <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted">${escapeHtml(label("status", event.status))} · ${escapeHtml(label("research", event.research_status || "not_started"))}</p>
        </a>
      `).join("") || `<p class="text-sm text-muted">Aktuell keine offenen Akten.</p>`;
    }

    function renderFeeds(feeds) {
      document.querySelector("#feed-health").innerHTML = (feeds ?? []).map((feed) => `
        <div class="rounded-md border border-rule bg-surface p-3">
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-[11px] uppercase tracking-[0.1em]">${escapeHtml(feed.feed_language)}</span>
            <span class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[10px] text-muted">${escapeHtml(feed.items_new_last_run ?? 0)} neu</span>
          </div>
          <p class="mt-2 font-mono text-[10px] leading-5 text-muted">${escapeHtml(formatDate(feed.last_success_at))}</p>
          ${feed.last_error ? `<p class="mt-2 text-sm text-danger">${escapeHtml(feed.last_error)}</p>` : ""}
        </div>
      `).join("") || `<p class="text-sm text-muted">Noch keine Feed-Daten.</p>`;
    }

    function renderRunSummary(data) {
      const lastRun = data.lastRun ?? {};
      const seconds = lastRun.started_at && lastRun.finished_at
        ? Math.max(0, Math.round((new Date(lastRun.finished_at) - new Date(lastRun.started_at)) / 1000))
        : null;
      document.querySelector("#run-summary").innerHTML = `
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Letzter Worker-Run</p>
        <div class="mt-1 flex items-end justify-between gap-3">
          <strong class="font-display text-xl">${escapeHtml(lastRun.status ?? "-")}</strong>
          <span class="font-mono text-[11px] text-muted">${seconds === null ? "-" : `${seconds}s`}</span>
        </div>
        <div class="mt-3 grid grid-cols-3 gap-2 font-mono text-[11px] text-muted">
          <span>${escapeHtml(lastRun.items_seen ?? 0)} gesehen</span>
          <span>${escapeHtml(lastRun.items_new ?? 0)} neu</span>
          <span>${escapeHtml(lastRun.emails_sent ?? 0)} Mails</span>
        </div>
      `;
    }

    function renderEvents() {
      const rows = visibleEvents();
      const countText = `${rows.length} von ${(viewState.events ?? []).length}`;
      document.querySelector("#event-count").textContent = countText;
      document.querySelector("#mobile-count-mirror").textContent = countText;
      let currentDay = "";
      const html = rows.map((event) => {
        const day = formatDay(event.last_seen_at || event.first_seen_at);
        const dayHeader = day !== currentDay ? `<div class="sticky top-[74px] z-10 mt-1 border-b border-rule bg-bg/90 px-2 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-muted backdrop-blur">${escapeHtml(day)}</div>` : "";
        currentDay = day;
        const score = scoreOf(event);
        const researchPct = event.fact_confidence === null || event.fact_confidence === undefined ? null : Math.max(0, Math.min(100, Math.round(Number(event.fact_confidence) * 100)));
        const summary = event.research_summary_de || event.summary || event.primary_source_title || "Keine Kurzfassung";
        return `
          ${dayHeader}
          <a href="/events/${event.id}" class="timeline-row status-rail block border-b border-rule bg-surface px-3 py-3 hover:bg-surface2 sm:px-4" style="--rail-color:${railColor(event.status)}">
            <div class="grid gap-3 lg:grid-cols-[120px_minmax(0,1fr)_270px] lg:items-start">
              <div class="pl-2 font-mono text-[11px] text-muted">
                <strong class="block text-ink">${escapeHtml(formatDate(event.last_seen_at || event.first_seen_at))}</strong>
                <span>${escapeHtml(durationLabel(event.first_seen_at, event.last_seen_at))}</span>
              </div>
              <div class="min-w-0 pl-2">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="rounded-md border px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em] ${statusClass(event.status)}">${escapeHtml(label("status", event.status))}</span>
                  <span class="rounded-md border ${event.evidence_level === "official" ? "border-ok bg-oksoft text-ok" : "border-rule bg-surface2 text-muted"} px-2 py-1 font-mono text-[10px]">${escapeHtml(label("evidence", event.evidence_level || "weak"))}</span>
                  <span class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[10px] text-muted">${escapeHtml(label("research", event.research_status || "not_started"))}</span>
                </div>
                <h3 class="clamp-title mt-2 font-display text-xl font-bold leading-tight">${escapeHtml(event.location_text || "Ort unklar")}</h3>
                <p class="mt-1 line-clamp-2 text-sm leading-6 text-muted">${escapeHtml(summary)}</p>
              </div>
              <div class="grid gap-2 pl-2 lg:pl-0">
                <div class="grid grid-cols-3 gap-2 text-center font-mono text-[11px]">
                  <span class="rounded-md border border-rule bg-surface2 p-2"><strong class="block text-sm text-ink">${score}%</strong>Score</span>
                  <span class="rounded-md border border-rule bg-surface2 p-2"><strong class="block text-sm text-ink">${escapeHtml(event.source_count ?? 0)}</strong>Quellen</span>
                  <span class="rounded-md border border-rule bg-surface2 p-2"><strong class="block text-sm text-ink">${researchPct === null ? "-" : `${researchPct}%`}</strong>Fakten</span>
                </div>
                <div class="flex flex-wrap gap-1.5 font-mono text-[10px] text-muted">
                  <span class="rounded-md border border-rule bg-surface2 px-2 py-1">${escapeHtml(label("nature", event.outage_nature || "unknown"))}</span>
                  <span class="rounded-md border border-rule bg-surface2 px-2 py-1">${escapeHtml(label("cause", event.cause_category || "unknown"))}</span>
                </div>
              </div>
            </div>
          </a>
        `;
      }).join("");
      document.querySelector("#events-list").innerHTML = html || `<div class="rounded-md border border-rule bg-surface p-6 text-sm text-muted">Keine passenden Event-Akten.</div>`;
      syncFilterButtons();
    }

    function syncFilterButtons() {
      document.querySelectorAll(".filter-button").forEach((button) => {
        const active = button.dataset.status === viewState.status;
        button.className = active
          ? "filter-button rounded-md border border-ink bg-ink px-3 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-surface"
          : "filter-button rounded-md border border-rule bg-surface px-3 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted hover:text-ink";
      });
      const mobileStatus = document.querySelector("#mobile-status");
      if (mobileStatus) mobileStatus.value = viewState.status;
      const sortSelect = document.querySelector("#sort-select");
      const mobileSort = document.querySelector("#mobile-sort");
      if (sortSelect) sortSelect.value = viewState.sort;
      if (mobileSort) mobileSort.value = viewState.sort;
    }

    async function loadRadar() {
      document.querySelector("#events-list").classList.add("opacity-60");
      const response = await fetch("/api/public/status", { cache: "no-store" });
      if (!response.ok) throw new Error("Status konnte nicht geladen werden");
      const data = await response.json();
      viewState.events = data.events ?? [];
      renderEventMetrics(data);
      renderActivity(data.activity);
      renderAttention(viewState.events);
      renderRunSummary(data);
      renderFeeds(data.feedHealth);
      renderEvents();
      document.querySelector("#events-list").classList.remove("opacity-60");
    }

    const tokenInput = document.querySelector("#admin-token-input");
    const tokenState = document.querySelector("#admin-token-state");
    function syncAdminToken() {
      const value = localStorage.getItem("outage_admin_token") ?? "";
      tokenInput.value = value;
      tokenState.textContent = value ? "Angemeldet, Controls in Akten sichtbar" : "Nicht angemeldet";
    }
    tokenInput.addEventListener("input", (event) => {
      const value = event.target.value.trim();
      if (value) localStorage.setItem("outage_admin_token", value);
      else localStorage.removeItem("outage_admin_token");
      syncAdminToken();
    });

    function openSystemPanel() {
      document.querySelector("#system-panel").classList.remove("hidden");
      document.querySelector("#system-strip").scrollIntoView({ behavior: "smooth", block: "nearest" });
      tokenInput.focus();
    }
    window.addEventListener("outage:admin-login", openSystemPanel);
    document.querySelector("#mobile-admin").addEventListener("click", openSystemPanel);
    syncAdminToken();

    async function refreshWith(button, shortLabel = "Neu") {
      const original = button.textContent;
      button.textContent = "Lädt";
      try {
        await loadRadar();
      } finally {
        button.textContent = original || shortLabel;
      }
    }

    document.querySelector("#refresh-button").addEventListener("click", (event) => refreshWith(event.currentTarget, "Aktualisieren"));
    document.querySelector("#mobile-refresh").addEventListener("click", (event) => refreshWith(event.currentTarget, "Neu"));
    document.querySelector("#event-search").addEventListener("input", (event) => {
      viewState.query = event.target.value ?? "";
      document.querySelector("#mobile-search").value = viewState.query;
      renderEvents();
    });
    document.querySelector("#mobile-search").addEventListener("input", (event) => {
      viewState.query = event.target.value ?? "";
      document.querySelector("#event-search").value = viewState.query;
      renderEvents();
    });
    document.querySelector("#sort-select").addEventListener("change", (event) => {
      viewState.sort = event.target.value;
      renderEvents();
    });
    document.querySelector("#mobile-sort").addEventListener("change", (event) => {
      viewState.sort = event.target.value;
      renderEvents();
    });
    document.querySelector("#mobile-status").addEventListener("change", (event) => {
      viewState.status = event.target.value;
      renderEvents();
    });
    document.querySelectorAll(".filter-button").forEach((button) => {
      button.addEventListener("click", () => {
        viewState.status = button.dataset.status;
        renderEvents();
      });
    });
    document.querySelector("#system-toggle").addEventListener("click", () => {
      document.querySelector("#system-panel").classList.toggle("hidden");
    });

    syncFilterButtons();
    loadRadar().catch((error) => {
      document.querySelector("#events-list").innerHTML = `<div class="rounded-md border border-danger bg-dangersoft p-6 text-danger">${escapeHtml(error.message)}</div>`;
    });
  </script>
</RadarLayout>
