---
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Stromausfälle Schweiz: aktuell & geplant | outage.ch"
  description="Aktuelle und geplante Stromausfälle in der Schweiz mit Ort, Beginn, Ende, Dauer, Ursache, betroffener Region und nachvollziehbaren Quellen."
  canonical="https://outage.ch/"
  robots="index,follow,max-image-preview:large"
>
  <section class="feed-page">
    <header class="feed-intro">
      <p class="section-label text-accent">Schweiz · laufend aktualisiert</p>
      <h1>Aktuelle und geplante Stromausfälle</h1>
      <p>Finde aktuelle, geplante und behobene Stromausfälle nach Ort und Status.</p>
    </header>

    <div class="feed-tools" aria-label="Meldungen filtern und aktualisieren">
      <label class="search-field">
        <span class="sr-only">Ort suchen</span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input id="event-search" type="search" placeholder="Ort suchen" autocomplete="off" />
      </label>
      <button id="filter-toggle" type="button" aria-expanded="false" aria-controls="filter-secondary">Filter</button>
      <div id="filter-secondary" class="filter-secondary">
        <label class="filter-field"><span>Art</span><select id="nature-filter"><option value="">Alle</option><option value="planned">Geplant</option><option value="unplanned">Ungeplant</option></select></label>
        <label class="filter-field"><span>Status</span><select id="status-filter"><option value="">Alle</option><option value="upcoming">Bevorstehend</option><option value="active">Aktiv</option><option value="stale_unconfirmed">Nicht mehr bestätigt</option><option value="resolved">Behoben / abgeschlossen</option><option value="historical">Historisch</option></select></label>
        <button id="refresh-button" type="button">Daten aktualisieren</button>
      </div>
    </div>

    <div class="feed-shell" aria-live="polite" aria-busy="true">
      <div id="events-list" class="feed-list">
        <div class="feed-loading"></div>
        <div class="feed-loading"></div>
        <div class="feed-loading"></div>
      </div>
      <div class="feed-footer">
        <button id="load-more" type="button" hidden>Weitere laden</button>
        <p id="feed-note">Meldungen werden geladen …</p>
      </div>
    </div>

    <p class="public-note">outage.ch ist ein unabhängiger öffentlicher Radar und kein offizieller Notfallkanal.</p>
  </section>

  <script>
    type PublicItem = {
      id: number;
      location: string;
      canton: string | null;
      url: string;
      received_at: string;
      started_at: string | null;
      resolved_at: string | null;
      status: "upcoming" | "active" | "resolved" | "stale_unconfirmed" | "historical" | null;
      nature: "planned" | "unplanned" | "unknown";
      duration_minutes: number | null;
      active_since_at: string | null;
      active_since_is_minimum: boolean;
      last_confirmed_active_at: string | null;
      expected_restore_at: string | null;
      resolution_earliest_at: string | null;
      resolution_latest_at: string | null;
      time_confidence: "exact" | "reported" | "inferred" | "unknown";
      cause: string | null;
      affected_area: string | null;
      updated_at: string;
      summary: string;
      trust: "official" | "corroborated" | "reported";
      source: { publisher: string; url: string; domain: string };
    };

    const state: { items: PublicItem[]; nextCursor: string | null; query: string; nature: string; status: string; loading: boolean; generatedAt: string | null } = {
      items: [],
      nextCursor: null,
      query: "",
      nature: "",
      status: "",
      loading: false,
      generatedAt: null
    };
    const list = document.querySelector<HTMLElement>("#events-list")!;
    const shell = document.querySelector<HTMLElement>(".feed-shell")!;
    const note = document.querySelector<HTMLElement>("#feed-note")!;
    const loadMore = document.querySelector<HTMLButtonElement>("#load-more")!;
    const refresh = document.querySelector<HTMLButtonElement>("#refresh-button")!;

    const escapeHtml = (value: unknown) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

    const dateFormatter = new Intl.DateTimeFormat("de-CH", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Zurich"
    });
    const timeFormatter = new Intl.DateTimeFormat("de-CH", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Zurich"
    });
    const dayKey = (value: Date) => new Intl.DateTimeFormat("en-CA", {
      year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Europe/Zurich"
    }).format(value);

    function receivedLabel(value: string): { day: string; time: string; full: string } {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return { day: "Eingang", time: value, full: value };
      const now = new Date();
      const yesterday = new Date(now.getTime() - 86400000);
      const key = dayKey(date);
      const day = key === dayKey(now) ? "Heute" : key === dayKey(yesterday) ? "Gestern" : dateFormatter.format(date).split(",")[0];
      return { day, time: timeFormatter.format(date), full: dateFormatter.format(date) };
    }

    function visibleItems(): PublicItem[] {
      const query = state.query.trim().toLocaleLowerCase("de-CH");
      const rank = (item: PublicItem) => item.status === "active" ? 0 : item.status === "upcoming" ? 1 : item.status === "stale_unconfirmed" ? 2 : item.status === "resolved" ? 3 : 4;
      return state.items.filter((item) => {
        if (state.nature && item.nature !== state.nature) return false;
        if (state.status && item.status !== state.status) return false;
        return !query || `${item.location} ${item.canton ?? ""} ${item.affected_area ?? ""} ${item.cause ?? ""} ${item.summary} ${item.source.publisher}`.toLocaleLowerCase("de-CH").includes(query);
      }).sort((a, b) => {
        const statusOrder = rank(a) - rank(b);
        if (statusOrder !== 0) return statusOrder;
        const aTime = new Date(a.started_at ?? a.resolved_at ?? a.received_at).getTime();
        const bTime = new Date(b.started_at ?? b.resolved_at ?? b.received_at).getTime();
        return a.status === "upcoming" ? aTime - bTime : bTime - aTime;
      });
    }

    function displayLocation(value: string): string {
      const cleaned = value
        .replace(/^\s*(?:behobener?|beendeter?|geplanter?)\s+(?:stromausfall|stromunterbruch)\s+(?:in|im|bei|à)\s+/i, "")
        .replace(/^\s*(?:stromausfall|stromunterbruch|panne de courant)\s+(?:in|im|bei|à)\s+/i, "")
        .replace(/^\s*(?:in|im|bei|à)\s+/i, "")
        .trim();
      return cleaned || value;
    }

    function compactDuration(minutes: number): string {
      if (minutes < 60) return `${minutes} Min.`;
      const hours = Math.floor(minutes / 60);
      const rest = minutes % 60;
      return `${hours} Std.${rest ? ` ${rest} Min.` : ""}`;
    }

    function displaySummary(item: PublicItem, location: string): string {
      if (item.cause) return item.summary;
      if (item.status === "upcoming") return `Für ${location} ist ein geplanter Stromunterbruch gemeldet.`;
      if (item.status === "active") return `Für ${location} ist ein laufender Stromausfall gemeldet.`;
      if (item.status === "stale_unconfirmed") return `Der aktuelle Status der Meldung für ${location} ist nicht mehr bestätigt.`;
      if (item.status === "resolved" && item.time_confidence === "inferred" && !item.resolved_at) {
        return `Der Fall in ${location} wurde nach 24 Stunden ohne neue Bestätigung automatisch abgeschlossen.`;
      }
      if (item.status === "resolved") return `Der Stromausfall in ${location} wurde als behoben gemeldet.`;
      return item.summary;
    }

    function render(): void {
      const items = visibleItems();
      const firstSecondaryIndex = items.findIndex((item) => !["active", "upcoming"].includes(item.status ?? ""));
      list.innerHTML = items.map((item, index) => {
        const location = displayLocation(item.location);
        const primaryTime = item.started_at ?? item.resolved_at ?? item.received_at;
        const received = receivedLabel(primaryTime);
        const trust = item.trust === "official"
          ? "Offizielle Quelle"
          : item.trust === "corroborated"
            ? "Unabhängig bestätigt"
            : "Gemeldet";
        const nature = item.nature === "planned" ? "Geplant" : item.nature === "unplanned" ? "Ungeplant" : "Art unklar";
        const status = item.status === "upcoming"
          ? "Bevorstehend"
          : item.status === "resolved"
            ? item.time_confidence === "inferred" && !item.resolved_at ? "Abgeschlossen" : "Behoben"
            : item.status === "historical"
              ? "Historisch"
              : item.status === "stale_unconfirmed"
                ? "Status unbestätigt"
                : "Noch aktiv";
        const duration = item.duration_minutes === null ? null : compactDuration(item.duration_minutes);
        const activeStatusLine = item.status === "active"
          ? [
              "Noch aktiv",
              item.started_at ? `Beginn gemeldet ${dateFormatter.format(new Date(item.started_at))}` : null,
              item.last_confirmed_active_at ? `zuletzt bestätigt ${dateFormatter.format(new Date(item.last_confirmed_active_at))}` : null
            ].filter(Boolean).join(" · ")
          : item.status === "resolved" && item.time_confidence === "inferred" && !item.resolved_at
            ? [
                "Automatisch abgeschlossen",
                item.last_confirmed_active_at ? `letzte Bestätigung ${dateFormatter.format(new Date(item.last_confirmed_active_at))}` : null,
                "Dauer unbekannt"
              ].filter(Boolean).join(" · ")
          : null;
        const resolutionWindow = item.resolution_earliest_at && item.resolution_latest_at
          ? `Vermutlich behoben: ${dateFormatter.format(new Date(item.resolution_earliest_at))}–${dateFormatter.format(new Date(item.resolution_latest_at))}`
          : null;
        const sectionLabel = index === firstSecondaryIndex && firstSecondaryIndex >= 0 && !state.status
          ? `<div class="feed-section-label">Vergangene oder nicht mehr bestätigte Meldungen</div>`
          : "";
        return `${sectionLabel}<a class="feed-row" href="${escapeHtml(item.url)}" aria-label="Stromausfall-Meldung für ${escapeHtml(location)}, ${escapeHtml(received.full)}">
          <time datetime="${escapeHtml(primaryTime)}" title="${escapeHtml(received.full)}">
            <span>${escapeHtml(received.day)}</span>
            <strong>${escapeHtml(received.time)}</strong>
          </time>
          <span class="feed-copy">
            <strong class="feed-location">${escapeHtml(location)}</strong>
            <span class="feed-badges"><b class="badge nature-${item.nature}">${nature}</b><b class="badge status-${item.status}">${status}</b></span>
            ${activeStatusLine ? `<span class="feed-statusline">${escapeHtml(activeStatusLine)}</span>` : ""}
            <span class="feed-summary">${escapeHtml(displaySummary(item, location))}</span>
            <span class="feed-facts">${[
              item.started_at && item.status !== "active" ? `Start: ${dateFormatter.format(new Date(item.started_at))}` : null,
              item.resolved_at ? `Ende: ${dateFormatter.format(new Date(item.resolved_at))}` : null,
              duration ? `Dauer: ${duration}` : null,
              item.expected_restore_at && item.status === "active" ? `Behebung erwartet: ${dateFormatter.format(new Date(item.expected_restore_at))}` : null,
              resolutionWindow,
              item.status === "stale_unconfirmed" && item.last_confirmed_active_at
                ? `Zuletzt aktiv bestätigt: ${dateFormatter.format(new Date(item.last_confirmed_active_at))}`
                : null,
              item.affected_area ? `Region: ${item.affected_area}` : null,
              item.cause ? `Ursache: ${item.cause}` : null
            ].filter(Boolean).map((fact) => `<span>${escapeHtml(fact)}</span>`).join("")}</span>
            <span class="feed-source">${escapeHtml(item.source.publisher)} · ${trust}</span>
          </span>
          <svg class="row-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>`;
      }).join("");

      if (!items.length) {
        list.innerHTML = `<div class="feed-empty"><strong>${state.query ? "Kein passender Ort" : "Keine Meldungen"}</strong><span>${state.query ? "Versuche einen anderen Suchbegriff." : "Sobald eine Meldung aus einer nachvollziehbaren Quelle eingeht, erscheint sie hier."}</span></div>`;
      }
      const filtered = Boolean(state.query || state.nature || state.status);
      loadMore.hidden = !state.nextCursor || filtered;
      note.textContent = filtered
        ? `${items.length} Treffer in ${state.items.length} geladenen Meldungen`
        : `${state.items.length} Meldung${state.items.length === 1 ? "" : "en"} geladen${state.generatedAt ? ` · Stand ${timeFormatter.format(new Date(state.generatedAt))}` : ""}`;
      shell.setAttribute("aria-busy", "false");
    }

    async function load(reset = false): Promise<void> {
      if (state.loading) return;
      state.loading = true;
      refresh.disabled = true;
      loadMore.disabled = true;
      try {
        const cursor = reset ? null : state.nextCursor;
        const params = new URLSearchParams({ limit: "25" });
        if (cursor) params.set("before", cursor);
        const response = await fetch(`/api/public/events?${params}`, { cache: "no-store" });
        if (!response.ok) throw new Error("Die Meldungen konnten nicht geladen werden.");
        const data = await response.json();
        state.items = reset ? (data.items ?? []) : [...state.items, ...(data.items ?? [])];
        state.nextCursor = data.next_cursor ?? null;
        state.generatedAt = data.generated_at ?? state.generatedAt;
        render();
      } catch (error) {
        list.innerHTML = `<div class="feed-error">${escapeHtml(error instanceof Error ? error.message : String(error))}</div>`;
        list.insertAdjacentHTML("beforeend", `<button class="feed-retry" type="button">Wiederholen</button>`);
        list.querySelector<HTMLButtonElement>(".feed-retry")?.addEventListener("click", () => load(true));
        note.textContent = "Bitte später erneut versuchen.";
        shell.setAttribute("aria-busy", "false");
      } finally {
        state.loading = false;
        refresh.disabled = false;
        loadMore.disabled = false;
      }
    }

    document.querySelector<HTMLInputElement>("#event-search")!.addEventListener("input", (event) => {
      state.query = (event.currentTarget as HTMLInputElement).value;
      render();
    });
    document.querySelector<HTMLSelectElement>("#nature-filter")!.addEventListener("change", (event) => {
      state.nature = (event.currentTarget as HTMLSelectElement).value;
      render();
    });
    document.querySelector<HTMLSelectElement>("#status-filter")!.addEventListener("change", (event) => {
      state.status = (event.currentTarget as HTMLSelectElement).value;
      render();
    });
    const filterToggle = document.querySelector<HTMLButtonElement>("#filter-toggle")!;
    filterToggle.addEventListener("click", () => {
      const expanded = filterToggle.getAttribute("aria-expanded") === "true";
      filterToggle.setAttribute("aria-expanded", String(!expanded));
      document.querySelector<HTMLElement>("#filter-secondary")!.classList.toggle("is-open", !expanded);
    });
    refresh.addEventListener("click", () => load(true));
    loadMore.addEventListener("click", () => load(false));
    load(true);
  </script>

  <style is:global>
    .feed-page { margin: 0 auto; max-width: 960px; padding: clamp(2.75rem, 7vw, 6rem) 0 4rem; }
    .feed-intro { max-width: 760px; }
    .feed-intro h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 6vw, 4.25rem); font-weight: 800; letter-spacing: -0.045em; line-height: .98; margin: .75rem 0 0; }
    .feed-intro > p:last-child { color: var(--color-muted); font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.65; margin: 1.25rem 0 0; max-width: 680px; }
    .feed-tools { align-items: end; display: flex; gap: .65rem; justify-content: space-between; margin: 2.5rem 0 .75rem; }
    .filter-secondary { align-items: end; display: flex; gap: .65rem; }
    #filter-toggle { display: none; }
    .filter-field { display: grid; gap: .25rem; color: var(--color-faint); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
    .filter-field select { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-md); color: var(--color-ink); font: inherit; min-height: 2.75rem; padding: 0 .7rem; text-transform: none; }
    .feed-badges, .feed-facts { display: flex; flex-wrap: wrap; gap: .4rem .65rem; }
    .badge { border: 1px solid var(--color-rule); border-radius: 999px; font-family: var(--font-mono); font-size: .58rem; font-weight: 600; padding: .2rem .45rem; text-transform: uppercase; }
    .nature-planned, .status-upcoming { background: #fff3dc; color: #8b5515; }
    .nature-unplanned, .status-active { background: #ffe7df; color: #9b3d26; }
    .status-resolved { background: #e5f3e9; color: #28623b; }
    .status-historical, .status-stale_unconfirmed { background: #edf0f2; color: #4d5961; }
    .feed-statusline { color: var(--color-ink); font-family: var(--font-mono); font-size: .75rem; font-weight: 600; }
    .feed-facts { color: var(--color-muted); font-size: .72rem; }
    .search-field { align-items: center; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-md); color: var(--color-muted); display: flex; gap: .65rem; max-width: 320px; padding: 0 .85rem; width: 100%; }
    .search-field input { background: transparent; border: 0; color: var(--color-ink); font: inherit; height: 2.75rem; min-width: 0; outline: 0; width: 100%; }
    .feed-tools button, .feed-footer button { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-md); color: var(--color-ink); font-size: .875rem; font-weight: 600; min-height: 2.75rem; padding: .65rem 1rem; }
    .feed-tools button:hover, .feed-footer button:hover { border-color: var(--color-rule-strong); background: var(--color-surface-2); }
    .feed-shell { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: .75rem; box-shadow: 0 18px 50px color-mix(in oklch, var(--color-ink) 7%, transparent); overflow: hidden; }
    .feed-list { display: grid; }
    .feed-section-label { background: var(--color-surface-2); border-bottom: 1px solid var(--color-rule); color: var(--color-faint); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .07em; padding: .7rem 1.5rem; text-transform: uppercase; }
    .feed-row { align-items: center; border-bottom: 1px solid var(--color-rule); color: inherit; display: grid; gap: 1.25rem; grid-template-columns: 116px minmax(0, 1fr) 24px; min-height: 132px; padding: 1.35rem 1.5rem; text-decoration: none; }
    .feed-row:hover { background: color-mix(in oklch, var(--color-accent-soft) 34%, var(--color-surface)); }
    .feed-row time { display: grid; font-variant-numeric: tabular-nums; gap: .2rem; }
    .feed-row time span { color: var(--color-muted); font-family: var(--font-mono); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
    .feed-row time strong { font-family: var(--font-display); font-size: 1.35rem; }
    .feed-copy { display: grid; gap: .4rem; min-width: 0; }
    .feed-location { font-family: var(--font-display); font-size: clamp(1.2rem, 2.6vw, 1.6rem); letter-spacing: -.025em; line-height: 1.15; }
    .feed-summary { color: var(--color-muted); display: -webkit-box; font-size: .98rem; line-height: 1.55; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .feed-source { color: var(--color-faint); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .025em; }
    .row-arrow { height: 1.25rem; stroke: var(--color-faint); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; width: 1.25rem; }
    .feed-row:hover .row-arrow { stroke: var(--color-accent); transform: translateX(2px); }
    .feed-footer { align-items: center; display: flex; justify-content: space-between; min-height: 62px; padding: .65rem 1rem; }
    .feed-footer p { color: var(--color-faint); font-size: .78rem; margin-left: auto; }
    .feed-loading { animation: pulse 1.4s ease-in-out infinite; background: linear-gradient(90deg, var(--color-surface), var(--color-surface-2), var(--color-surface)); border-bottom: 1px solid var(--color-rule); height: 132px; }
    .feed-empty, .feed-error { display: grid; gap: .5rem; padding: 4rem 1.5rem; text-align: center; }
    .feed-empty span { color: var(--color-muted); }
    .feed-error { color: var(--color-danger); }
    .feed-retry { background: var(--color-ink); border: 0; border-radius: var(--radius-md); color: var(--color-surface); justify-self: center; margin: 0 0 2rem; min-height: 2.75rem; padding: .65rem 1rem; }
    .public-note { color: var(--color-faint); font-size: .78rem; line-height: 1.6; margin: 1rem .25rem 0; }
    .seo-feed-index { border-top: 1px solid var(--color-rule); margin-top: 2.5rem; padding-top: 1.5rem; }
    .seo-feed-index h2 { font-family: var(--font-display); font-size: 1.1rem; margin: 0 0 .85rem; }
    .seo-feed-index ul { display: grid; gap: .45rem; list-style: none; margin: 0; padding: 0; }
    .seo-feed-index a { color: var(--color-ink); text-decoration: underline; text-underline-offset: .15em; }
    .seo-feed-index p { color: var(--color-muted); font-size: .85rem; margin: 1rem 0 0; }
    @keyframes pulse { 50% { opacity: .58; } }
    @media (max-width: 640px) {
      .feed-page { padding-top: 1.6rem; }
      .feed-intro h1 { font-size: clamp(2rem, 11vw, 3rem); }
      .feed-intro > p:last-child { font-size: .95rem; line-height: 1.5; margin-top: .8rem; }
      .feed-tools { align-items: stretch; display: grid; grid-template-columns: minmax(0, 1fr) auto; margin-top: 1.25rem; }
      .search-field { max-width: none; }
      #filter-toggle { display: inline-flex; }
      .filter-secondary { display: none; grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .filter-secondary.is-open { display: grid; }
      .filter-secondary #refresh-button { grid-column: 1 / -1; width: 100%; }
      .feed-row { align-items: start; gap: .85rem; grid-template-columns: minmax(0, 1fr) 18px; min-height: 0; padding: 1.15rem; }
      .feed-row time { display: flex; gap: .45rem; grid-column: 1 / -1; }
      .feed-row time strong { font-family: var(--font-mono); font-size: .72rem; }
      .feed-summary { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
      .row-arrow { align-self: center; }
      .feed-footer { align-items: stretch; flex-direction: column; gap: .65rem; }
      .feed-footer p { margin: 0; text-align: center; }
    }
  </style>
</RadarLayout>
