---
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Stromausfall Schweiz aktuell | outage.ch"
  description="Stromausfall Radar für die Schweiz: aktuelle öffentliche Hinweise zu Stromausfällen, Netzunterbrüchen, Status, Ursachen und Quellenlage."
>
  <section class="py-3 sm:py-4">
    <div class="chrome rounded-md p-3 sm:p-4">
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-end">
        <div>
          <p class="section-label text-accent">outage.ch / Lagebild Schweiz</p>
          <h1 class="mt-2 max-w-3xl font-display text-2xl font-bold leading-tight sm:text-4xl">Schweizer Stromausfälle</h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Nur Ereignisse in der Schweiz mit belegtem Ort, Quelle und relevanter Textstelle. Heute steht oben.</p>
        </div>
        <div class="grid gap-2">
          <label class="section-label text-muted" for="event-search">Suchen</label>
          <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]">
            <div class="relative">
              <svg class="icon absolute left-3 top-1/2 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.3-4.3"/><circle cx="11" cy="11" r="7"/></svg>
              <input id="event-search" class="h-10 w-full rounded-md border border-rule bg-surface pl-10 pr-3 text-sm text-ink placeholder:text-faint" placeholder="Ort, Betreiber, Quelle" />
            </div>
            <button id="refresh-button" class="control-button bg-ink px-3 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-surface" type="button">
              <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12a9 9 0 0 1-15.3 6.4"/><path d="M3 12A9 9 0 0 1 18.3 5.6"/><path d="M21 4v6h-6"/><path d="M3 20v-6h6"/></svg>
              Neu laden
            </button>
          </div>
        </div>
      </div>

      <div id="public-metrics" class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-4">
        {["Gemeldet", "Zu prüfen", "Gut belegt", "Behoben"].map((label) => (
          <div class="loading-stripe h-12 rounded-md border border-rule bg-surface/70 p-3">
            <span class="section-label text-muted">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="grid gap-3 pb-28 lg:grid-cols-[minmax(0,1fr)_260px] lg:pb-8">
    <main class="panel rounded-md overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule px-3 py-3">
        <div>
          <p class="section-label text-muted">Timeline</p>
          <h2 class="mt-1 font-display text-lg font-bold">Ereignisse</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          <select id="status-filter" class="h-10 rounded-md border border-rule bg-surface px-3 text-sm text-ink">
            <option value="public">Aktuelle Hinweise</option>
            <option value="all">Alle inkl. Archiv</option>
            <option value="needs_review">Zu prüfen</option>
            <option value="corroborated">Gut belegt</option>
            <option value="resolved">Behoben</option>
          </select>
          <span id="event-count" class="grid h-10 place-items-center rounded-md border border-rule bg-surface2 px-3 font-mono text-[11px] text-muted">-</span>
        </div>
      </div>
      <div id="events-list" class="event-timeline grid gap-2 p-2 sm:p-3">
        <div class="loading-stripe h-28 rounded-md bg-surface2"></div>
        <div class="loading-stripe h-28 rounded-md bg-surface2"></div>
      </div>
    </main>

    <aside class="grid h-fit gap-3">
      <section class="panel rounded-md p-3">
        <p class="section-label text-muted">Lesart</p>
        <div class="mt-3 grid gap-2 text-sm leading-5 text-muted">
          <p><span class="font-semibold text-ink">CH-only:</span> keine Auslandsmeldungen.</p>
          <p><span class="font-semibold text-ink">Ereigniszeit:</span> passiert vor erkannt.</p>
          <p><span class="font-semibold text-ink">Geprüft:</span> nur offiziell oder Admin.</p>
        </div>
      </section>

      <section class="panel rounded-md p-3">
        <div class="flex items-center gap-2">
          <span class="status-dot border-warn bg-warnsoft text-warn">
            <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
          </span>
          <h2 class="font-display text-base font-bold">Hinweis</h2>
        </div>
        <p class="mt-2 text-sm leading-5 text-muted">Bei kritischen Situationen immer Gemeinde, Netzbetreiber oder Behörden prüfen.</p>
      </section>

      <section id="admin-panel" class="hidden panel rounded-md p-3">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-display text-lg font-bold">Admin Dashboard</h2>
          <button id="admin-logout" class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted" type="button">Logout</button>
        </div>
        <div id="admin-dashboard" class="mt-3 grid gap-2"></div>
      </section>

      <section id="admin-login-panel" class="panel rounded-md p-3">
        <h2 class="font-display text-base font-bold">Admin</h2>
        <p class="mt-1 text-sm text-muted">Interne Daten nach Token-Login.</p>
        <input id="admin-token-input" class="mt-3 w-full rounded-md border border-rule bg-surface px-3 py-2 font-mono text-xs text-ink" type="password" placeholder="Admin Token" />
        <p id="admin-token-state" class="mt-2 font-mono text-[10px] text-muted">Nicht angemeldet</p>
      </section>
    </aside>
  </section>

  <nav class="fixed inset-x-2 bottom-2 z-40 grid gap-2 rounded-md border border-rule bg-surface/95 p-2 shadow-panel backdrop-blur lg:hidden">
    <input id="mobile-search" class="rounded-md border border-rule bg-surface2 px-3 py-2 text-sm text-ink placeholder:text-faint" placeholder="Ort suchen" />
    <div class="grid grid-cols-[1fr_auto_auto] gap-2">
      <select id="mobile-status-filter" class="min-w-0 rounded-md border border-rule bg-surface2 px-2 py-2 text-sm text-ink">
        <option value="public">Aktuell</option>
        <option value="all">Alle</option>
        <option value="needs_review">Zu prüfen</option>
        <option value="corroborated">Belegt</option>
        <option value="resolved">Behoben</option>
      </select>
      <button id="mobile-refresh" class="control-button bg-surface2 px-3 py-2 font-mono text-[11px] uppercase text-ink" type="button">Neu</button>
      <button id="mobile-admin" class="control-button bg-ink px-3 py-2 font-mono text-[11px] uppercase text-surface" type="button">Admin</button>
    </div>
  </nav>

  <script>
    const fmt = new Intl.DateTimeFormat("de-CH", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "Europe/Zurich"
    });

    const viewState = {
      events: [],
      status: "public",
      query: "",
      data: null
    };

    const labels = {
      status: {
        active: "Aktiv",
        resolved: "Behoben",
        unknown: "Unklar",
        needs_review: "Zu prüfen",
        dismissed: "Verworfen"
      },
      nature: {
        planned: "Geplant",
        unplanned: "Ungeplant",
        unknown: "Unklar"
      },
      cause: {
        planned_maintenance: "Wartung",
        weather: "Wetter",
        tree_or_overhead_line: "Baum / Freileitung",
        construction_damage: "Bauarbeiten",
        cable_damage: "Kabelschaden",
        transformer_or_substation: "Trafostation",
        technical_fault: "Technische Störung",
        fire: "Brand",
        overload: "Überlast",
        third_party_damage: "Dritteinwirkung",
        water_or_flooding: "Wasser",
        unknown: "Unbekannt"
      }
    };

    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
    const label = (group, value) => labels[group]?.[value] ?? value ?? "-";
    const icons = {
      zap: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z"/></svg>`,
      clock: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
      check: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`,
      alert: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>`,
      file: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>`,
      arrow: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>`,
      shield: `<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4 7v6c0 5 3.4 7.7 8 8 4.6-.3 8-3 8-8V7l-8-4Z"/></svg>`
    };

    function statusIcon(status) {
      if (status === "resolved") return icons.check;
      if (status === "active") return icons.zap;
      if (status === "needs_review") return icons.alert;
      return icons.clock;
    }

    function parseFactSheet(event) {
      if (!event.fact_sheet_json) return null;
      try {
        return JSON.parse(event.fact_sheet_json);
      } catch {
        return null;
      }
    }

    function incidentStatus(event) {
      const fact = parseFactSheet(event);
      if (event.status === "dismissed") return "dismissed";
      if (event.status === "needs_review") return "needs_review";
      if (event.status === "resolved" || fact?.status === "resolved") return "resolved";
      if (fact?.status === "active") return "active";
      return "unknown";
    }

    function sourceLabel(event) {
      if (event.evidence_level === "official") return "Offizielle Quelle";
      if (Number(event.source_count ?? 0) >= 2) return "Mehrere Quellen";
      if (Number(event.source_count ?? 0) === 1) return "1 Quelle";
      return "Keine Quelle";
    }

    function sourceQualityLabel(event) {
      if (event.evidence_level === "official" || event.evidence_level === "corroborated") return "stark";
      if (event.evidence_level === "plausible" || Number(event.source_count ?? 0) >= 2) return "mittel";
      return "schwach";
    }

    function certaintyLabel(event) {
      if (event.evidence_level === "official" || event.evidence_level === "corroborated") return "Gut belegt";
      if (event.evidence_level === "plausible" || Number(event.source_count ?? 0) >= 2) return "Wahrscheinlich";
      return "Unklar";
    }

    function badgeClass(kind, value) {
      if (kind === "status" && value === "active") return "border-warn bg-warnsoft text-warn";
      if (kind === "status" && value === "resolved") return "border-ok bg-oksoft text-ok";
      if (kind === "status" && value === "dismissed") return "border-rule bg-surface2 text-muted";
      if (kind === "source" && value.includes("Offizielle")) return "border-ok bg-oksoft text-ok";
      if (kind === "quality" && value === "stark") return "border-ok bg-oksoft text-ok";
      if (kind === "quality" && value === "mittel") return "border-accent bg-accentsoft text-accent";
      if (kind === "certainty" && value === "Gut belegt") return "border-ok bg-oksoft text-ok";
      if (kind === "certainty" && value === "Wahrscheinlich") return "border-accent bg-accentsoft text-accent";
      return "border-rule bg-surface2 text-muted";
    }

    function formatDate(value) {
      if (!value) return "-";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : fmt.format(date);
    }

    function durationText(event) {
      if (!event.started_at_estimate || !event.resolved_at_estimate) return "Dauer nicht belegt";
      return `${formatDate(event.started_at_estimate)} bis ${formatDate(event.resolved_at_estimate)}`;
    }

    function eventDate(event) {
      return event.started_at_estimate || event.first_seen_at || event.last_seen_at;
    }

    function eventDateLabel(event) {
      return event.started_at_estimate ? "Ereigniszeit" : "Erkannt";
    }

    function dayKey(value) {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "";
      return new Intl.DateTimeFormat("en-CA", {
        timeZone: "Europe/Zurich",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      }).format(date);
    }

    function publicSortValue(event) {
      const value = eventDate(event);
      const time = new Date(value).getTime();
      if (!Number.isFinite(time)) return [3, 0];

      const today = dayKey(new Date().toISOString());
      const eventDay = dayKey(value);
      if (eventDay === today) return [0, time];
      if (eventDay > today) return [1, time];
      return [2, -time];
    }

    function summaryText(event) {
      const fact = parseFactSheet(event);
      return fact?.summary_de || event.research_summary_de || event.summary || event.primary_source_title || "Zu dieser Meldung liegt noch keine belastbare Kurzfassung vor.";
    }

    function visibleEvents() {
      const query = viewState.query.toLowerCase();
      return (viewState.events ?? [])
        .filter((event) => {
          if (viewState.status === "public" && event.status === "dismissed") return false;
          if (viewState.status !== "public" && viewState.status !== "all" && event.status !== viewState.status) return false;
          const haystack = `${event.location_text ?? ""} ${event.primary_source_title ?? ""} ${event.cause_category ?? ""} ${summaryText(event)}`.toLowerCase();
          return haystack.includes(query);
        })
        .sort((a, b) => {
          const left = publicSortValue(a);
          const right = publicSortValue(b);
          return left[0] - right[0] || left[1] - right[1];
        });
    }

    function renderMetrics(data) {
      const events = data.events ?? [];
      const publicEvents = events.filter((event) => event.status !== "dismissed");
      const metrics = [
        ["Sichtbar", publicEvents.length, "CH", icons.file],
        ["Prüfung", publicEvents.filter((event) => event.status === "needs_review").length, "offen", icons.alert],
        ["Belegt", publicEvents.filter((event) => certaintyLabel(event) === "Gut belegt").length, "stark", icons.shield],
        ["Behoben", publicEvents.filter((event) => incidentStatus(event) === "resolved").length, "erkannt", icons.check]
      ];
      document.querySelector("#public-metrics").innerHTML = metrics.map(([name, value, hint, icon]) => `
        <div class="rounded-md border border-rule bg-surface/85 px-3 py-2">
          <div class="flex items-center justify-between gap-2">
            <span class="section-label text-muted">${escapeHtml(name)}</span>
            <span class="text-accent">${icon}</span>
          </div>
          <div class="mt-1 flex items-end justify-between gap-2">
            <strong class="metric-value block font-display text-2xl font-bold leading-none">${escapeHtml(value)}</strong>
            <span class="pb-0.5 text-right text-xs text-muted">${escapeHtml(hint)}</span>
          </div>
        </div>
      `).join("");
    }

    function renderEvents() {
      const rows = visibleEvents();
      document.querySelector("#event-count").textContent = `${rows.length} Hinweise`;
      document.querySelector("#events-list").innerHTML = rows.map((event) => {
        const status = incidentStatus(event);
        const source = sourceLabel(event);
        const quality = sourceQualityLabel(event);
        const certainty = certaintyLabel(event);
        const summary = summaryText(event);
        return `
          <article class="event-card relative z-10 rounded-md p-3 transition">
            <div class="grid gap-3 sm:grid-cols-[36px_minmax(0,1fr)_auto] sm:items-start">
              <div class="status-dot ${badgeClass("status", status)}">${statusIcon(status)}</div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                  <span class="section-label text-muted">${escapeHtml(eventDateLabel(event))}</span>
                  <span class="tabular font-semibold text-ink">${escapeHtml(formatDate(eventDate(event)))}</span>
                  <span class="rounded-md border px-2 py-0.5 ${badgeClass("status", status)}">${escapeHtml(label("status", status))}</span>
                  <span class="rounded-md border px-2 py-0.5 ${badgeClass("quality", quality)}">${escapeHtml(source)}</span>
                  <span class="rounded-md border px-2 py-0.5 ${badgeClass("certainty", certainty)}">${escapeHtml(certainty)}</span>
                </div>
                <div class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="clamp-title font-display text-xl font-bold leading-tight">${escapeHtml(event.location_text || "Ort unklar")}</h3>
                  <span class="text-sm text-muted">${escapeHtml(label("nature", event.outage_nature || "unknown"))}</span>
                </div>
                <p class="mt-1 line-clamp-1 text-sm leading-5 text-muted">${escapeHtml(summary)}</p>
              </div>
              <a href="/events/${event.id}" class="control-button bg-ink px-2.5 py-2 text-center font-mono text-[11px] uppercase tracking-[0.08em] text-surface" aria-label="Details öffnen">
                ${icons.arrow}
              </a>
            </div>
          </article>
        `;
      }).join("") || `<div class="rounded-md border border-rule bg-surface p-6 text-sm text-muted">Keine passenden Hinweise gefunden.</div>`;
    }

    function renderAdminDashboard(data) {
      const runs = data.runs ?? [];
      const lastRun = data.lastRun ?? {};
      const events = data.events ?? [];
      document.querySelector("#admin-dashboard").innerHTML = `
        <div class="rounded-md border border-rule bg-surface2 p-3 text-sm">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Letzter Run</p>
          <strong>${escapeHtml(lastRun.status ?? "-")}</strong>
          <p class="mt-1 text-muted">${escapeHtml(lastRun.items_seen ?? 0)} Items gesehen · ${escapeHtml(lastRun.items_new ?? 0)} neu · ${escapeHtml(lastRun.emails_sent ?? 0)} Mails</p>
        </div>
        <div class="rounded-md border border-rule bg-surface2 p-3 text-sm">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Interne Counts</p>
          <p class="mt-1 text-muted">${events.length} Events geladen · ${runs.length} Runs im Debugfenster</p>
        </div>
        <a class="rounded-md border border-rule bg-surface px-3 py-2 text-center font-mono text-[11px] uppercase tracking-[0.08em] text-ink" href="/status">Geschützten JSON-Status öffnen</a>
      `;
    }

    function syncAdmin() {
      const token = localStorage.getItem("outage_admin_token") ?? "";
      document.querySelector("#admin-token-input").value = token;
      document.querySelector("#admin-token-state").textContent = token ? "Angemeldet" : "Nicht angemeldet";
      document.querySelector("#admin-panel").classList.toggle("hidden", !token);
      if (viewState.data && token) renderAdminDashboard(viewState.data);
    }

    async function loadRadar() {
      document.querySelector("#events-list").classList.add("opacity-60");
      const response = await fetch("/api/public/status", { cache: "no-store" });
      if (!response.ok) throw new Error("Status konnte nicht geladen werden");
      const data = await response.json();
      viewState.data = data;
      viewState.events = data.events ?? [];
      renderMetrics(data);
      renderEvents();
      syncAdmin();
      document.querySelector("#events-list").classList.remove("opacity-60");
    }

    function setQuery(value) {
      viewState.query = value ?? "";
      document.querySelector("#event-search").value = viewState.query;
      document.querySelector("#mobile-search").value = viewState.query;
      renderEvents();
    }

    function setStatus(value) {
      viewState.status = value;
      document.querySelector("#status-filter").value = value;
      document.querySelector("#mobile-status-filter").value = value;
      renderEvents();
    }

    document.querySelector("#event-search").addEventListener("input", (event) => setQuery(event.target.value));
    document.querySelector("#mobile-search").addEventListener("input", (event) => setQuery(event.target.value));
    document.querySelector("#status-filter").addEventListener("change", (event) => setStatus(event.target.value));
    document.querySelector("#mobile-status-filter").addEventListener("change", (event) => setStatus(event.target.value));
    document.querySelector("#refresh-button").addEventListener("click", () => loadRadar());
    document.querySelector("#mobile-refresh").addEventListener("click", () => loadRadar());
    document.querySelector("#mobile-admin").addEventListener("click", () => {
      document.querySelector("#admin-login-panel").scrollIntoView({ behavior: "smooth", block: "center" });
      document.querySelector("#admin-token-input").focus();
    });
    document.querySelector("#admin-token-input").addEventListener("input", (event) => {
      const token = event.target.value.trim();
      if (token) localStorage.setItem("outage_admin_token", token);
      else localStorage.removeItem("outage_admin_token");
      syncAdmin();
    });
    document.querySelector("#admin-logout").addEventListener("click", () => {
      localStorage.removeItem("outage_admin_token");
      syncAdmin();
    });
    window.addEventListener("outage:admin-login", () => {
      document.querySelector("#admin-login-panel").scrollIntoView({ behavior: "smooth", block: "center" });
      document.querySelector("#admin-token-input").focus();
    });

    loadRadar().catch((error) => {
      document.querySelector("#events-list").innerHTML = `<div class="rounded-md border border-danger bg-dangersoft p-6 text-danger">${escapeHtml(error.message)}</div>`;
    });
  </script>
</RadarLayout>
