---
/**
 * Radar home: desktop = split map|list (viewport-locked), mobile = map HUD.
 */
import maplibreCss from "maplibre-gl/dist/maplibre-gl.css?url";
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Stromausfälle Schweiz: aktuell & geplant | outage.ch"
  description="Aktuelle und geplante Stromausfälle in der Schweiz mit Ort, Beginn, Ende, Dauer, Ursache, betroffener Region und nachvollziehbaren Quellen."
  canonical="https://outage.ch/"
  robots="index,follow,max-image-preview:large"
  shell="radar"
  activeNav="radar"
>
  <link slot="head" rel="stylesheet" href={maplibreCss} />
  <link slot="head" rel="preconnect" href="https://vectortiles.geo.admin.ch" crossorigin />
  <link slot="head" rel="dns-prefetch" href="https://vectortiles.geo.admin.ch" />

  <section class="radar" data-radar>
    <div class="radar__map-wrap">
      <div id="radar-map" class="radar__map" role="img" aria-label="Karte der Stromausfall-Meldungen"></div>
      <div class="radar__legend">
        <span data-shape="unplanned"><i class="radar-mark radar-mark--triangle" aria-hidden="true"></i>Ungeplant</span>
        <span data-shape="planned"><i class="radar-mark radar-mark--square" aria-hidden="true"></i>Geplant</span>
        <span data-tone="active"><i aria-hidden="true"></i>Aktiv</span>
        <span data-tone="upcoming"><i aria-hidden="true"></i>Bevorstehend</span>
        <span data-tone="resolved"><i aria-hidden="true"></i>Behoben</span>
        <span data-tone="other"><i aria-hidden="true"></i>Archiv</span>
      </div>
      <p class="radar__disclaimer">Unabhängiger öffentlicher Radar — kein offizieller Notfallkanal.</p>
    </div>

    <header class="radar__hud">
      <div class="radar__hud-bar">
        <a class="radar__brand" href="/" aria-label="outage.ch Radar">outage.ch</a>
        <label class="radar__search">
          <svg class="radar__search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
          <span class="sr-only">Ort suchen</span>
          <input id="radar-search" type="search" placeholder="Ort oder Region" autocomplete="off" enterkeyhint="search" />
        </label>
      </div>
      <div class="radar__filters">
        <div id="radar-chips" class="radar__chips" role="toolbar" aria-label="Status filtern"></div>
        <div id="radar-nature" class="radar__chips radar__chips--nature" role="toolbar" aria-label="Art filtern"></div>
      </div>
    </header>

    <aside class="radar__panel" id="radar-panel" inert aria-hidden="true">
      <div class="radar__handle" aria-hidden="true"></div>
      <div class="radar__panel-head">
        <div>
          <h1>Meldungen</h1>
          <p id="radar-count" class="radar__count">…</p>
        </div>
        <div class="radar__panel-actions">
          <button type="button" id="radar-refresh" class="radar__icon-btn">Aktualisieren</button>
          <button type="button" id="radar-panel-close" class="radar__icon-btn radar__panel-close" aria-label="Liste schliessen">Schliessen</button>
        </div>
      </div>
      <div id="radar-list" class="radar__list" aria-live="polite" aria-busy="true">
        <div class="radar-skel"></div>
        <div class="radar-skel"></div>
        <div class="radar-skel"></div>
      </div>
      <div class="radar__panel-foot">
        <button type="button" id="radar-more" hidden>Weitere laden</button>
        <p id="radar-note" class="radar__note">Meldungen werden geladen …</p>
      </div>
    </aside>

    <div id="radar-sheet" class="radar__sheet" hidden>
      <button type="button" id="radar-sheet-close" class="radar__sheet-x" aria-label="Vorschau schliessen">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <div id="radar-sheet-body"></div>
      <a id="radar-sheet-link" class="radar__cta" href="#">Meldung öffnen</a>
    </div>

    <button type="button" id="radar-list-fab" class="radar__fab" aria-controls="radar-panel">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="4" cy="6" r="1.2"/><circle cx="4" cy="12" r="1.2"/><circle cx="4" cy="18" r="1.2"/></svg>
      Meldungen
      <b id="radar-fab-count">–</b>
    </button>
  </section>

  <script>
    type PublicItem = {
      id: number;
      location: string;
      canton: string | null;
      url: string;
      status: "upcoming" | "active" | "resolved" | "stale_unconfirmed" | "historical" | null;
      nature: "planned" | "unplanned" | "unknown";
      summary: string;
      cause: string | null;
      source: { publisher: string; domain: string };
      latitude?: number | null;
      longitude?: number | null;
    };

    type Category = "active" | "upcoming" | "resolved" | "other";

    const STATUS_FILTERS = [
      { key: "", label: "Alle", tone: "all" },
      { key: "active", label: "Aktiv", tone: "active" },
      { key: "upcoming", label: "Bevorstehend", tone: "upcoming" },
      { key: "resolved", label: "Behoben", tone: "resolved" },
      { key: "historical", label: "Archiv", tone: "historical" }
    ] as const;

    const NATURE_FILTERS = [
      { key: "", label: "Alle Arten", mark: "mixed" },
      { key: "unplanned", label: "Ungeplant", mark: "triangle" },
      { key: "planned", label: "Geplant", mark: "square" }
    ] as const;

    const COLOR: Record<Category, string> = {
      active: "#B5474C",
      upcoming: "#B56A1A",
      resolved: "#3F7A5C",
      other: "#6B7280"
    };

    const CANTON_CENTROIDS: Record<string, [number, number]> = {
      ZH: [47.3769, 8.5417], BE: [46.948, 7.4474], LU: [47.0502, 8.3093],
      UR: [46.8817, 8.6444], SZ: [47.0207, 8.652], OW: [46.898, 8.244],
      NW: [46.9581, 8.366], GL: [47.0404, 9.068], ZG: [47.1662, 8.5155],
      FR: [46.8065, 7.162], SO: [47.2088, 7.5323], BS: [47.5596, 7.5886],
      BL: [47.4418, 7.764], SH: [47.696, 8.634], AR: [47.3667, 9.3],
      AI: [47.331, 9.409], SG: [47.4245, 9.3767], GR: [46.8499, 9.5329],
      AG: [47.3925, 8.0444], TG: [47.556, 8.896], TI: [46.2044, 9.024],
      VD: [46.5197, 6.6323], VS: [46.2276, 7.3606], NE: [46.99, 6.929],
      GE: [46.2044, 6.1432], JU: [47.365, 7.345]
    };

    const state = {
      items: [] as PublicItem[],
      nextCursor: null as string | null,
      query: "",
      status: "",
      nature: "" as "" | "planned" | "unplanned",
      selectedId: null as number | null,
      loading: false,
      error: null as string | null,
      generatedAt: null as string | null,
      drawerOpen: false
    };

    let map: any = null;
    let maplibregl: any = null;
    let mapReady = false;
    let mapInit: Promise<any> | null = null;
    let lastFitKey = "";
    let searchTimer = 0;
    let resizeTimer = 0;

    const listEl = document.querySelector<HTMLElement>("#radar-list")!;
    const chipsEl = document.querySelector<HTMLElement>("#radar-chips")!;
    const natureEl = document.querySelector<HTMLElement>("#radar-nature")!;
    const countEl = document.querySelector<HTMLElement>("#radar-count")!;
    const noteEl = document.querySelector<HTMLElement>("#radar-note")!;
    const moreBtn = document.querySelector<HTMLButtonElement>("#radar-more")!;
    const searchEl = document.querySelector<HTMLInputElement>("#radar-search")!;
    const panelEl = document.querySelector<HTMLElement>("#radar-panel")!;
    const sheetEl = document.querySelector<HTMLElement>("#radar-sheet")!;
    const sheetBody = document.querySelector<HTMLElement>("#radar-sheet-body")!;
    const sheetLink = document.querySelector<HTMLAnchorElement>("#radar-sheet-link")!;
    const fabEl = document.querySelector<HTMLButtonElement>("#radar-list-fab")!;
    const fabCountEl = document.querySelector<HTMLElement>("#radar-fab-count");
    const mapWrap = document.querySelector<HTMLElement>(".radar__map-wrap");

    const escapeHtml = (value: unknown) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const categorize = (status: PublicItem["status"]): Category => {
      if (status === "active") return "active";
      if (status === "upcoming") return "upcoming";
      if (status === "resolved") return "resolved";
      return "other";
    };

    const statusLabel = (status: PublicItem["status"]) => {
      if (status === "active") return "Aktiv";
      if (status === "upcoming") return "Bevorstehend";
      if (status === "resolved") return "Behoben";
      if (status === "stale_unconfirmed") return "Unbestätigt";
      if (status === "historical") return "Archiv";
      return "Unklar";
    };

    const natureLabel = (nature: PublicItem["nature"]) => {
      if (nature === "planned") return "geplant";
      if (nature === "unplanned") return "ungeplant";
      return "unklar";
    };

    const natureShape = (nature: PublicItem["nature"]) =>
      nature === "planned" ? "square" : "triangle";

    const markHtml = (shape: "triangle" | "square" | "mixed") =>
      shape === "mixed"
        ? `<i class="radar-mark radar-mark--mixed" aria-hidden="true"></i>`
        : `<i class="radar-mark radar-mark--${shape}" aria-hidden="true"></i>`;

    const isMobile = () => window.matchMedia("(max-width: 899px)").matches;

    const shortLocation = (value: string) => value.split(",")[0]?.trim() || value;

    const syncPanelA11y = () => {
      if (isMobile()) {
        const open = state.drawerOpen;
        panelEl.toggleAttribute("inert", !open);
        panelEl.setAttribute("aria-hidden", open ? "false" : "true");
        fabEl.setAttribute("aria-expanded", open ? "true" : "false");
      } else {
        panelEl.removeAttribute("inert");
        panelEl.removeAttribute("aria-hidden");
        fabEl.setAttribute("aria-expanded", "true");
      }
    };

    const pinFor = (item: PublicItem): [number, number] | null => {
      if (typeof item.latitude === "number" && typeof item.longitude === "number") {
        return [item.longitude, item.latitude];
      }
      if (item.canton && CANTON_CENTROIDS[item.canton]) {
        const [lat, lon] = CANTON_CENTROIDS[item.canton];
        const j = ((item.id % 17) - 8) * 0.012;
        return [lon + ((item.id % 13) - 6) * 0.012, lat + j];
      }
      return null;
    };

    const filtered = () => {
      const q = state.query.trim().toLowerCase();
      return state.items.filter((item) => {
        if (state.status === "historical") {
          if (item.status !== "historical" && item.status !== "stale_unconfirmed") return false;
        } else if (state.status && item.status !== state.status) {
          return false;
        }
        if (state.nature === "planned" && item.nature !== "planned") return false;
        if (state.nature === "unplanned" && item.nature === "planned") return false;
        if (!q) return true;
        const hay = `${item.location} ${item.canton ?? ""} ${item.summary} ${item.cause ?? ""}`.toLowerCase();
        return hay.includes(q);
      });
    };

    const featuresFor = (items: PublicItem[]) =>
      items
        .map((item) => {
          const coords = pinFor(item);
          if (!coords) return null;
          const selected = state.selectedId === item.id;
          return {
            type: "Feature" as const,
            properties: {
              id: item.id,
              color: COLOR[categorize(item.status)],
              icon: markerId(natureShape(item.nature), COLOR[categorize(item.status)], selected),
              selected: selected ? 1 : 0
            },
            geometry: { type: "Point" as const, coordinates: coords }
          };
        })
        .filter(Boolean);

    function markerId(shape: "triangle" | "square", color: string, selected: boolean) {
      return `pin-${shape}-${color.replace("#", "")}-${selected ? "s" : "n"}`;
    }

    function drawMarker(shape: "triangle" | "square", color: string, selected: boolean) {
      const dpr = 2;
      const size = (selected ? 30 : 22) * dpr;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d")!;
      const pad = (selected ? 3.5 : 3) * dpr;
      ctx.lineJoin = "round";
      ctx.lineCap = "round";
      ctx.lineWidth = 2.2 * dpr;
      ctx.fillStyle = color;
      ctx.strokeStyle = "#fff";
      ctx.beginPath();
      if (shape === "triangle") {
        ctx.moveTo(size / 2, pad);
        ctx.lineTo(size - pad, size - pad * 0.85);
        ctx.lineTo(pad, size - pad * 0.85);
        ctx.closePath();
      } else {
        const r = 2.5 * dpr;
        const x = pad;
        const y = pad;
        const w = size - pad * 2;
        const h = size - pad * 2;
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }
      ctx.fill();
      ctx.stroke();
      return {
        width: size,
        height: size,
        data: new Uint8Array(ctx.getImageData(0, 0, size, size).data)
      };
    }

    function ensureMarkerImages(items: PublicItem[]) {
      if (!map) return;
      for (const item of items) {
        if (!pinFor(item)) continue;
        const shape = natureShape(item.nature);
        const color = COLOR[categorize(item.status)];
        for (const selected of [false, true]) {
          const id = markerId(shape, color, selected);
          if (!map.hasImage(id)) {
            map.addImage(id, drawMarker(shape, color, selected), { pixelRatio: 2 });
          }
        }
      }
    }

    async function ensureMap() {
      if (map) return map;
      if (mapInit) return mapInit;
      mapInit = (async () => {
        // Wait for layout so MapLibre gets a non-zero container.
        await new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));
        const container = document.querySelector("#radar-map");
        if (!container) return null;
        const mod = await import("maplibre-gl");
        maplibregl = mod.default;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        map = new maplibregl.Map({
          container,
          style: "https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json",
          center: [8.2275, 46.8182],
          zoom: 7.2,
          attributionControl: false,
          antialias: false,
          fadeDuration: reduce ? 0 : 120,
          maxPitch: 0,
          pitchWithRotate: false,
          dragRotate: false,
          touchPitch: false,
          pixelRatio: Math.min(window.devicePixelRatio || 1, 1.5)
        });
        map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-right");
        await new Promise<void>((resolve, reject) => {
          const fail = window.setTimeout(() => reject(new Error("map timeout")), 12_000);
          map.once("load", () => {
            window.clearTimeout(fail);
            resolve();
          });
          map.once("error", () => {
            /* style tile errors are common; ignore unless never loaded */
          });
        }).catch(() => undefined);

        if (!map.getSource("outages")) {
          map.addSource("outages", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
          map.addLayer({
            id: "outages-hit",
            type: "circle",
            source: "outages",
            paint: {
              "circle-radius": 16,
              "circle-color": "#000",
              "circle-opacity": 0
            }
          });
          map.addLayer({
            id: "outages-point",
            type: "symbol",
            source: "outages",
            layout: {
              "icon-image": ["get", "icon"],
              "icon-size": 1,
              "icon-allow-overlap": true,
              "icon-ignore-placement": true
            }
          });
          const pick = (e: any) => {
            const id = Number(e.features?.[0]?.properties?.id);
            if (!Number.isFinite(id)) return;
            selectItem(id, { openSheet: isMobile() });
          };
          map.on("click", "outages-hit", pick);
          map.on("click", "outages-point", pick);
          map.on("mouseenter", "outages-hit", () => {
            map.getCanvas().style.cursor = "pointer";
          });
          map.on("mouseleave", "outages-hit", () => {
            map.getCanvas().style.cursor = "";
          });
        }
        map.resize();
        mapReady = true;
        mapWrap?.classList.add("is-ready");
        return map;
      })();
      return mapInit;
    }

    function syncPins(fit = false) {
      if (!map || !mapReady) return;
      const items = filtered();
      ensureMarkerImages(items);
      const features = featuresFor(items);
      map.getSource("outages")?.setData({ type: "FeatureCollection", features });

      if (state.selectedId != null) {
        const sel = state.items.find((i) => i.id === state.selectedId);
        const coords = sel ? pinFor(sel) : null;
        if (coords) {
          map.easeTo({
            center: coords,
            zoom: Math.max(map.getZoom(), 10),
            duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 280
          });
          return;
        }
      }

      if (!fit || features.length === 0) return;
      const fitKey = `${state.status}|${state.nature}|${state.query}|${features.length}`;
      if (fitKey === lastFitKey) return;
      lastFitKey = fitKey;
      const bounds = new maplibregl.LngLatBounds();
      for (const f of features as any[]) bounds.extend(f.geometry.coordinates);
      map.fitBounds(bounds, {
        padding: isMobile() ? 48 : 40,
        maxZoom: 10.5,
        duration: 0
      });
    }

    function rowHtml(item: PublicItem, selected: boolean) {
      const badge = item.status ?? "historical";
      const tone = categorize(item.status);
      const shape = natureShape(item.nature);
      return `
        <a class="radar-row radar-row--${tone} ${selected ? "is-selected" : ""}" href="${escapeHtml(item.url)}" data-id="${item.id}">
          <div class="radar-row__top">
            <h2>${markHtml(shape)} ${escapeHtml(shortLocation(item.location))}${item.canton ? ` <span class="radar-row__canton">${escapeHtml(item.canton)}</span>` : ""}</h2>
            <span class="radar-badge radar-badge--${escapeHtml(badge)}">${escapeHtml(statusLabel(item.status))}</span>
          </div>
          <p>${escapeHtml(item.summary)}</p>
          <div class="radar-row__foot">
            <div class="radar-row__meta">${escapeHtml(natureLabel(item.nature))} · ${escapeHtml(item.source.publisher)}</div>
            <span class="radar-row__cta" data-nav>Meldung öffnen</span>
          </div>
        </a>`;
    }

    function renderChips() {
      const statusCounts: Record<string, number> = { "": 0, active: 0, upcoming: 0, resolved: 0, historical: 0 };
      const natureCounts: Record<string, number> = { "": 0, planned: 0, unplanned: 0 };
      for (const item of state.items) {
        statusCounts[""] += 1;
        if (item.status === "active") statusCounts.active += 1;
        else if (item.status === "upcoming") statusCounts.upcoming += 1;
        else if (item.status === "resolved") statusCounts.resolved += 1;
        else statusCounts.historical += 1;
        natureCounts[""] += 1;
        if (item.nature === "planned") natureCounts.planned += 1;
        else natureCounts.unplanned += 1;
      }
      chipsEl.innerHTML = STATUS_FILTERS.map(
        (f) =>
          `<button type="button" class="radar-chip" data-status="${f.key}" data-tone="${f.tone}" aria-pressed="${state.status === f.key}"><i class="radar-chip__dot" aria-hidden="true"></i>${f.label}<span class="n">${statusCounts[f.key] ?? 0}</span></button>`
      ).join("");
      natureEl.innerHTML = NATURE_FILTERS.map(
        (f) =>
          `<button type="button" class="radar-chip" data-nature="${f.key}" aria-pressed="${state.nature === f.key}">${markHtml(f.mark)}${f.label}<span class="n">${natureCounts[f.key] ?? 0}</span></button>`
      ).join("");
    }

    function renderList() {
      const items = filtered();
      const mapped = items.filter((i) => pinFor(i)).length;
      countEl.textContent = `${items.length} sichtbar · ${mapped} auf Karte`;
      listEl.setAttribute("aria-busy", state.loading ? "true" : "false");

      if (state.loading && !state.items.length) {
        listEl.innerHTML = `<div class="radar-skel"></div><div class="radar-skel"></div><div class="radar-skel"></div>`;
        return;
      }
      if (state.error && !state.items.length) {
        listEl.innerHTML = `<div class="radar__empty" role="alert"><p>Meldungen konnten nicht geladen werden.</p><p>${escapeHtml(state.error)}</p><button type="button" class="radar__ghost" data-retry>Erneut versuchen</button></div>`;
        return;
      }
      if (!items.length) {
        const q = state.query.trim();
        listEl.innerHTML = `<div class="radar__empty"><p>${q ? `Keine Meldungen für «${escapeHtml(q)}».` : "Keine Meldungen für diesen Filter."}</p><button type="button" class="radar__ghost" data-reset>Alle Meldungen zeigen</button></div>`;
        return;
      }
      listEl.innerHTML = items.map((i) => rowHtml(i, state.selectedId === i.id)).join("");
    }

    function openSheet(id: number) {
      const item = state.items.find((i) => i.id === id);
      if (!item) return;
      sheetBody.innerHTML = `
        <div class="radar-row__top">
          <h2>${markHtml(natureShape(item.nature))} ${escapeHtml(shortLocation(item.location))}${item.canton ? ` <span class="radar-row__canton">${escapeHtml(item.canton)}</span>` : ""}</h2>
          <span class="radar-badge radar-badge--${escapeHtml(item.status ?? "historical")}">${escapeHtml(statusLabel(item.status))}</span>
        </div>
        <p>${escapeHtml(item.summary)}</p>
        <div class="radar-row__meta">${escapeHtml(natureLabel(item.nature))} · ${escapeHtml(item.source.publisher)}</div>`;
      sheetLink.href = item.url;
      sheetEl.hidden = false;
    }

    function closeSheet() {
      sheetEl.hidden = true;
    }

    function setDrawer(open: boolean) {
      state.drawerOpen = open;
      panelEl.classList.toggle("is-open", open);
      fabEl.hidden = open || !isMobile();
      document.body.classList.toggle("radar-drawer-open", open);
      syncPanelA11y();
      if (open) {
        window.setTimeout(() => map?.resize(), 280);
      }
    }

    function selectItem(id: number, opts: { openSheet?: boolean } = {}) {
      state.selectedId = id;
      renderList();
      syncPins(false);
      if (opts.openSheet && isMobile()) {
        setDrawer(false);
        openSheet(id);
      }
      const row = listEl.querySelector<HTMLElement>(`[data-id="${id}"]`);
      row?.scrollIntoView({ block: "nearest" });
    }

    function renderUi(opts: { fitMap?: boolean } = {}) {
      renderChips();
      renderList();
      moreBtn.hidden = !state.nextCursor || (!filtered().length && !state.loading);
      noteEl.textContent = state.generatedAt
        ? `Stand ${new Date(state.generatedAt).toLocaleString("de-CH", { dateStyle: "short", timeStyle: "short" })}`
        : state.loading
          ? "Meldungen werden geladen …"
          : "";
      fabEl.hidden = !isMobile() || state.drawerOpen;
      if (fabCountEl) fabCountEl.textContent = String(filtered().length);
      syncPanelA11y();
      if (state.items.length || opts.fitMap) {
        void ensureMap().then(() => syncPins(Boolean(opts.fitMap)));
      }
    }

    async function loadFeed(reset = true) {
      if (state.loading) return;
      state.loading = true;
      state.error = null;
      if (reset) {
        state.items = [];
        state.nextCursor = null;
        lastFitKey = "";
      }
      renderUi();
      // Start map download in parallel with API.
      void ensureMap();
      try {
        const params = new URLSearchParams({ limit: "25" });
        if (!reset && state.nextCursor) params.set("before", state.nextCursor);
        const res = await fetch(`/api/public/events?${params}`);
        if (!res.ok) throw new Error(`API ${res.status}`);
        const data = (await res.json()) as { items: PublicItem[]; next_cursor: string | null; generated_at?: string };
        state.items = reset ? data.items : [...state.items, ...data.items];
        state.nextCursor = data.next_cursor;
        state.generatedAt = data.generated_at ?? new Date().toISOString();
      } catch (err) {
        state.error = err instanceof Error ? err.message : "Laden fehlgeschlagen";
      } finally {
        state.loading = false;
        renderUi({ fitMap: true });
      }
    }

    chipsEl.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-status]");
      if (!btn) return;
      state.status = btn.dataset.status ?? "";
      state.selectedId = null;
      closeSheet();
      lastFitKey = "";
      renderUi({ fitMap: true });
    });

    natureEl.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-nature]");
      if (!btn) return;
      const next = (btn.dataset.nature ?? "") as typeof state.nature;
      state.nature = next;
      state.selectedId = null;
      closeSheet();
      lastFitKey = "";
      renderUi({ fitMap: true });
    });

    listEl.addEventListener("click", (ev) => {
      const t = ev.target as HTMLElement;
      if (t.closest("[data-retry]")) {
        void loadFeed(true);
        return;
      }
      if (t.closest("[data-reset]")) {
        state.query = "";
        state.status = "";
        state.nature = "";
        searchEl.value = "";
        lastFitKey = "";
        renderUi({ fitMap: true });
        return;
      }
      const row = t.closest<HTMLAnchorElement>("a.radar-row[data-id]");
      if (!row) return;
      const mouse = ev as MouseEvent;
      if (t.closest("[data-nav]") || mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.button === 1) return;
      const id = Number(row.dataset.id);
      if (!Number.isFinite(id)) return;
      if (!isMobile() && state.selectedId === id) return;
      ev.preventDefault();
      selectItem(id, { openSheet: isMobile() });
    });

    searchEl.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.query = searchEl.value;
        state.selectedId = null;
        lastFitKey = "";
        renderUi({ fitMap: true });
      }, 160);
    });

    document.querySelector("#radar-refresh")?.addEventListener("click", () => void loadFeed(true));
    moreBtn.addEventListener("click", () => void loadFeed(false));
    document.querySelector("#radar-sheet-close")?.addEventListener("click", () => {
      closeSheet();
      state.selectedId = null;
      renderUi();
    });
    document.querySelector("#radar-panel-close")?.addEventListener("click", () => setDrawer(false));
    fabEl.addEventListener("click", () => setDrawer(true));

    window.addEventListener("resize", () => {
      if (!isMobile()) {
        setDrawer(false);
        closeSheet();
      }
      fabEl.hidden = !isMobile() || state.drawerOpen;
      syncPanelA11y();
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => map?.resize(), 120);
    });

    void loadFeed(true);
  </script>
</RadarLayout>

