---
/**
 * Radar home: desktop = split map|list (variant A), mobile = map HUD (variant C).
 */
import maplibreCss from "maplibre-gl/dist/maplibre-gl.css?url";
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Stromausfälle Schweiz: aktuell & geplant | outage.ch"
  description="Aktuelle und geplante Stromausfälle in der Schweiz mit Ort, Beginn, Ende, Dauer, Ursache, betroffener Region und nachvollziehbaren Quellen."
  canonical="https://outage.ch/"
  robots="index,follow,max-image-preview:large"
  shell="radar"
  activeNav="radar"
>
  <link slot="head" rel="stylesheet" href={maplibreCss} />

  <section class="radar" data-radar>
    <div class="radar__map-wrap">
      <div id="radar-map" class="radar__map" role="img" aria-label="Karte der Stromausfall-Meldungen"></div>
      <div class="radar__legend" aria-hidden="true">
        <span data-tone="active">Aktiv</span>
        <span data-tone="upcoming">Geplant</span>
        <span data-tone="resolved">Behoben</span>
        <span data-tone="other">Archiv</span>
      </div>
    </div>

    <header class="radar__hud">
      <div class="radar__hud-bar">
        <a class="radar__brand" href="/">outage.ch</a>
        <label class="radar__search">
          <span class="sr-only">Ort suchen</span>
          <input id="radar-search" type="search" placeholder="Ort oder Region" autocomplete="off" enterkeyhint="search" />
        </label>
        <button type="button" id="radar-locate" class="radar__locate" title="In der Nähe">Nähe</button>
      </div>
      <div id="radar-chips" class="radar__chips" role="toolbar" aria-label="Status filtern"></div>
    </header>

    <aside class="radar__panel" id="radar-panel">
      <div class="radar__panel-head">
        <div>
          <h1>Meldungen</h1>
          <p id="radar-count" class="radar__count">…</p>
        </div>
        <button type="button" id="radar-refresh" class="radar__text-btn">Aktualisieren</button>
        <button type="button" id="radar-panel-close" class="radar__text-btn radar__panel-close">Schliessen</button>
      </div>
      <div id="radar-list" class="radar__list" aria-live="polite" aria-busy="true">
        <div class="radar-skel"></div>
        <div class="radar-skel"></div>
        <div class="radar-skel"></div>
      </div>
      <div class="radar__panel-foot">
        <button type="button" id="radar-more" hidden>Weitere laden</button>
        <p id="radar-note" class="radar__note">Meldungen werden geladen …</p>
      </div>
    </aside>

    <div id="radar-sheet" class="radar__sheet" hidden>
      <button type="button" id="radar-sheet-close" class="radar__sheet-x" aria-label="Schliessen">×</button>
      <div id="radar-sheet-body"></div>
      <a id="radar-sheet-link" class="radar__cta" href="#">Details öffnen</a>
    </div>

    <button type="button" id="radar-list-fab" class="radar__fab">Liste</button>
  </section>

  <p class="radar__disclaimer">outage.ch ist ein unabhängiger öffentlicher Radar und kein offizieller Notfallkanal.</p>

  <script>
    type PublicItem = {
      id: number;
      location: string;
      canton: string | null;
      url: string;
      status: "upcoming" | "active" | "resolved" | "stale_unconfirmed" | "historical" | null;
      nature: "planned" | "unplanned" | "unknown";
      summary: string;
      cause: string | null;
      source: { publisher: string; domain: string };
      latitude?: number | null;
      longitude?: number | null;
    };

    type Category = "active" | "upcoming" | "resolved" | "other";

    const STATUS_FILTERS = [
      { key: "", label: "Alle" },
      { key: "active", label: "Aktiv" },
      { key: "upcoming", label: "Geplant" },
      { key: "resolved", label: "Behoben" },
      { key: "historical", label: "Archiv" }
    ] as const;

    const COLOR: Record<Category, string> = {
      active: "#c2410c",
      upcoming: "#b45309",
      resolved: "#15803d",
      other: "#64748b"
    };

    const CANTON_CENTROIDS: Record<string, [number, number]> = {
      ZH: [47.3769, 8.5417], BE: [46.948, 7.4474], LU: [47.0502, 8.3093],
      UR: [46.8817, 8.6444], SZ: [47.0207, 8.652], OW: [46.898, 8.244],
      NW: [46.9581, 8.366], GL: [47.0404, 9.068], ZG: [47.1662, 8.5155],
      FR: [46.8065, 7.162], SO: [47.2088, 7.5323], BS: [47.5596, 7.5886],
      BL: [47.4418, 7.764], SH: [47.696, 8.634], AR: [47.3667, 9.3],
      AI: [47.331, 9.409], SG: [47.4245, 9.3767], GR: [46.8499, 9.5329],
      AG: [47.3925, 8.0444], TG: [47.556, 8.896], TI: [46.2044, 9.024],
      VD: [46.5197, 6.6323], VS: [46.2276, 7.3606], NE: [46.99, 6.929],
      GE: [46.2044, 6.1432], JU: [47.365, 7.345]
    };

    const state = {
      items: [] as PublicItem[],
      nextCursor: null as string | null,
      query: "",
      status: "",
      selectedId: null as number | null,
      loading: false,
      error: null as string | null,
      generatedAt: null as string | null,
      drawerOpen: false
    };

    let map: any = null;
    let maplibregl: any = null;
    let mapReady = false;

    const listEl = document.querySelector<HTMLElement>("#radar-list")!;
    const chipsEl = document.querySelector<HTMLElement>("#radar-chips")!;
    const countEl = document.querySelector<HTMLElement>("#radar-count")!;
    const noteEl = document.querySelector<HTMLElement>("#radar-note")!;
    const moreBtn = document.querySelector<HTMLButtonElement>("#radar-more")!;
    const searchEl = document.querySelector<HTMLInputElement>("#radar-search")!;
    const panelEl = document.querySelector<HTMLElement>("#radar-panel")!;
    const sheetEl = document.querySelector<HTMLElement>("#radar-sheet")!;
    const sheetBody = document.querySelector<HTMLElement>("#radar-sheet-body")!;
    const sheetLink = document.querySelector<HTMLAnchorElement>("#radar-sheet-link")!;
    const fabEl = document.querySelector<HTMLButtonElement>("#radar-list-fab")!;

    const escapeHtml = (value: unknown) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const categorize = (status: PublicItem["status"]): Category => {
      if (status === "active") return "active";
      if (status === "upcoming") return "upcoming";
      if (status === "resolved") return "resolved";
      return "other";
    };

    const statusLabel = (status: PublicItem["status"]) => {
      if (status === "active") return "Aktiv";
      if (status === "upcoming") return "Geplant";
      if (status === "resolved") return "Behoben";
      if (status === "stale_unconfirmed") return "Unbestätigt";
      if (status === "historical") return "Archiv";
      return "Unklar";
    };

    const natureLabel = (nature: PublicItem["nature"]) => {
      if (nature === "planned") return "geplant";
      if (nature === "unplanned") return "ungeplant";
      return "unklar";
    };

    const isMobile = () => window.matchMedia("(max-width: 899px)").matches;

    const pinFor = (item: PublicItem): [number, number] | null => {
      if (typeof item.latitude === "number" && typeof item.longitude === "number") {
        return [item.longitude, item.latitude];
      }
      if (item.canton && CANTON_CENTROIDS[item.canton]) {
        const [lat, lon] = CANTON_CENTROIDS[item.canton];
        const j = ((item.id % 17) - 8) * 0.012;
        return [lon + ((item.id % 13) - 6) * 0.012, lat + j];
      }
      return null;
    };

    const filtered = () => {
      const q = state.query.trim().toLowerCase();
      return state.items.filter((item) => {
        if (state.status === "historical") {
          if (item.status !== "historical" && item.status !== "stale_unconfirmed") return false;
        } else if (state.status && item.status !== state.status) {
          return false;
        }
        if (!q) return true;
        const hay = `${item.location} ${item.canton ?? ""} ${item.summary} ${item.cause ?? ""}`.toLowerCase();
        return hay.includes(q);
      });
    };

    async function ensureMap() {
      if (map) {
        map.resize();
        return map;
      }
      const mod = await import("maplibre-gl");
      maplibregl = mod.default;
      const container = document.querySelector("#radar-map");
      if (!container) return null;
      map = new maplibregl.Map({
        container,
        style: "https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json",
        center: [8.2, 46.8],
        zoom: 7.15,
        attributionControl: false,
        fadeDuration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 250
      });
      map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-right");
      await new Promise<void>((resolve) => map.once("load", () => resolve()));
      map.addSource("outages", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
      map.addLayer({
        id: "outages-halo",
        type: "circle",
        source: "outages",
        paint: { "circle-radius": 16, "circle-color": ["get", "color"], "circle-opacity": 0.18 }
      });
      map.addLayer({
        id: "outages-point",
        type: "circle",
        source: "outages",
        paint: {
          "circle-radius": ["case", ["==", ["get", "selected"], 1], 9, 6],
          "circle-color": ["get", "color"],
          "circle-stroke-color": "#ffffff",
          "circle-stroke-width": 2
        }
      });
      map.on("click", "outages-point", (e: any) => {
        const id = Number(e.features?.[0]?.properties?.id);
        if (!Number.isFinite(id)) return;
        selectItem(id, { openSheet: isMobile() });
      });
      map.on("mouseenter", "outages-point", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "outages-point", () => {
        map.getCanvas().style.cursor = "";
      });
      mapReady = true;
      return map;
    }

    function syncMap() {
      if (!map || !mapReady) return;
      const features = filtered()
        .map((item) => {
          const coords = pinFor(item);
          if (!coords) return null;
          const category = categorize(item.status);
          return {
            type: "Feature" as const,
            properties: {
              id: item.id,
              color: COLOR[category],
              selected: state.selectedId === item.id ? 1 : 0
            },
            geometry: { type: "Point" as const, coordinates: coords }
          };
        })
        .filter(Boolean);

      map.getSource("outages")?.setData({ type: "FeatureCollection", features });
      map.resize();

      if (state.selectedId != null) {
        const sel = state.items.find((i) => i.id === state.selectedId);
        const coords = sel ? pinFor(sel) : null;
        if (coords) {
          map.easeTo({ center: coords, zoom: Math.max(map.getZoom(), 10.2), duration: 420 });
          return;
        }
      }
      if (features.length > 0) {
        const bounds = new maplibregl.LngLatBounds();
        for (const f of features as any[]) bounds.extend(f.geometry.coordinates);
        map.fitBounds(bounds, { padding: isMobile() ? 56 : 48, maxZoom: 11, duration: 0 });
      }
    }

    function rowHtml(item: PublicItem, selected: boolean) {
      const badge = item.status ?? "historical";
      return `
        <a class="radar-row ${selected ? "is-selected" : ""}" href="${escapeHtml(item.url)}" data-id="${item.id}">
          <div class="radar-row__top">
            <h2>${escapeHtml(item.location)}${item.canton ? ` <span class="radar-row__canton">${escapeHtml(item.canton)}</span>` : ""}</h2>
            <span class="radar-badge radar-badge--${escapeHtml(badge)}">${escapeHtml(statusLabel(item.status))}</span>
          </div>
          <p>${escapeHtml(item.summary)}</p>
          <div class="radar-row__meta">${escapeHtml(natureLabel(item.nature))} · ${escapeHtml(item.source.publisher)}${selected ? ` · <span data-nav>Details öffnen</span>` : ""}</div>
        </a>`;
    }

    function renderChips() {
      const counts: Record<string, number> = { "": 0, active: 0, upcoming: 0, resolved: 0, historical: 0 };
      for (const item of state.items) {
        counts[""] += 1;
        if (item.status === "active") counts.active += 1;
        else if (item.status === "upcoming") counts.upcoming += 1;
        else if (item.status === "resolved") counts.resolved += 1;
        else counts.historical += 1;
      }
      chipsEl.innerHTML = STATUS_FILTERS.map(
        (f) =>
          `<button type="button" class="radar-chip" data-status="${f.key}" aria-pressed="${state.status === f.key}">${f.label}<span class="n">${counts[f.key] ?? 0}</span></button>`
      ).join("");
    }

    function renderList() {
      const items = filtered();
      const mapped = items.filter((i) => pinFor(i)).length;
      countEl.textContent = `${items.length} sichtbar · ${mapped} auf Karte`;
      listEl.setAttribute("aria-busy", state.loading ? "true" : "false");

      if (state.loading && !state.items.length) {
        listEl.innerHTML = `<div class="radar-skel"></div><div class="radar-skel"></div><div class="radar-skel"></div>`;
        return;
      }
      if (state.error && !state.items.length) {
        listEl.innerHTML = `<p class="radar__empty">${escapeHtml(state.error)}</p>`;
        return;
      }
      if (!items.length) {
        listEl.innerHTML = `<p class="radar__empty">Keine Meldungen für diesen Filter.</p>`;
        return;
      }
      listEl.innerHTML = items.map((i) => rowHtml(i, state.selectedId === i.id)).join("");
    }

    function openSheet(id: number) {
      const item = state.items.find((i) => i.id === id);
      if (!item) return;
      sheetBody.innerHTML = `
        <div class="radar-row__top">
          <h2 style="margin:0;font:750 1.05rem/1.25 var(--font-display)">${escapeHtml(item.location)}</h2>
          <span class="radar-badge radar-badge--${escapeHtml(item.status ?? "historical")}">${escapeHtml(statusLabel(item.status))}</span>
        </div>
        <p style="margin:.5rem 0 0;color:var(--color-muted);font-size:.9rem;line-height:1.45">${escapeHtml(item.summary)}</p>
        <div class="radar-row__meta">${escapeHtml(natureLabel(item.nature))} · ${escapeHtml(item.source.publisher)}</div>`;
      sheetLink.href = item.url;
      sheetEl.hidden = false;
    }

    function closeSheet() {
      sheetEl.hidden = true;
    }

    function setDrawer(open: boolean) {
      state.drawerOpen = open;
      panelEl.classList.toggle("is-open", open);
      fabEl.hidden = open || !isMobile();
      document.body.classList.toggle("radar-drawer-open", open);
    }

    function selectItem(id: number, opts: { openSheet?: boolean } = {}) {
      state.selectedId = id;
      renderList();
      syncMap();
      if (opts.openSheet && isMobile()) {
        setDrawer(false);
        openSheet(id);
      }
      const row = listEl.querySelector<HTMLElement>(`[data-id="${id}"]`);
      row?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    }

    function renderAll() {
      renderChips();
      renderList();
      moreBtn.hidden = !state.nextCursor;
      noteEl.textContent = state.generatedAt
        ? `Stand ${new Date(state.generatedAt).toLocaleString("de-CH", { dateStyle: "short", timeStyle: "short" })}`
        : state.loading
          ? "Meldungen werden geladen …"
          : "";
      fabEl.hidden = !isMobile() || state.drawerOpen;
      void ensureMap().then(() => syncMap());
    }

    async function loadFeed(reset = true) {
      if (state.loading) return;
      state.loading = true;
      state.error = null;
      if (reset) {
        state.items = [];
        state.nextCursor = null;
      }
      renderAll();
      try {
        const params = new URLSearchParams({ limit: "40" });
        if (!reset && state.nextCursor) params.set("before", state.nextCursor);
        const res = await fetch(`/api/public/events?${params}`, { cache: "no-store" });
        if (!res.ok) throw new Error(`API ${res.status}`);
        const data = (await res.json()) as { items: PublicItem[]; next_cursor: string | null; generated_at?: string };
        state.items = reset ? data.items : [...state.items, ...data.items];
        state.nextCursor = data.next_cursor;
        state.generatedAt = data.generated_at ?? new Date().toISOString();
      } catch (err) {
        state.error = err instanceof Error ? err.message : "Laden fehlgeschlagen";
      } finally {
        state.loading = false;
        renderAll();
      }
    }

    chipsEl.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-status]");
      if (!btn) return;
      state.status = btn.dataset.status ?? "";
      renderAll();
    });

    listEl.addEventListener("click", (ev) => {
      const t = ev.target as HTMLElement;
      const row = t.closest<HTMLAnchorElement>("a.radar-row[data-id]");
      if (!row) return;
      const mouse = ev as MouseEvent;
      if (t.closest("[data-nav]") || mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.button === 1) return;
      ev.preventDefault();
      const id = Number(row.dataset.id);
      if (!Number.isFinite(id)) return;
      if (isMobile()) selectItem(id, { openSheet: true });
      else selectItem(id);
    });

    searchEl.addEventListener("input", () => {
      state.query = searchEl.value;
      renderAll();
    });

    document.querySelector("#radar-refresh")?.addEventListener("click", () => void loadFeed(true));
    moreBtn.addEventListener("click", () => void loadFeed(false));
    document.querySelector("#radar-sheet-close")?.addEventListener("click", () => {
      closeSheet();
      state.selectedId = null;
      renderAll();
    });
    document.querySelector("#radar-panel-close")?.addEventListener("click", () => setDrawer(false));
    fabEl.addEventListener("click", () => setDrawer(true));
    document.querySelector("#radar-locate")?.addEventListener("click", () => {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition((pos) => {
        void ensureMap().then(() => {
          map?.easeTo({ center: [pos.coords.longitude, pos.coords.latitude], zoom: 11, duration: 500 });
        });
      });
    });

    window.addEventListener("resize", () => {
      fabEl.hidden = !isMobile() || state.drawerOpen;
      if (!isMobile()) {
        setDrawer(false);
        closeSheet();
      }
      map?.resize();
    });

    void loadFeed(true);
  </script>
</RadarLayout>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .radar {
    position: relative;
    min-height: calc(100dvh - var(--app-dock-h));
    background: var(--color-surface-2);
  }

  .radar__map-wrap {
    position: absolute;
    inset: 0;
  }

  .radar__map {
    width: 100%;
    height: 100%;
    background: #d7e2dd;
  }

  .radar__legend {
    position: absolute;
    left: 0.65rem;
    bottom: 0.65rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    pointer-events: none;
  }

  .radar__legend span {
    background: rgb(255 255 255 / 0.92);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    font: 650 0.65rem/1.2 var(--font-mono);
  }

  .radar__legend [data-tone="active"] { color: var(--status-active); }
  .radar__legend [data-tone="upcoming"] { color: var(--status-upcoming); }
  .radar__legend [data-tone="resolved"] { color: var(--status-resolved); }
  .radar__legend [data-tone="other"] { color: var(--status-other); }

  .radar__hud {
    position: relative;
    z-index: 5;
    padding: 0.7rem;
    pointer-events: none;
  }

  .radar__hud > * {
    pointer-events: auto;
  }

  .radar__hud-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border-radius: var(--app-radius);
    background: rgb(255 255 255 / 0.9);
    border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow: 0 10px 28px rgb(15 23 42 / 0.12);
  }

  @supports (backdrop-filter: blur(12px)) {
    .radar__hud-bar {
      background: rgb(255 255 255 / 0.72);
      backdrop-filter: blur(14px) saturate(1.15);
    }
  }

  .radar__brand {
    font: 800 0.95rem/1 var(--font-display);
    color: var(--color-ink);
    text-decoration: none;
  }

  .radar__search input {
    width: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.52rem 0.85rem;
    background: var(--color-surface);
    font: 500 0.9rem/1.2 var(--font-body);
  }

  .radar__locate,
  .radar__text-btn {
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    border-radius: 999px;
    padding: 0.48rem 0.75rem;
    font: 650 0.75rem/1 var(--font-body);
    cursor: pointer;
    color: var(--color-ink);
  }

  .radar__text-btn {
    border: 0;
    background: transparent;
    color: var(--color-accent);
    padding: 0.25rem;
  }

  .radar__chips {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    margin-top: 0.55rem;
    padding-bottom: 0.1rem;
    -webkit-overflow-scrolling: touch;
  }

  .radar__chips .radar-chip {
    box-shadow: 0 4px 12px rgb(15 23 42 / 0.08);
  }

  .radar__panel {
    position: absolute;
    z-index: 6;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 72dvh;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: 18px 18px 0 0;
    box-shadow: 0 -12px 40px rgb(15 23 42 / 0.18);
    transform: translateY(110%);
    transition: transform 0.28s var(--ease-out);
  }

  .radar__panel.is-open {
    transform: translateY(0);
  }

  .radar__panel[hidden] {
    display: none !important;
  }

  .radar__panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1rem 0.45rem;
  }

  .radar__panel-head h1 {
    margin: 0;
    font: 750 1.15rem/1.2 var(--font-display);
  }

  .radar__count,
  .radar__note {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font: 500 0.75rem/1.3 var(--font-mono);
  }

  .radar__panel-close {
    display: inline;
  }

  .radar__list {
    overflow: auto;
    flex: 1;
    -webkit-overflow-scrolling: touch;
  }

  .radar__panel-foot {
    padding: 0.65rem 1rem 1rem;
    border-top: 1px solid var(--color-rule);
  }

  #radar-more {
    width: 100%;
