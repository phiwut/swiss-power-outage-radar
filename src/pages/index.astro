---
import RadarLayout from "../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Stromausfall Schweiz aktuell | outage.ch"
  description="Stromausfall Radar für die Schweiz: aktuelle öffentliche Hinweise zu Stromausfällen, Netzunterbrüchen, Status, Ursachen und Quellenlage."
>
  <section class="py-4 sm:py-6">
    <div class="panel rounded-md p-4 sm:p-6">
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-end">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">outage.ch</p>
          <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold leading-tight sm:text-5xl">Stromausfall Radar Schweiz</h1>
          <p class="mt-3 max-w-2xl text-base leading-7 text-muted">
            Öffentliche Hinweise zu Stromausfällen, Stromunterbrüchen und Netzstörungen in der Schweiz. Automatisch gesammelt, zusammengefasst und mit Quellenlage eingeordnet.
          </p>
        </div>
        <div class="grid gap-2">
          <label class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted" for="event-search">Ort oder Quelle suchen</label>
          <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]">
            <input id="event-search" class="rounded-md border border-rule bg-surface px-3 py-3 text-sm text-ink placeholder:text-faint" placeholder="z.B. Belp, Freiamt, AEW" />
            <button id="refresh-button" class="rounded-md border border-ink bg-ink px-4 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-surface" type="button">Aktualisieren</button>
          </div>
        </div>
      </div>

      <div id="public-metrics" class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {["Gemeldet", "Zu prüfen", "Gut belegt", "Behoben"].map((label) => (
          <div class="loading-stripe h-20 rounded-md border border-rule bg-surface2 p-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="grid gap-4 pb-28 lg:grid-cols-[minmax(0,1fr)_320px] lg:pb-8">
    <main class="panel rounded-md">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule px-4 py-3">
        <div>
          <h2 class="font-display text-xl font-bold">Aktuelle Meldungen</h2>
          <p class="mt-1 text-sm text-muted">Nach erster Erkennung sortiert. Archivierte Fehlalarme sind ausgeblendet.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <select id="status-filter" class="rounded-md border border-rule bg-surface px-3 py-2 text-sm text-ink">
            <option value="public">Aktuelle Hinweise</option>
            <option value="all">Alle inkl. Archiv</option>
            <option value="needs_review">Zu prüfen</option>
            <option value="corroborated">Gut belegt</option>
            <option value="resolved">Behoben</option>
          </select>
          <span id="event-count" class="rounded-md border border-rule bg-surface2 px-3 py-2 font-mono text-[11px] text-muted">-</span>
        </div>
      </div>
      <div id="events-list" class="grid gap-3 p-3 sm:p-4">
        <div class="loading-stripe h-48 rounded-md bg-surface2"></div>
        <div class="loading-stripe h-48 rounded-md bg-surface2"></div>
      </div>
    </main>

    <aside class="grid h-fit gap-4">
      <section class="panel rounded-md p-4">
        <h2 class="font-display text-lg font-bold">So lesen Sie die Hinweise</h2>
        <div class="mt-3 grid gap-3 text-sm leading-6 text-muted">
          <p><strong class="text-ink">Status</strong> zeigt, ob der Unterbruch als aktiv, behoben, unklar oder noch zu prüfen gilt.</p>
          <p><strong class="text-ink">Quellenlage</strong> fasst die Belege als schwach, mittel oder stark zusammen.</p>
          <p><strong class="text-ink">Sicherheit</strong> ist eine verständliche Einordnung, keine offizielle Bestätigung.</p>
        </div>
      </section>

      <section class="panel rounded-md p-4">
        <h2 class="font-display text-lg font-bold">Hinweis</h2>
        <p class="mt-2 text-sm leading-6 text-muted">outage.ch ist ein Radar aus öffentlichen Quellen. Prüfen Sie bei kritischen Situationen immer Gemeinde, Netzbetreiber oder Behörden.</p>
      </section>

      <section id="admin-panel" class="hidden panel rounded-md p-4">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-display text-lg font-bold">Admin Dashboard</h2>
          <button id="admin-logout" class="rounded-md border border-rule bg-surface2 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted" type="button">Logout</button>
        </div>
        <div id="admin-dashboard" class="mt-3 grid gap-2"></div>
      </section>

      <section id="admin-login-panel" class="panel rounded-md p-4">
        <h2 class="font-display text-lg font-bold">Admin</h2>
        <p class="mt-1 text-sm text-muted">Interne Daten werden erst nach Token-Login angezeigt.</p>
        <input id="admin-token-input" class="mt-3 w-full rounded-md border border-rule bg-surface px-3 py-2 font-mono text-xs text-ink" type="password" placeholder="Admin Token" />
        <p id="admin-token-state" class="mt-2 font-mono text-[10px] text-muted">Nicht angemeldet</p>
      </section>
    </aside>
  </section>

  <nav class="fixed inset-x-2 bottom-2 z-40 grid gap-2 rounded-md border border-rule bg-surface/95 p-2 shadow-panel backdrop-blur lg:hidden">
    <input id="mobile-search" class="rounded-md border border-rule bg-surface2 px-3 py-2 text-sm text-ink placeholder:text-faint" placeholder="Ort suchen" />
    <div class="grid grid-cols-[1fr_auto_auto] gap-2">
      <select id="mobile-status-filter" class="min-w-0 rounded-md border border-rule bg-surface2 px-2 py-2 text-sm text-ink">
        <option value="public">Aktuell</option>
        <option value="all">Alle</option>
        <option value="needs_review">Zu prüfen</option>
        <option value="corroborated">Belegt</option>
        <option value="resolved">Behoben</option>
      </select>
      <button id="mobile-refresh" class="rounded-md border border-rule bg-surface2 px-3 py-2 font-mono text-[11px] uppercase text-ink" type="button">Neu</button>
      <button id="mobile-admin" class="rounded-md border border-ink bg-ink px-3 py-2 font-mono text-[11px] uppercase text-surface" type="button">Admin</button>
    </div>
  </nav>

  <script>
    const fmt = new Intl.DateTimeFormat("de-CH", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "Europe/Zurich"
    });

    const viewState = {
      events: [],
      status: "public",
      query: "",
      data: null
    };

    const labels = {
      status: {
        active: "Aktiv",
        resolved: "Behoben",
        unknown: "Unklar",
        needs_review: "Zu prüfen",
        dismissed: "Verworfen"
      },
      nature: {
        planned: "Geplant",
        unplanned: "Ungeplant",
        unknown: "Unklar"
      },
      cause: {
        planned_maintenance: "Wartung",
        weather: "Wetter",
        tree_or_overhead_line: "Baum / Freileitung",
        construction_damage: "Bauarbeiten",
        cable_damage: "Kabelschaden",
        transformer_or_substation: "Trafostation",
        technical_fault: "Technische Störung",
        fire: "Brand",
        overload: "Überlast",
        third_party_damage: "Dritteinwirkung",
        water_or_flooding: "Wasser",
        unknown: "Unbekannt"
      }
    };

    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
    const label = (group, value) => labels[group]?.[value] ?? value ?? "-";

    function parseFactSheet(event) {
      if (!event.fact_sheet_json) return null;
      try {
        return JSON.parse(event.fact_sheet_json);
      } catch {
        return null;
      }
    }

    function incidentStatus(event) {
      const fact = parseFactSheet(event);
      if (event.status === "dismissed") return "dismissed";
      if (event.status === "needs_review") return "needs_review";
      if (event.status === "resolved" || fact?.status === "resolved") return "resolved";
      if (fact?.status === "active") return "active";
      return "unknown";
    }

    function sourceLabel(event) {
      if (event.evidence_level === "official") return "Offizielle Quelle";
      if (Number(event.source_count ?? 0) >= 2) return "Mehrere Quellen";
      if (Number(event.source_count ?? 0) === 1) return "1 Quelle";
      return "Keine Quelle";
    }

    function sourceQualityLabel(event) {
      if (event.evidence_level === "official" || event.evidence_level === "corroborated") return "stark";
      if (event.evidence_level === "plausible" || Number(event.source_count ?? 0) >= 2) return "mittel";
      return "schwach";
    }

    function certaintyLabel(event) {
      if (event.evidence_level === "official" || event.evidence_level === "corroborated") return "Gut belegt";
      if (event.evidence_level === "plausible" || Number(event.source_count ?? 0) >= 2) return "Wahrscheinlich";
      return "Unklar";
    }

    function badgeClass(kind, value) {
      if (kind === "status" && value === "active") return "border-warn bg-warnsoft text-warn";
      if (kind === "status" && value === "resolved") return "border-ok bg-oksoft text-ok";
      if (kind === "status" && value === "dismissed") return "border-rule bg-surface2 text-muted";
      if (kind === "source" && value.includes("Offizielle")) return "border-ok bg-oksoft text-ok";
      if (kind === "quality" && value === "stark") return "border-ok bg-oksoft text-ok";
      if (kind === "quality" && value === "mittel") return "border-accent bg-accentsoft text-accent";
      if (kind === "certainty" && value === "Gut belegt") return "border-ok bg-oksoft text-ok";
      if (kind === "certainty" && value === "Wahrscheinlich") return "border-accent bg-accentsoft text-accent";
      return "border-rule bg-surface2 text-muted";
    }

    function formatDate(value) {
      if (!value) return "-";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : fmt.format(date);
    }

    function durationText(event) {
      if (!event.started_at_estimate || !event.resolved_at_estimate) return "Dauer nicht belegt";
      return `${formatDate(event.started_at_estimate)} bis ${formatDate(event.resolved_at_estimate)}`;
    }

    function summaryText(event) {
      const fact = parseFactSheet(event);
      return fact?.summary_de || event.research_summary_de || event.summary || event.primary_source_title || "Zu dieser Meldung liegt noch keine belastbare Kurzfassung vor.";
    }

    function visibleEvents() {
      const query = viewState.query.toLowerCase();
      return (viewState.events ?? [])
        .filter((event) => {
          if (viewState.status === "public" && event.status === "dismissed") return false;
          if (viewState.status !== "public" && viewState.status !== "all" && event.status !== viewState.status) return false;
          const haystack = `${event.location_text ?? ""} ${event.primary_source_title ?? ""} ${event.cause_category ?? ""} ${summaryText(event)}`.toLowerCase();
          return haystack.includes(query);
        })
        .sort((a, b) => new Date(b.first_seen_at ?? b.last_seen_at).getTime() - new Date(a.first_seen_at ?? a.last_seen_at).getTime());
    }

    function renderMetrics(data) {
      const events = data.events ?? [];
      const publicEvents = events.filter((event) => event.status !== "dismissed");
      const metrics = [
        ["Gemeldet", publicEvents.length, "aktuelle Hinweise"],
        ["Zu prüfen", publicEvents.filter((event) => event.status === "needs_review").length, "brauchen Einordnung"],
        ["Gut belegt", publicEvents.filter((event) => certaintyLabel(event) === "Gut belegt").length, "starke Quellenlage"],
        ["Behoben", publicEvents.filter((event) => incidentStatus(event) === "resolved").length, "als behoben erkannt"]
      ];
      document.querySelector("#public-metrics").innerHTML = metrics.map(([name, value, hint]) => `
        <div class="rounded-md border border-rule bg-surface/90 p-3">
          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">${escapeHtml(name)}</span>
          <div class="mt-2 flex items-end justify-between gap-2">
            <strong class="metric-value block font-display text-3xl font-bold leading-none">${escapeHtml(value)}</strong>
            <span class="pb-1 text-right text-xs text-muted">${escapeHtml(hint)}</span>
          </div>
        </div>
      `).join("");
    }

    function renderEvents() {
      const rows = visibleEvents();
      document.querySelector("#event-count").textContent = `${rows.length} Hinweise`;
      document.querySelector("#events-list").innerHTML = rows.map((event) => {
        const status = incidentStatus(event);
        const source = sourceLabel(event);
        const quality = sourceQualityLabel(event);
        const certainty = certaintyLabel(event);
        const summary = summaryText(event);
        return `
          <article class="rounded-md border border-rule bg-surface p-4 shadow-panel">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="clamp-title font-display text-2xl font-bold leading-tight">${escapeHtml(event.location_text || "Ort unklar")}</h3>
                <p class="mt-1 text-sm text-muted">Erstmals erkannt: ${escapeHtml(formatDate(event.first_seen_at))}</p>
              </div>
              <a href="/events/${event.id}" class="rounded-md border border-ink bg-ink px-3 py-2 text-center font-mono text-[11px] uppercase tracking-[0.08em] text-surface">Details öffnen</a>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="rounded-md border px-2 py-1 text-xs font-semibold ${badgeClass("status", status)}">${escapeHtml(label("status", status))}</span>
              <span class="rounded-md border border-rule bg-surface2 px-2 py-1 text-xs font-semibold">${escapeHtml(label("nature", event.outage_nature || "unknown"))}</span>
              <span class="rounded-md border border-rule bg-surface2 px-2 py-1 text-xs font-semibold">${escapeHtml(label("cause", event.cause_category || "unknown"))}</span>
              <span class="rounded-md border px-2 py-1 text-xs font-semibold ${badgeClass("source", source)}">${escapeHtml(source)}</span>
              <span class="rounded-md border px-2 py-1 text-xs font-semibold ${badgeClass("quality", quality)}">Quellenlage: ${escapeHtml(quality)}</span>
              <span class="rounded-md border px-2 py-1 text-xs font-semibold ${badgeClass("certainty", certainty)}">Sicherheit: ${escapeHtml(certainty)}</span>
            </div>
            <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted">${escapeHtml(summary)}</p>
            <div class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
              <div class="rounded-md border border-rule bg-surface2 p-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Quellenlage</span>
                <strong class="mt-1 block">${escapeHtml(quality)}</strong>
              </div>
              <div class="rounded-md border border-rule bg-surface2 p-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Belege</span>
                <strong class="mt-1 block">${escapeHtml(source)}</strong>
              </div>
              <div class="rounded-md border border-rule bg-surface2 p-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Dauer</span>
                <strong class="mt-1 block">${escapeHtml(durationText(event))}</strong>
              </div>
            </div>
          </article>
        `;
      }).join("") || `<div class="rounded-md border border-rule bg-surface p-6 text-sm text-muted">Keine passenden Hinweise gefunden.</div>`;
    }

    function renderAdminDashboard(data) {
      const runs = data.runs ?? [];
      const lastRun = data.lastRun ?? {};
      const events = data.events ?? [];
      document.querySelector("#admin-dashboard").innerHTML = `
        <div class="rounded-md border border-rule bg-surface2 p-3 text-sm">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Letzter Run</p>
          <strong>${escapeHtml(lastRun.status ?? "-")}</strong>
          <p class="mt-1 text-muted">${escapeHtml(lastRun.items_seen ?? 0)} Items gesehen · ${escapeHtml(lastRun.items_new ?? 0)} neu · ${escapeHtml(lastRun.emails_sent ?? 0)} Mails</p>
        </div>
        <div class="rounded-md border border-rule bg-surface2 p-3 text-sm">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">Interne Counts</p>
          <p class="mt-1 text-muted">${events.length} Events geladen · ${runs.length} Runs im Debugfenster</p>
        </div>
        <a class="rounded-md border border-rule bg-surface px-3 py-2 text-center font-mono text-[11px] uppercase tracking-[0.08em] text-ink" href="/status">Geschützten JSON-Status öffnen</a>
      `;
    }

    function syncAdmin() {
      const token = localStorage.getItem("outage_admin_token") ?? "";
      document.querySelector("#admin-token-input").value = token;
      document.querySelector("#admin-token-state").textContent = token ? "Angemeldet" : "Nicht angemeldet";
      document.querySelector("#admin-panel").classList.toggle("hidden", !token);
      if (viewState.data && token) renderAdminDashboard(viewState.data);
    }

    async function loadRadar() {
      document.querySelector("#events-list").classList.add("opacity-60");
      const response = await fetch("/api/public/status", { cache: "no-store" });
      if (!response.ok) throw new Error("Status konnte nicht geladen werden");
      const data = await response.json();
      viewState.data = data;
      viewState.events = data.events ?? [];
      renderMetrics(data);
      renderEvents();
      syncAdmin();
      document.querySelector("#events-list").classList.remove("opacity-60");
    }

    function setQuery(value) {
      viewState.query = value ?? "";
      document.querySelector("#event-search").value = viewState.query;
      document.querySelector("#mobile-search").value = viewState.query;
      renderEvents();
    }

    function setStatus(value) {
      viewState.status = value;
      document.querySelector("#status-filter").value = value;
      document.querySelector("#mobile-status-filter").value = value;
      renderEvents();
    }

    document.querySelector("#event-search").addEventListener("input", (event) => setQuery(event.target.value));
    document.querySelector("#mobile-search").addEventListener("input", (event) => setQuery(event.target.value));
    document.querySelector("#status-filter").addEventListener("change", (event) => setStatus(event.target.value));
    document.querySelector("#mobile-status-filter").addEventListener("change", (event) => setStatus(event.target.value));
    document.querySelector("#refresh-button").addEventListener("click", () => loadRadar());
    document.querySelector("#mobile-refresh").addEventListener("click", () => loadRadar());
    document.querySelector("#mobile-admin").addEventListener("click", () => {
      document.querySelector("#admin-login-panel").scrollIntoView({ behavior: "smooth", block: "center" });
      document.querySelector("#admin-token-input").focus();
    });
    document.querySelector("#admin-token-input").addEventListener("input", (event) => {
      const token = event.target.value.trim();
      if (token) localStorage.setItem("outage_admin_token", token);
      else localStorage.removeItem("outage_admin_token");
      syncAdmin();
    });
    document.querySelector("#admin-logout").addEventListener("click", () => {
      localStorage.removeItem("outage_admin_token");
      syncAdmin();
    });
    window.addEventListener("outage:admin-login", () => {
      document.querySelector("#admin-login-panel").scrollIntoView({ behavior: "smooth", block: "center" });
      document.querySelector("#admin-token-input").focus();
    });

    loadRadar().catch((error) => {
      document.querySelector("#events-list").innerHTML = `<div class="rounded-md border border-danger bg-dangersoft p-6 text-danger">${escapeHtml(error.message)}</div>`;
    });
  </script>
</RadarLayout>
