---
import RadarLayout from "../../layouts/RadarLayout.astro";
import { SITE_ORIGIN } from "../../public-url";
import { organizationId, SITE_DESCRIPTION } from "../../seo-site";
import AppBreadcrumb from "@/components/app/AppBreadcrumb.astro";
import PageCta from "@/components/app/PageCta.astro";
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Badge } from "@/components/starwind/badge";
import "../../styles/knowledge.css";

const canonical = `${SITE_ORIGIN}/ueber/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Methodik von outage.ch",
      description: SITE_DESCRIPTION,
      inLanguage: "de-CH",
      mainEntity: { "@id": organizationId() }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
        { "@type": "ListItem", position: 2, name: "Methodik", item: canonical }
      ]
    }
  ]
};
---

<RadarLayout
  title="Methodik: so arbeitet outage.ch | outage.ch"
  description="Wie outage.ch öffentliche Stromausfälle in der Schweiz erfasst, welche Quellenregel gilt und was die Seite nicht ist."
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto w-full max-w-4xl">
    <AppBreadcrumb items={[
      { href: "/", label: "Stromausfälle" },
      { label: "Methodik" }
    ]} />

    <header class="border-b border-border pb-10">
      <Badge tone="neutral" appearance="soft" size="sm" class="font-mono uppercase tracking-wider">
        Über outage.ch
      </Badge>
      <h1 class="font-heading mt-4 max-w-[18ch] text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Ein öffentlicher Radar, kein Notfallkanal
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted-foreground">
        outage.ch sammelt öffentlich zugängliche Meldungen zu Stromausfällen und geplanten Unterbrüchen in der Schweiz. Die Seite ist unabhängig, quellentransparent und ersetzt weder Netzbetreiber noch Behörden.
      </p>
      <Alert class="mt-6 max-w-xl">
        <AlertDescription>{SITE_DESCRIPTION}</AlertDescription>
      </Alert>
      <p class="mt-6 font-mono text-xs text-muted-foreground">Aktualisiert am 18. August 2026</p>
    </header>

    <div class="article-body mt-10">
      <section>
        <h2>Was outage.ch zeigt</h2>
        <p class="article-lead">
          Jede öffentliche Vorfallsseite nennt Ort, Art, Status, belegte Zeiten, Ursache soweit bekannt und die Originalquellen.
        </p>
        <p>
          Der Radar auf der Startseite bündelt aktuelle, bevorstehende, behobene und historische Meldungen. Geplante Unterbrüche erscheinen nach ihrem angekündigten Beginn. Unbelegte Schätzungen zur Wiederherstellung werden nicht als Tatsache dargestellt.
        </p>
      </section>
      <section>
        <h2>Quellenregel</h2>
        <p>
          Ein Ereignis wird nur veröffentlicht, wenn mindestens eine offizielle Netzbetreiber- oder Behördenquelle vorliegt oder mindestens zwei unabhängige glaubwürdige Quellen dasselbe Ereignis belegen. Ein einzelner Medien- oder Alert-Hinweis bleibt intern.
        </p>
        <p>
          Google Alerts dienen der Entdeckung, nicht als Wahrheit. Direkte Betreiberseiten, Störungskarten und Behördenkanäle haben Vorrang. Relevante Seiten werden intern archiviert; öffentlich sichtbar bleibt nur, was zum veröffentlichten Ereignis gehört.
        </p>
        <p>
          Alertswiss wird über den öffentlichen JSON-Feed gelesen, aber nur für strombezogene Warnungen. Testmeldungen und andere Lagen wie Feuerverbote bleiben aussen vor. outage.ch übernimmt keine Alertswiss-Volltexte; zitiert wird mit «Quelle: www.alertswiss.ch». Die Daten stehen unter CC BY-NC-SA 2.5 CH.
        </p>
      </section>
      <section>
        <h2>ElCom-Kennzahlen auf Betreiberseiten</h2>
        <p>
          Wo die ElCom H4-Standardtarife 2026 veröffentlicht, zeigt die Betreiberseite den Mittelwert über die Gemeinden dieses Werks, aufgeteilt in Energie und Netznutzung. Das ist ein Snapshot der offenen ElCom-Daten, kein individueller Rechnungsbetrag und kein Ersatz für den{' '}
          <a href="https://www.strompreis.elcom.admin.ch/">ElCom-Strompreisrechner</a>.
        </p>
      </section>
      <section>
        <h2>Was outage.ch nicht ist</h2>
        <ul>
          <li>Kein Pikettdienst und keine Stelle, bei der Sie einen Ausfall melden können.</li>
          <li>Kein Ersatz für Alertswiss, Kantone oder den Notruf 112.</li>
          <li>Keine behördliche Bestätigung nur weil ein Eintrag öffentlich ist.</li>
          <li>Kein vollständiges Verzeichnis aller Schweizer Elektrizitätswerke.</li>
        </ul>
      </section>
      <section>
        <h2>Kontakt</h2>
        <p>
          Betrieb: outage.ch, E-Mail <a href="mailto:alert@outage.ch">alert@outage.ch</a>.
          Für eine konkrete Störung wenden Sie sich an den{' '}
          <a href="/netzbetreiber/">zuständigen Verteilnetzbetreiber</a>.
        </p>
      </section>
    </div>

    <PageCta
      title="Zum Radar"
      description="Aktuelle und geplante Stromausfälle in der Schweiz."
      href="/"
      label="Übersicht öffnen"
    />
  </article>
</RadarLayout>
