---
import RadarLayout from "../../layouts/RadarLayout.astro";
import {
  ELCOM_PRICE_URL,
  elcomFactsDisclaimer,
  elcomFactsForSlug,
  elcomFactsInsight,
  elcomFactsRows
} from "../../elcom-operator-facts";
import {
  operatorBySlug,
  operatorDefinition,
  operatorFaqs,
  operatorLanguageNote,
  operatorProfileUrl,
  operatorSourceExplanation,
  publicOperatorProfiles,
  relatedOperatorProfiles,
  sourceCategoryLabel
} from "../../operators";
import { SITE_ORIGIN } from "../../public-url";
import { operatorPageJsonLd } from "../../seo-operator-page";
import AppBreadcrumb from "@/components/app/AppBreadcrumb.astro";
import AppList from "@/components/app/AppList.astro";
import AppListRow from "@/components/app/AppListRow.astro";
import ArticleLayout from "@/components/app/ArticleLayout.astro";
import PageCta from "@/components/app/PageCta.astro";
import PageHero from "@/components/app/PageHero.astro";
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Button } from "@/components/starwind/button";
import { Prose } from "@/components/starwind/prose";
import ArrowUpRight from "@tabler/icons/outline/arrow-up-right.svg";

export function getStaticPaths() {
  return publicOperatorProfiles().map((operator) => ({
    params: { slug: operator.slug }
  }));
}

const slug = Astro.params.slug as string;
const operator = operatorBySlug(slug);
if (!operator) {
  throw new Error(`Unknown operator ${slug}`);
}

const canonical = `${SITE_ORIGIN}${operatorProfileUrl(operator)}`;
const definition = operatorDefinition(operator);
const languageNote = operatorLanguageNote(operator);
const sourceText = operatorSourceExplanation(operator);
const faqs = operatorFaqs(operator);
const related = relatedOperatorProfiles(operator, 4);
const elcom = elcomFactsForSlug(operator.slug);
const jsonLd = operatorPageJsonLd(operator, null);
---

<RadarLayout
  title={`Störungen ${operator.name}: offizielle Quelle | outage.ch`}
  description={definition}
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav="operators"
>
  <script slot="head" id="operator-jsonld" type="application/ld+json" set:html={jsonLd} />
  <article class="mx-auto w-full max-w-4xl">
    <AppBreadcrumb items={[
      { href: "/", label: "Stromausfälle" },
      { href: "/netzbetreiber/", label: "Netzbetreiber" },
      { label: operator.name }
    ]} />

    <PageHero
      kicker={`Verteilnetzbetreiber · ${sourceCategoryLabel(operator.sourceCategory)}`}
      title={`Störungen bei ${operator.name}`}
      lede={`${operator.name} versorgt ${operator.area}. Verbindliche Störungsmeldungen stehen auf der offiziellen Seite des Werks. outage.ch beobachtet diese Quelle und übernimmt nur öffentlich nachvollziehbare Stromereignisse in den Radar.`}
    >
      <Alert>
        <AlertDescription>{definition}</AlertDescription>
      </Alert>
    </PageHero>

    <ArticleLayout links={[
      { href: "#operator-live", label: "Meldungen im Radar" },
      ...(elcom ? [{ href: "#operator-facts", label: "ElCom-Kennzahlen" }] : []),
      { href: "#quelle", label: "Offizielle Quelle" },
      { href: "#radar", label: "Was outage.ch daraus macht" },
      { href: "#handeln", label: "Was Sie tun" },
      { href: "#faq", label: "Fragen" }
    ]}>
      <Prose class="max-w-none text-sm [--prose-heading-spacing:1.05em] [--prose-h2-size:1.2em] [--prose-spacing:0.75em] md:text-[0.95rem]">
        <section id="operator-live">
          <h2>Öffentliche Meldungen im Radar</h2>
          <p>
            Sobald outage.ch eine öffentlich belegte Meldung aus der Quelle von {operator.name} übernimmt, erscheinen hier Anzahl, Status und Links zu den Vorfallsseiten. Ohne Eintrag im Radar bleibt {operator.name} trotzdem zuständig.
          </p>
        </section>
        {elcom && (
          <section id="operator-facts">
            <h2>ElCom-Kennzahlen</h2>
            <p>{elcomFactsInsight(operator.name, elcom)}</p>
            <div class="stat-grid not-sw-prose">
              <dl>
                {elcomFactsRows(elcom).map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
              <p class="stat-grid__note">{elcomFactsDisclaimer()}</p>
            </div>
            <p class="not-sw-prose">
              <Button as="a" href={ELCOM_PRICE_URL} variant="outline" size="sm">
                ElCom-Strompreisübersicht öffnen
                <ArrowUpRight class="size-4" />
              </Button>
            </p>
          </section>
        )}
        <section id="quelle">
          <h2>Offizielle Störungsseite</h2>
          <p>
            {operator.name} veröffentlicht Störungen als {sourceCategoryLabel(operator.sourceCategory)}. Das ist die verbindliche Auskunft für {operator.area}.
          </p>
          <p>{sourceText}</p>
          {languageNote && <p>{languageNote}</p>}
          <p class="not-sw-prose">
            <Button as="a" href={operator.officialUrl} variant="default" size="sm">
              Offizielle Seite von {operator.name} öffnen
              <ArrowUpRight class="size-4" />
            </Button>
          </p>
        </section>
        <section id="radar">
          <h2>Was outage.ch daraus macht</h2>
          <p>
            Der Radar prüft die öffentliche Quelle von {operator.name} etwa alle {operator.checkMinutes} Minuten. In die öffentliche Übersicht gelangt ein Ereignis nur, wenn mindestens eine offizielle Netz- oder Behördenquelle vorliegt oder zwei unabhängige glaubwürdige Quellen dasselbe Ereignis belegen.
          </p>
          <p>
            outage.ch schätzt keine Wiederherstellungszeit und nimmt keine Störungsmeldungen für das Gebiet von {operator.name} entgegen. Fehlt auf der Originalseite eine Angabe, bleibt sie auf outage.ch offen.
          </p>
        </section>
        <section id="handeln">
          <h2>Wenn bei Ihnen der Strom fehlt</h2>
          <ol class="article-steps not-sw-prose">
            <li>
              <strong>Umfang prüfen</strong>
              <p>Nur die eigene Wohnung oder auch Nachbarn und Strasse? Interne Defekte gehören zur Elektrofachperson, Netzstörungen zu {operator.name}.</p>
            </li>
            <li>
              <strong>Offizielle Seite lesen</strong>
              <p>Zuerst die Störungsinfo von {operator.name} prüfen. Danach optional den Radar auf outage.ch, falls bereits eine öffentliche Meldung existiert.</p>
            </li>
            <li>
              <strong>Störung dort melden</strong>
              <p>Wenn keine Meldung sichtbar ist und mehrere Anschlüsse betroffen scheinen, den Pikettdienst von {operator.name} informieren.</p>
            </li>
          </ol>
          <p>
            Praktische Schritte für den Haushalt stehen im Ratgeber
            {" "}<a href="/ratgeber/stromausfall-was-tun/">Was tun bei Stromausfall?</a>
            {" "}Die Unterscheidung von Lieferant und Netzbetreiber erklärt
            {" "}<a href="/ratgeber/netzbetreiber-finden/">Netzbetreiber finden</a>.
          </p>
        </section>
        <section id="faq">
          <h2>Fragen zu {operator.name}</h2>
          <div id="operator-faq">
            {faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
        {related.length > 0 && (
          <section aria-labelledby="related-operators-heading">
            <h2 id="related-operators-heading">Andere beobachtete Netzbetreiber</h2>
            <div class="not-sw-prose">
              <AppList>
                {related.map((profile) => (
                  <AppListRow
                    href={`/netzbetreiber/${profile.slug}/`}
                    kicker={sourceCategoryLabel(profile.sourceCategory)}
                    title={profile.name}
                    description={profile.area}
                  />
                ))}
              </AppList>
            </div>
          </section>
        )}
      </Prose>
    </ArticleLayout>
    <PageCta
      title="Aktuelle Meldungen ansehen"
      description="Der Radar zeigt öffentlich belegte Ereignisse in der ganzen Schweiz."
      href="/"
      label="Zur Übersicht"
    />
  </article>
</RadarLayout>
