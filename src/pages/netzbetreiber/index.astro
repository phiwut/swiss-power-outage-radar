---
import RadarLayout from "../../layouts/RadarLayout.astro";
import { operatorProfileUrl, publicOperatorProfiles, sourceCategoryLabel } from "../../operators";
import { SITE_ORIGIN } from "../../public-url";
import PageCta from "@/components/app/PageCta.astro";
import { Alert, AlertDescription } from "@/components/starwind/alert";

const operators = publicOperatorProfiles();
const canonical = `${SITE_ORIGIN}/netzbetreiber/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Netzbetreiber Schweiz: Störungsseiten",
      description:
        "Verteilnetzbetreiber, deren öffentliche Störungsquellen outage.ch beobachtet, mit Gebiet und Link zur offiziellen Seite.",
      inLanguage: "de-CH",
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: operators.length,
        itemListElement: operators.map((operator, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${SITE_ORIGIN}${operatorProfileUrl(operator)}`,
          name: operator.name
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
        { "@type": "ListItem", position: 2, name: "Netzbetreiber", item: canonical }
      ]
    }
  ]
};
---

<RadarLayout
  title="Netzbetreiber Schweiz: Störungsseiten | outage.ch"
  description="Welche Verteilnetzbetreiber outage.ch beobachtet, wo deren offizielle Störungsseite liegt und wer bei einem Stromausfall zuständig ist."
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav="operators"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="mx-auto w-full max-w-4xl">
    <header class="border-b border-border pb-10">
      <p class="font-mono text-[0.66rem] font-medium tracking-[0.12em] text-muted-foreground uppercase">Verzeichnis · Schweiz</p>
      <h1 class="font-heading mt-3 max-w-[18ch] text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Netzbetreiber und offizielle Störungsseiten
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted-foreground">
        Für die Behebung eines Stromausfalls ist der Verteilnetzbetreiber zuständig, nicht der Stromlieferant. Hier stehen die Werke, deren öffentliche Quellen der Radar regelmässig prüft – jeweils mit Gebiet und, sobald vorhanden, der Zahl öffentlicher Meldungen im Radar.
      </p>
    </header>

    <Alert class="mt-6 max-w-xl">
      <AlertDescription id="operator-hub-live">
        Die Meldezahlen erscheinen, sobald outage.ch öffentlich belegte Ereignisse einem beobachteten Werk zuordnen kann.
      </AlertDescription>
    </Alert>

    <div class="operator-list mt-4 flex flex-col" id="operator-list">
      {operators.map((operator) => (
        <a
          href={operatorProfileUrl(operator)}
          data-operator-slug={operator.slug}
          class="flex flex-col gap-1 border-b border-border py-4 no-underline transition-colors first:border-t hover:bg-muted/50"
        >
          <strong class="font-heading text-lg tracking-tight">{operator.name}</strong>
          <span class="text-muted-foreground">
            {operator.area} · {sourceCategoryLabel(operator.sourceCategory)}
          </span>
        </a>
      ))}
    </div>

    <p class="mt-8 max-w-xl leading-relaxed text-muted-foreground">
      Fehlt Ihr Werk, bleibt es trotzdem zuständig. Wie Sie den Betreiber auf der Rechnung finden, erklärt der Ratgeber
      {" "}<a href="/ratgeber/netzbetreiber-finden/" class="underline underline-offset-4">Netzbetreiber finden</a>.
    </p>

    <PageCta
      title="Aktuelle Stromausfälle ansehen"
      description="Öffentlich belegte Meldungen in der ganzen Schweiz."
      href="/"
      label="Zum Radar"
    />
  </section>
</RadarLayout>
