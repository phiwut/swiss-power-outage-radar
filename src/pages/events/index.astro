---
import RadarLayout from "../../layouts/RadarLayout.astro";
---

<RadarLayout
  title="Stromausfall-Meldung | outage.ch"
  description="Bestätigte Stromausfall-Meldung mit bekannten Fakten und Originalquelle."
>
  <section class="detail-page">
    <a class="back-link" href="/">
      <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Alle Meldungen
    </a>
    <main id="event-shell" aria-live="polite" aria-busy="true">
      <div class="detail-loading"></div>
    </main>
  </section>

  <script>
    const eventId = location.pathname.match(/\/events\/(\d+)/)?.[1];
    const shell = document.querySelector<HTMLElement>("#event-shell")!;
    const escapeHtml = (value: unknown) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
    const fmt = new Intl.DateTimeFormat("de-CH", {
      dateStyle: "long", timeStyle: "short", timeZone: "Europe/Zurich"
    });
    const formatDate = (value: string) => {
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : fmt.format(date);
    };

    async function load(): Promise<void> {
      if (!eventId) throw new Error("Meldung nicht gefunden.");
      const response = await fetch(`/api/public/events/${eventId}`, { cache: "no-store" });
      if (!response.ok) throw new Error("Diese Meldung ist nicht mehr öffentlich verfügbar.");
      const data = await response.json();
      const item = data.item;
      const facts = Array.isArray(data.known_facts) ? data.known_facts : [];
      const trust = item.trust === "official" ? "Offizielle Quelle" : "Durch unabhängige Quellen bestätigt";
      shell.innerHTML = `<article class="detail-card">
        <header>
          <p class="section-label text-accent">Eingegangen ${escapeHtml(formatDate(item.received_at))}</p>
          <h1>${escapeHtml(item.location)}</h1>
          <p class="summary">${escapeHtml(item.summary)}</p>
        </header>
        ${facts.length ? `<section class="known-facts"><h2>Bekannte Fakten</h2><dl>${facts.map((fact: { label: string; value: string }) => `<div><dt>${escapeHtml(fact.label)}</dt><dd>${escapeHtml(fact.label === "Beginn" || fact.label === "Behoben" ? formatDate(fact.value) : fact.value)}</dd></div>`).join("")}</dl></section>` : ""}
        <section class="source-block">
          <div><span>${escapeHtml(trust)}</span><strong>${escapeHtml(item.source.publisher)}</strong><small>${escapeHtml(item.source.domain)}</small></div>
          <a href="${escapeHtml(item.source.url)}" target="_blank" rel="noreferrer">Originalquelle öffnen <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></a>
        </section>
      </article>`;
      shell.setAttribute("aria-busy", "false");
    }

    load().catch((error) => {
      shell.innerHTML = `<div class="detail-error"><strong>Meldung nicht verfügbar</strong><p>${escapeHtml(error instanceof Error ? error.message : String(error))}</p><a href="/">Zurück zur Übersicht</a></div>`;
      shell.setAttribute("aria-busy", "false");
    });
  </script>

  <style is:global>
    .detail-page { margin: 0 auto; max-width: 860px; padding: 2rem 0 5rem; }
    .back-link { align-items: center; color: var(--color-muted); display: inline-flex; font-size: .875rem; font-weight: 600; gap: .4rem; margin-bottom: 2rem; text-decoration: none; }
    .back-link:hover { color: var(--color-ink); }
    .detail-card { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: .75rem; box-shadow: 0 18px 50px color-mix(in oklch, var(--color-ink) 7%, transparent); overflow: hidden; }
    .detail-card > header { padding: clamp(1.5rem, 5vw, 3.5rem); }
    .detail-card h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 7vw, 4.25rem); font-weight: 800; letter-spacing: -.045em; line-height: 1; margin: .8rem 0 0; }
    .summary { color: var(--color-muted); font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.7; margin: 1.5rem 0 0; max-width: 680px; }
    .known-facts { border-top: 1px solid var(--color-rule); padding: clamp(1.5rem, 4vw, 2.5rem); }
    .known-facts h2 { font-family: var(--font-display); font-size: 1.15rem; margin: 0 0 1rem; }
    .known-facts dl { display: grid; gap: 0; margin: 0; }
    .known-facts dl div { border-top: 1px solid var(--color-rule); display: grid; gap: 1rem; grid-template-columns: 120px 1fr; padding: .9rem 0; }
    .known-facts dt { color: var(--color-muted); font-family: var(--font-mono); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
    .known-facts dd { margin: 0; }
    .source-block { align-items: center; background: var(--color-surface-2); border-top: 1px solid var(--color-rule); display: flex; gap: 1rem; justify-content: space-between; padding: 1.25rem clamp(1.5rem, 4vw, 2.5rem); }
    .source-block div { display: grid; gap: .2rem; }
    .source-block span, .source-block small { color: var(--color-muted); font-size: .72rem; }
    .source-block a { align-items: center; background: var(--color-ink); border-radius: var(--radius-md); color: var(--color-surface); display: inline-flex; font-size: .85rem; font-weight: 600; gap: .45rem; min-height: 2.75rem; padding: .65rem 1rem; text-decoration: none; }
    .detail-loading { animation: pulse 1.4s ease-in-out infinite; background: var(--color-surface-2); border-radius: .75rem; height: 420px; }
    .detail-error { background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: .75rem; display: grid; gap: .75rem; padding: 3rem; text-align: center; }
    .detail-error p { color: var(--color-muted); margin: 0; }
    .detail-error a { color: var(--color-accent); }
    @keyframes pulse { 50% { opacity: .58; } }
    @media (max-width: 640px) {
      .detail-page { padding-top: 1.25rem; }
      .known-facts dl div { gap: .3rem; grid-template-columns: 1fr; }
      .source-block { align-items: stretch; flex-direction: column; }
      .source-block a { justify-content: center; }
    }
  </style>
</RadarLayout>
