---
import RadarLayout from "../../layouts/RadarLayout.astro";
import {
  knowledgeArticles,
  knowledgeArticleUrl,
  knowledgeHeadingId,
  relatedKnowledgeArticles,
  type KnowledgeArticle
} from "../../knowledge";
import { operatorProfileUrl, publicOperatorProfiles } from "../../operators";
import { SITE_ORIGIN, DEFAULT_OG_IMAGE_PATH, absoluteUrl } from "../../public-url";
import { organizationId } from "../../seo-site";
import AppBreadcrumb from "@/components/app/AppBreadcrumb.astro";
import PageCta from "@/components/app/PageCta.astro";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/components/starwind/accordion";
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/starwind/table";
import { Badge } from "@/components/starwind/badge";
import "../../styles/knowledge.css";

export function getStaticPaths() {
  return knowledgeArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props as { article: KnowledgeArticle };
const canonical = new URL(knowledgeArticleUrl(article), SITE_ORIGIN).toString();
const related = relatedKnowledgeArticles(3, article.slug);
const operators = article.showOperatorDirectory ? publicOperatorProfiles() : [];
const published = article.publishedAt;
const modified = article.updatedAt;
const image = absoluteUrl(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN);
const dateLabel = new Intl.DateTimeFormat("de-CH", { dateStyle: "long" });

const graph: Record<string, unknown>[] = [
  {
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: article.title,
    description: article.description,
    datePublished: published,
    dateModified: modified,
    inLanguage: "de-CH",
    image,
    mainEntityOfPage: canonical,
    author: { "@id": organizationId() },
    publisher: { "@id": organizationId() }
  },
  {
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: article.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
      { "@type": "ListItem", position: 2, name: "Ratgeber", item: `${SITE_ORIGIN}/ratgeber/` },
      { "@type": "ListItem", position: 3, name: article.shortTitle, item: canonical }
    ]
  }
];

if (article.howto) {
  graph.push({
    "@type": "HowTo",
    "@id": `${canonical}#howto`,
    name: article.howto.name,
    description: article.definition,
    inLanguage: "de-CH",
    step: article.howto.steps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.title,
      text: step.text
    }))
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<RadarLayout
  title={article.seoTitle}
  description={article.description}
  canonical={canonical}
  ogType="article"
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav={article.slug === "stromausfall-was-tun" ? "help" : "ratgeber"}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto w-full max-w-4xl">
    <AppBreadcrumb items={[
      { href: "/", label: "Stromausfälle" },
      { href: "/ratgeber/", label: "Ratgeber" },
      { label: article.shortTitle }
    ]} />

    <header class="border-b border-border pb-10">
      <Badge tone="neutral" appearance="soft" size="sm" class="font-mono uppercase tracking-wider">
        Ratgeber · {article.readingMinutes} Minuten
      </Badge>
      <h1 class="font-heading mt-4 max-w-[18ch] text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        {article.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted-foreground">{article.intro}</p>
      <Alert class="mt-6 max-w-xl">
        <AlertDescription>{article.definition}</AlertDescription>
      </Alert>
      <p class="mt-6 font-mono text-xs text-muted-foreground">
        Veröffentlicht {dateLabel.format(new Date(published))}
        · Aktualisiert {dateLabel.format(new Date(modified))}
      </p>
    </header>

    <div class="article-layout">
      <aside class="article-toc">
        <strong>Inhalt</strong>
        {article.sections.map((section) => (
          <a href={`#${knowledgeHeadingId(section.heading)}`}>{section.heading}</a>
        ))}
      </aside>
      <div class="article-body">
        {article.sections.map((section) => (
          <section id={knowledgeHeadingId(section.heading)}>
            <h2>{section.heading}</h2>
            {section.lead && <p class="article-lead">{section.lead}</p>}
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.steps && (
              <ol class="article-steps">
                {section.steps.map((step) => (
                  <li>
                    <strong>{step.title}</strong>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>
            )}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {section.table && (
              <Table>
                <TableHeader>
                  <TableRow>
                    {section.table.headers.map((header) => <TableHead>{header}</TableHead>)}
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {section.table.rows.map((row) => (
                    <TableRow>
                      {row.map((cell) => <TableCell>{cell}</TableCell>)}
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            )}
          </section>
        ))}
        {operators.length > 0 && (
          <section>
            <p class="knowledge-eyebrow">Verzeichnis</p>
            <h2>Profilseiten der beobachteten Netzbetreiber</h2>
            <div class="operator-list">
              {operators.map((operator) => (
                <a href={operatorProfileUrl(operator)}>
                  <strong>{operator.name}</strong>
                  <span>{operator.area}</span>
                </a>
              ))}
            </div>
          </section>
        )}
        <section class="article-faq">
          <p class="knowledge-eyebrow">Häufige Fragen</p>
          <h2>Fragen und Antworten</h2>
          <Accordion type="single">
            {article.faqs.map((faq, index) => (
              <AccordionItem value={`faq-${index}`}>
                <AccordionTrigger>{faq.question}</AccordionTrigger>
                <AccordionContent>{faq.answer}</AccordionContent>
              </AccordionItem>
            ))}
          </Accordion>
        </section>
        <section class="article-sources">
          <p class="knowledge-eyebrow">Grundlagen</p>
          <h2>Offizielle Quellen und weiterführende Informationen</h2>
          {article.sources.map((source) => (
            <a href={source.url} target="_blank" rel="noreferrer">{source.label}<span>↗</span></a>
          ))}
        </section>
        <section>
          <p class="knowledge-eyebrow">Weiterlesen</p>
          <h2>Passende Ratgeber</h2>
          <div class="related-guides">
            {related.map((item) => (
              <a href={knowledgeArticleUrl(item)}>
                <small>{item.readingMinutes} Minuten</small>
                <strong>{item.shortTitle}</strong>
                <p>{item.description}</p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
    <PageCta
      title="Gibt es gerade einen Stromausfall?"
      description="Prüfen Sie die aktuellen und geplanten Meldungen."
      href="/"
      label="Zur Übersicht"
    />
  </article>
</RadarLayout>
