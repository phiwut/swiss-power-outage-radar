---
import RadarLayout from "../../layouts/RadarLayout.astro";
import {
  knowledgeArticles,
  knowledgeArticleUrl,
  knowledgeHeadingId,
  relatedKnowledgeArticles,
  type KnowledgeArticle
} from "../../knowledge";
import { operatorProfileUrl, publicOperatorProfiles } from "../../operators";
import { SITE_ORIGIN, DEFAULT_OG_IMAGE_PATH, absoluteUrl } from "../../public-url";
import { organizationId } from "../../seo-site";
import AppBreadcrumb from "@/components/app/AppBreadcrumb.astro";
import AppList from "@/components/app/AppList.astro";
import AppListRow from "@/components/app/AppListRow.astro";
import ArticleLayout from "@/components/app/ArticleLayout.astro";
import PageCta from "@/components/app/PageCta.astro";
import PageHero from "@/components/app/PageHero.astro";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/components/starwind/accordion";
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Prose } from "@/components/starwind/prose";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/starwind/table";

export function getStaticPaths() {
  return knowledgeArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props as { article: KnowledgeArticle };
const canonical = new URL(knowledgeArticleUrl(article), SITE_ORIGIN).toString();
const related = relatedKnowledgeArticles(3, article.slug);
const operators = article.showOperatorDirectory ? publicOperatorProfiles() : [];
const published = article.publishedAt;
const modified = article.updatedAt;
const image = absoluteUrl(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN);
const dateLabel = new Intl.DateTimeFormat("de-CH", { dateStyle: "long" });

const graph: Record<string, unknown>[] = [
  {
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: article.title,
    description: article.description,
    datePublished: published,
    dateModified: modified,
    inLanguage: "de-CH",
    image,
    mainEntityOfPage: canonical,
    author: { "@id": organizationId() },
    publisher: { "@id": organizationId() }
  },
  {
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: article.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
      { "@type": "ListItem", position: 2, name: "Ratgeber", item: `${SITE_ORIGIN}/ratgeber/` },
      { "@type": "ListItem", position: 3, name: article.shortTitle, item: canonical }
    ]
  }
];

if (article.howto) {
  graph.push({
    "@type": "HowTo",
    "@id": `${canonical}#howto`,
    name: article.howto.name,
    description: article.definition,
    inLanguage: "de-CH",
    step: article.howto.steps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.title,
      text: step.text
    }))
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<RadarLayout
  title={article.seoTitle}
  description={article.description}
  canonical={canonical}
  ogType="article"
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav={article.slug === "stromausfall-was-tun" ? "help" : "ratgeber"}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto w-full max-w-4xl">
    <AppBreadcrumb locale="de" items={[
      { href: "/", label: "Stromausfälle" },
      { href: "/ratgeber/", label: "Ratgeber" },
      { label: article.shortTitle }
    ]} />

    <PageHero
      kicker={`Ratgeber · ${article.readingMinutes} Minuten`}
      title={article.title}
      lede={article.intro}
    >
      <Alert>
        <AlertDescription>{article.definition}</AlertDescription>
      </Alert>
      <p class="text-muted-foreground font-mono text-[0.68rem]">
        Veröffentlicht {dateLabel.format(new Date(published))}
        · Aktualisiert {dateLabel.format(new Date(modified))}
      </p>
    </PageHero>

    <ArticleLayout locale="de" links={article.sections.map((section) => ({ href: `#${knowledgeHeadingId(section.heading)}`, label: section.heading }))}>
      <Prose class="max-w-none text-sm [--prose-heading-spacing:1.05em] [--prose-h2-size:1.2em] [--prose-spacing:0.75em] md:text-[0.95rem]">
        {article.sections.map((section) => (
          <section id={knowledgeHeadingId(section.heading)}>
            <h2>{section.heading}</h2>
            {section.lead && <p>{section.lead}</p>}
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.steps && (
              <ol class="article-steps not-sw-prose">
                {section.steps.map((step) => (
                  <li>
                    <strong>{step.title}</strong>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>
            )}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {section.table && (
              <div class="not-sw-prose">
                <Table>
                  <TableHeader>
                    <TableRow>
                      {section.table.headers.map((header) => <TableHead>{header}</TableHead>)}
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {section.table.rows.map((row) => (
                      <TableRow>
                        {row.map((cell) => <TableCell>{cell}</TableCell>)}
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </div>
            )}
          </section>
        ))}
        {operators.length > 0 && (
          <section>
            <h2>Profilseiten der beobachteten Netzbetreiber</h2>
            <div class="not-sw-prose">
              <AppList>
                {operators.map((operator) => (
                  <AppListRow href={operatorProfileUrl(operator)} title={operator.name} description={operator.area} />
                ))}
              </AppList>
            </div>
          </section>
        )}
        <section>
          <h2>Fragen und Antworten</h2>
          <div class="not-sw-prose">
            <Accordion type="single">
              {article.faqs.map((faq, index) => (
                <AccordionItem value={`faq-${index}`}>
                  <AccordionTrigger class="py-2.5 text-sm">{faq.question}</AccordionTrigger>
                  <AccordionContent>{faq.answer}</AccordionContent>
                </AccordionItem>
              ))}
            </Accordion>
          </div>
        </section>
        <section>
          <h2>Offizielle Quellen und weiterführende Informationen</h2>
          <div class="not-sw-prose">
            <AppList>
              {article.sources.map((source) => (
                <AppListRow href={source.url} title={source.label} target="_blank" rel="noreferrer" />
              ))}
            </AppList>
          </div>
        </section>
        <section>
          <h2>Passende Ratgeber</h2>
          <div class="not-sw-prose">
            <AppList>
              {related.map((item) => (
                <AppListRow
                  href={knowledgeArticleUrl(item)}
                  kicker={`${item.readingMinutes} Minuten`}
                  title={item.shortTitle}
                  description={item.description}
                />
              ))}
            </AppList>
          </div>
        </section>
      </Prose>
    </ArticleLayout>
    <PageCta
      title="Gibt es gerade einen Stromausfall?"
      description="Prüfen Sie die aktuellen und geplanten Meldungen."
      href="/"
      label="Zur Übersicht"
    />
  </article>
</RadarLayout>
