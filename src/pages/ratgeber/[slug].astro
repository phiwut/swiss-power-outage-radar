---
import RadarLayout from "../../layouts/RadarLayout.astro";
import {
  knowledgeArticles,
  knowledgeArticleUrl,
  knowledgeHeadingId,
  relatedKnowledgeArticles,
  type KnowledgeArticle
} from "../../knowledge";
import { operatorProfileUrl, publicOperatorProfiles } from "../../operators";
import { SITE_ORIGIN, DEFAULT_OG_IMAGE_PATH, absoluteUrl } from "../../public-url";
import { organizationId } from "../../seo-site";
import "../../styles/knowledge.css";

export function getStaticPaths() {
  return knowledgeArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props as { article: KnowledgeArticle };
const canonical = new URL(knowledgeArticleUrl(article), SITE_ORIGIN).toString();
const related = relatedKnowledgeArticles(3, article.slug);
const operators = article.showOperatorDirectory ? publicOperatorProfiles() : [];
const published = article.publishedAt;
const modified = article.updatedAt;
const image = absoluteUrl(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN);
const dateLabel = new Intl.DateTimeFormat("de-CH", { dateStyle: "long" });

const graph: Record<string, unknown>[] = [
  {
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: article.title,
    description: article.description,
    datePublished: published,
    dateModified: modified,
    inLanguage: "de-CH",
    image,
    mainEntityOfPage: canonical,
    author: { "@id": organizationId() },
    publisher: { "@id": organizationId() }
  },
  {
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: article.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
      { "@type": "ListItem", position: 2, name: "Ratgeber", item: `${SITE_ORIGIN}/ratgeber/` },
      { "@type": "ListItem", position: 3, name: article.shortTitle, item: canonical }
    ]
  }
];

if (article.howto) {
  graph.push({
    "@type": "HowTo",
    "@id": `${canonical}#howto`,
    name: article.howto.name,
    description: article.definition,
    inLanguage: "de-CH",
    step: article.howto.steps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.title,
      text: step.text
    }))
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<RadarLayout
  title={article.seoTitle}
  description={article.description}
  canonical={canonical}
  ogType="article"
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav={article.slug === "stromausfall-was-tun" ? "help" : "ratgeber"}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="knowledge-page">
    <nav aria-label="Breadcrumb"><a href="/">Stromausfälle</a><span>/</span><a href="/ratgeber/">Ratgeber</a></nav>
    <header class="knowledge-hero">
      <p class="knowledge-kicker">Ratgeber · {article.readingMinutes} Minuten</p>
      <h1>{article.title}</h1>
      <div class="lede">{article.intro}</div>
      <aside class="knowledge-definition">
        <p>{article.definition}</p>
      </aside>
      <small class="knowledge-meta">
        Veröffentlicht {dateLabel.format(new Date(published))}
        · Aktualisiert {dateLabel.format(new Date(modified))}
      </small>
    </header>
    <div class="article-layout">
      <aside class="article-toc">
        <strong>Inhalt</strong>
        {article.sections.map((section) => (
          <a href={`#${knowledgeHeadingId(section.heading)}`}>{section.heading}</a>
        ))}
      </aside>
      <div class="article-body">
        {article.sections.map((section) => (
          <section id={knowledgeHeadingId(section.heading)}>
            <h2>{section.heading}</h2>
            {section.lead && <p class="article-lead">{section.lead}</p>}
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.steps && (
              <ol class="article-steps">
                {section.steps.map((step) => (
                  <li>
                    <strong>{step.title}</strong>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>
            )}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {section.table && (
              <div class="article-table-wrap">
                <table class="article-table">
                  <thead>
                    <tr>{section.table.headers.map((header) => <th>{header}</th>)}</tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))}
        {operators.length > 0 && (
          <section>
            <p class="knowledge-eyebrow">Verzeichnis</p>
            <h2>Profilseiten der beobachteten Netzbetreiber</h2>
            <div class="operator-list">
              {operators.map((operator) => (
                <a href={operatorProfileUrl(operator)}>
                  <strong>{operator.name}</strong>
                  <span>{operator.area}</span>
                </a>
              ))}
            </div>
          </section>
        )}
        <section class="article-faq">
          <p class="knowledge-eyebrow">Häufige Fragen</p>
          <h2>Fragen und Antworten</h2>
          {article.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </section>
        <section class="article-sources">
          <p class="knowledge-eyebrow">Grundlagen</p>
          <h2>Offizielle Quellen und weiterführende Informationen</h2>
          {article.sources.map((source) => (
            <a href={source.url} target="_blank" rel="noreferrer">{source.label}<span>↗</span></a>
          ))}
        </section>
        <section>
          <p class="knowledge-eyebrow">Weiterlesen</p>
          <h2>Passende Ratgeber</h2>
          <div class="related-guides">
            {related.map((item) => (
              <a href={knowledgeArticleUrl(item)}>
                <small>{item.readingMinutes} Minuten</small>
                <strong>{item.shortTitle}</strong>
                <p>{item.description}</p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
    <footer class="knowledge-cta">
      <div><strong>Gibt es gerade einen Stromausfall?</strong><span>Prüfen Sie die aktuellen und geplanten Meldungen.</span></div>
      <a href="/">Zur Stromausfall-Übersicht</a>
    </footer>
  </article>
</RadarLayout>
