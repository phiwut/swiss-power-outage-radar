---
import RadarLayout from "../../layouts/RadarLayout.astro";
import { knowledgeArticles, knowledgeArticleUrl, type KnowledgeArticle } from "../../knowledge";

export function getStaticPaths() {
  return knowledgeArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props as { article: KnowledgeArticle };
const canonical = new URL(knowledgeArticleUrl(article), "https://outage.ch").toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonical}#article`,
      headline: article.title,
      description: article.description,
      dateModified: article.updatedAt,
      datePublished: article.updatedAt,
      inLanguage: "de-CH",
      mainEntityOfPage: canonical,
      author: { "@type": "Organization", name: "outage.ch", url: "https://outage.ch/" },
      publisher: { "@type": "Organization", name: "outage.ch", url: "https://outage.ch/" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: article.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: "https://outage.ch/" },
        { "@type": "ListItem", position: 2, name: "Ratgeber", item: "https://outage.ch/ratgeber/" },
        { "@type": "ListItem", position: 3, name: article.shortTitle, item: canonical }
      ]
    }
  ]
};
---

<RadarLayout
  title={`${article.shortTitle} | outage.ch`}
  description={article.description}
  canonical={canonical}
  ogType="article"
  robots="index,follow,max-image-preview:large"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="knowledge-article">
    <nav aria-label="Breadcrumb"><a href="/">Stromausfälle</a><span>/</span><a href="/ratgeber/">Ratgeber</a></nav>
    <header>
      <p>Ratgeber · {article.readingMinutes} Minuten</p>
      <h1>{article.title}</h1>
      <div>{article.intro}</div>
      <small>Aktualisiert am {new Intl.DateTimeFormat("de-CH", { dateStyle: "long" }).format(new Date(article.updatedAt))}</small>
    </header>
    <div class="article-layout">
      <aside>
        <strong>Inhalt</strong>
        {article.sections.map((section) => <a href={`#${section.heading.toLowerCase().replace(/[^a-z0-9äöü]+/g, "-")}`}>{section.heading}</a>)}
      </aside>
      <div class="article-body">
        {article.sections.map((section) => (
          <section id={section.heading.toLowerCase().replace(/[^a-z0-9äöü]+/g, "-")}>
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          </section>
        ))}
        <section class="article-faq">
          <p class="eyebrow">Häufige Fragen</p>
          <h2>Fragen und Antworten</h2>
          {article.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </section>
        <section class="article-sources">
          <p class="eyebrow">Grundlagen</p>
          <h2>Offizielle Quellen und weiterführende Informationen</h2>
          {article.sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer">{source.label}<span>↗</span></a>)}
        </section>
      </div>
    </div>
    <footer>
      <div><strong>Gibt es gerade einen Stromausfall?</strong><span>Prüfen Sie die aktuellen und geplanten Meldungen.</span></div>
      <a href="/">Zur Stromausfall-Übersicht</a>
    </footer>
  </article>

  <style>
    .knowledge-article { margin: 0 auto; max-width: 960px; padding: 1.5rem 0 6rem; }
    nav { color: var(--color-faint); display: flex; font-size: .78rem; gap: .5rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
    nav a { color: inherit; }
    header { border-bottom: 1px solid var(--color-rule); padding-bottom: clamp(2.5rem, 7vw, 5rem); }
    header > p, .eyebrow { color: #b4682e; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .09em; text-transform: uppercase; }
    h1 { font-family: var(--font-display); font-size: clamp(2.8rem, 8vw, 6rem); letter-spacing: -.065em; line-height: .96; margin: .8rem 0 1.5rem; text-wrap: balance; }
    header > div { color: var(--color-muted); font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.75; max-width: 760px; }
    header small { color: var(--color-faint); display: block; font-family: var(--font-mono); font-size: .68rem; margin-top: 1.5rem; }
    .article-layout { display: grid; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: 190px minmax(0, 1fr); padding-top: clamp(3rem, 7vw, 5.5rem); }
    aside { align-self: start; display: grid; gap: .65rem; position: sticky; top: 2rem; }
    aside strong { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .08em; margin-bottom: .4rem; text-transform: uppercase; }
    aside a { color: var(--color-muted); font-size: .78rem; line-height: 1.4; text-decoration: none; }
    aside a:hover { color: #b4682e; }
    .article-body { min-width: 0; }
    .article-body > section { border-top: 1px solid var(--color-rule); padding: 2.4rem 0; scroll-margin-top: 2rem; }
    .article-body > section:first-child { border-top: 0; padding-top: 0; }
    h2 { font-family: var(--font-display); font-size: clamp(1.65rem, 4vw, 2.5rem); letter-spacing: -.04em; line-height: 1.12; margin: 0 0 1.2rem; }
    .article-body p, li { font-size: 1rem; line-height: 1.78; }
    .article-body p { color: var(--color-muted); }
    ul { display: grid; gap: .8rem; padding-left: 1.25rem; }
    li::marker { color: #d4752c; }
    details { border-top: 1px solid var(--color-rule); }
    details:last-child { border-bottom: 1px solid var(--color-rule); }
    summary { cursor: pointer; font-family: var(--font-display); font-weight: 700; list-style: none; padding: 1.15rem 2rem 1.15rem 0; position: relative; }
    summary::after { color: #b4682e; content: "+"; position: absolute; right: .25rem; }
    details[open] summary::after { content: "–"; }
    details p { margin: 0; padding: 0 2rem 1.3rem 0; }
    .article-sources > a { align-items: center; border-top: 1px solid var(--color-rule); color: inherit; display: flex; gap: 1rem; justify-content: space-between; padding: 1rem 0; text-decoration: none; }
    .article-sources > a:last-child { border-bottom: 1px solid var(--color-rule); }
    .article-sources > a:hover { color: #b4682e; }
    footer { align-items: center; background: #17352f; border-radius: .35rem 1rem .35rem .35rem; color: white; display: flex; gap: 2rem; justify-content: space-between; margin-top: 4rem; padding: clamp(1.4rem, 4vw, 2.2rem); }
    footer > div { display: grid; gap: .3rem; }
    footer span { color: rgba(255,255,255,.68); font-size: .85rem; }
    footer a { background: #fffaf3; border-radius: .3rem; color: #17352f; flex: none; font-size: .8rem; font-weight: 700; padding: .8rem 1rem; text-decoration: none; }
    @media (max-width: 720px) {
      .article-layout { grid-template-columns: 1fr; }
      aside { display: none; }
      footer { align-items: stretch; flex-direction: column; }
      footer a { text-align: center; }
    }
  </style>
</RadarLayout>
