---
import RadarLayout from "../../layouts/RadarLayout.astro";
import { knowledgeArticles, knowledgeArticleUrl } from "../../knowledge";
import { SITE_ORIGIN } from "../../public-url";
import "../../styles/knowledge.css";

const canonical = `${SITE_ORIGIN}/ratgeber/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Stromausfall-Ratgeber Schweiz",
      description:
        "Verständliche Antworten zu Stromausfällen in der Schweiz: richtig handeln, Dauer einordnen, geplante Unterbrüche vorbereiten und den Netzbetreiber finden.",
      inLanguage: "de-CH",
      mainEntity: {
        "@type": "ItemList",
        itemListElement: knowledgeArticles.map((article, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${SITE_ORIGIN}${knowledgeArticleUrl(article)}`,
          name: article.title
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
        { "@type": "ListItem", position: 2, name: "Ratgeber", item: canonical }
      ]
    }
  ]
};
---

<RadarLayout
  title="Stromausfall-Ratgeber Schweiz | outage.ch"
  description="Verständliche Antworten zu Stromausfällen in der Schweiz: richtig handeln, Dauer und Ursachen einordnen, geplante Unterbrüche vorbereiten und Störungen melden."
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav="ratgeber"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="knowledge-hub">
    <header>
      <p>Wissen · Schweiz</p>
      <h1>Stromausfall verstehen und richtig handeln</h1>
      <div>Die Vorfallsseiten zeigen, was an einem konkreten Ort bekannt ist. Hier stehen die allgemeinen Fragen dahinter: Was tun, wen rufen, wie lange dauert es, und worin unterscheiden sich Ausfall, Mangellage und Blackout.</div>
    </header>
    <div class="knowledge-grid">
      {knowledgeArticles.map((article, index) => (
        <a href={knowledgeArticleUrl(article)}>
          <span class="knowledge-index">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <small>{article.readingMinutes} Minuten Lesezeit</small>
            <h2>{article.shortTitle}</h2>
            <p>{article.description}</p>
          </div>
          <svg class="knowledge-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ))}
    </div>
    <p style="margin-top:2rem;color:var(--color-muted);max-width:40rem;line-height:1.65;">
      Den zuständigen Verteilnetzbetreiber und dessen offizielle Störungsseite finden Sie im
      <a href="/netzbetreiber/">Netzbetreiber-Verzeichnis</a>. Wie outage.ch Quellen prüft, steht in der
      <a href="/ueber/">Methodik</a>.
    </p>
    <a class="back-to-events" href="/">
      Aktuelle Stromausfälle ansehen
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </section>
</RadarLayout>
