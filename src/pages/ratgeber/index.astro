---
import RadarLayout from "../../layouts/RadarLayout.astro";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import PageCta from "@/components/app/PageCta.astro";
import { knowledgeArticles, knowledgeArticleUrl } from "../../knowledge";
import { SITE_ORIGIN } from "../../public-url";

const canonical = `${SITE_ORIGIN}/ratgeber/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Stromausfall-Ratgeber Schweiz",
      description:
        "Verständliche Antworten zu Stromausfällen in der Schweiz: richtig handeln, Dauer einordnen, geplante Unterbrüche vorbereiten und den Netzbetreiber finden.",
      inLanguage: "de-CH",
      mainEntity: {
        "@type": "ItemList",
        itemListElement: knowledgeArticles.map((article, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${SITE_ORIGIN}${knowledgeArticleUrl(article)}`,
          name: article.title
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Stromausfälle Schweiz", item: `${SITE_ORIGIN}/` },
        { "@type": "ListItem", position: 2, name: "Ratgeber", item: canonical }
      ]
    }
  ]
};
---

<RadarLayout
  title="Stromausfall-Ratgeber Schweiz | outage.ch"
  description="Verständliche Antworten zu Stromausfällen in der Schweiz: richtig handeln, Dauer und Ursachen einordnen, geplante Unterbrüche vorbereiten und Störungen melden."
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav="ratgeber"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="mx-auto w-full max-w-4xl">
    <header class="border-b border-border pb-10">
      <p class="font-mono text-[0.66rem] font-medium tracking-[0.12em] text-muted-foreground uppercase">Wissen · Schweiz</p>
      <h1 class="font-heading mt-3 max-w-[18ch] text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Stromausfall verstehen und richtig handeln
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted-foreground">
        Die Vorfallsseiten zeigen, was an einem konkreten Ort bekannt ist. Hier stehen die allgemeinen Fragen dahinter: Was tun, wen rufen, wie lange dauert es, und worin unterscheiden sich Ausfall, Mangellage und Blackout.
      </p>
    </header>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {knowledgeArticles.map((article, index) => (
        <a href={knowledgeArticleUrl(article)} class="group block no-underline">
          <Card class="h-full transition-colors group-hover:bg-muted/60">
            <CardHeader>
              <span class="font-mono text-xs text-muted-foreground tabular-nums">{String(index + 1).padStart(2, "0")}</span>
              <p class="font-mono text-[0.66rem] tracking-wider text-muted-foreground uppercase">{article.readingMinutes} Minuten Lesezeit</p>
              <CardTitle class="font-heading text-2xl tracking-tight">{article.shortTitle}</CardTitle>
              <CardDescription class="text-pretty">{article.description}</CardDescription>
            </CardHeader>
          </Card>
        </a>
      ))}
    </div>

    <p class="mt-8 max-w-xl leading-relaxed text-muted-foreground">
      Den zuständigen Verteilnetzbetreiber und dessen offizielle Störungsseite finden Sie im
      {" "}<a href="/netzbetreiber/" class="underline underline-offset-4">Netzbetreiber-Verzeichnis</a>.
      Wie outage.ch Quellen prüft, steht in der
      {" "}<a href="/ueber/" class="underline underline-offset-4">Methodik</a>.
    </p>

    <PageCta
      title="Aktuelle Stromausfälle ansehen"
      description="Öffentlich belegte Meldungen auf der Karte und in der Liste."
      href="/"
      label="Zum Radar"
    />
  </section>
</RadarLayout>
