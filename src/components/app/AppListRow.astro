---
import type { HTMLAttributes } from "astro/types";
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";

interface Props extends HTMLAttributes<"a"> {
  title: string;
  description?: string;
  kicker?: string;
}

const { title, description, kicker, class: className, href, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={["app-list-row", className]}
  role="listitem"
  {...rest}
>
  <span class="app-list-row__content">
    {kicker && <span class="app-list-row__kicker">{kicker}</span>}
    <span class="app-list-row__title">{title}</span>
    {description && <span class="app-list-row__desc">{description}</span>}
  </span>
  <span class="app-list-row__chevron">
    <ChevronRight class="size-4" aria-hidden="true" />
  </span>
</a>

<style>
  .app-list-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out),
                padding-inline-start var(--dur-fast) var(--ease-out);
  }

  .app-list-row:last-child {
    border-bottom: 0;
  }

  .app-list-row:hover,
  .app-list-row:focus-visible {
    background: color-mix(in oklch, var(--muted) 55%, var(--card));
    padding-inline-start: 1rem;
  }

  .app-list-row:active {
    background: color-mix(in oklch, var(--muted) 75%, var(--card));
  }

  .app-list-row__content {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .app-list-row__kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 575;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }

  .app-list-row__title {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--foreground);
    line-height: 1.3;
  }

  .app-list-row__desc {
    font-size: 0.78rem;
    color: var(--muted-foreground);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .app-list-row__chevron {
    flex-shrink: 0;
    color: var(--muted-foreground);
    transition: transform var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .app-list-row:hover .app-list-row__chevron,
  .app-list-row:focus-visible .app-list-row__chevron {
    transform: translateX(2px);
    color: var(--foreground);
  }
</style>
