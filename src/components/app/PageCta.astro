---
import { Button } from "@/components/starwind/button";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";

interface Props {
  title: string;
  description: string;
  href: string;
  label: string;
}

const { title, description, href, label } = Astro.props;
---

<div class="page-cta">
  <div class="page-cta__copy">
    <span class="page-cta__title">{title}</span>
    <span class="page-cta__desc">{description}</span>
  </div>
  <Button as="a" href={href} size="sm" class="page-cta__btn">
    {label}
    <ArrowRight class="size-4" />
  </Button>
</div>

<style>
  .page-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg,
      color-mix(in oklch, var(--foreground) 4%, var(--card)) 0%,
      color-mix(in oklch, var(--brand-accent) 6%, var(--card)) 100%
    );
    border: 1px solid var(--border);
    box-shadow: 0 2px 12px color-mix(in oklch, var(--foreground) 4%, transparent);
  }

  .page-cta__copy {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .page-cta__title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .page-cta__desc {
    font-size: 0.78rem;
    color: var(--muted-foreground);
    line-height: 1.4;
  }

  .page-cta__btn {
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .page-cta {
      flex-direction: column;
      align-items: stretch;
    }

    .page-cta :global(.page-cta__btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
