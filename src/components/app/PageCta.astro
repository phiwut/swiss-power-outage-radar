---
import { Button } from "@/components/starwind/button";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";

interface Props {
  title: string;
  description: string;
  href: string;
  label: string;
}

const { title, description, href, label } = Astro.props;
---

<Card size="sm" class="mt-5 flex-row flex-wrap items-center justify-between gap-3 py-3 max-sm:flex-col max-sm:items-stretch">
  <CardHeader class="min-w-0 flex-1 py-0">
    <CardTitle class="text-sm">{title}</CardTitle>
    <CardDescription class="text-xs leading-snug">{description}</CardDescription>
  </CardHeader>
  <div class="px-(--card-spacing) max-sm:w-full">
    <Button as="a" href={href} variant="secondary" size="sm" class="max-sm:w-full">
      {label}
      <ArrowRight class="size-4" />
    </Button>
  </div>
</Card>
