---
import { Separator } from "@/components/starwind/separator";

interface Props {
  kicker: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="page-hero">
  <span class="page-hero__kicker">{kicker}</span>
  <h1 class="page-hero__title">{title}</h1>
  {lede && <p class="page-hero__lede">{lede}</p>}
  {Astro.slots.has("default") && (
    <div class="page-hero__slot">
      <slot />
    </div>
  )}
</header>
<Separator class="mb-5" />

<style>
  .page-hero {
    margin-bottom: 0.85rem;
  }

  .page-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.62rem;
    border-radius: 999px;
    background: linear-gradient(to right, var(--muted), color-mix(in oklch, var(--muted) 50%, var(--card)));
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .page-hero__title {
    margin: 0.6rem 0 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-wrap: balance;
    color: var(--foreground);
  }

  .page-hero__lede {
    margin: 0.55rem 0 0;
    max-width: 42rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .page-hero__slot {
    margin-top: 0.75rem;
    max-width: 42rem;
    display: grid;
    gap: 0.6rem;
  }

  .page-hero__slot :global([data-slot="alert"]) {
    padding: 0.75rem 0.9rem;
    font-size: 0.88rem;
    line-height: 1.5;
    border-radius: var(--radius);
    background: linear-gradient(to bottom, var(--muted), color-mix(in oklch, var(--muted) 60%, var(--card)));
  }

  @media (min-width: 640px) {
    .page-hero__lede {
      font-size: 0.98rem;
    }
  }
</style>
