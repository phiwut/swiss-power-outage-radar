---
import "../styles/global.css";

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = "Schweizer Stromausfall-Radar" } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Automatischer Stromausfall-Radar aus Google Alerts." />
    <title>{title}</title>
  </head>
  <body class="text-ink">
    <main class="page-enter mx-auto min-h-screen w-full max-w-7xl px-3 py-3 sm:px-5 lg:px-6">
      <header class="sticky top-3 z-30 grid gap-3 rounded-md border border-rule bg-surface/90 px-3 py-3 shadow-panel backdrop-blur sm:px-4 md:grid-cols-[1fr_auto] md:items-center">
        <a href="/" class="group inline-flex min-w-0 items-center gap-3" aria-label="Zur Aktenübersicht">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-md border border-rulestrong bg-ink text-surface">
            <span class="font-mono text-sm font-semibold">OR</span>
          </span>
          <span class="min-w-0">
            <span class="block font-mono text-[10px] uppercase tracking-[0.12em] text-muted">{eyebrow}</span>
            <span class="block truncate font-display text-xl font-bold leading-tight group-hover:text-accent">Stromausfall Radar</span>
          </span>
        </a>
        <nav class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
          <a class="rounded-md border border-rule bg-surface2 px-3 py-2 hover:border-rulestrong hover:text-ink" href="/">Akten</a>
          <button id="global-admin-button" class="rounded-md border border-rule bg-surface2 px-3 py-2 hover:border-rulestrong hover:text-ink" type="button">Admin</button>
        </nav>
      </header>
      <slot />
    </main>
    <script>
      document.querySelector("#global-admin-button")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("outage:admin-login"));
      });
    </script>
  </body>
</html>
