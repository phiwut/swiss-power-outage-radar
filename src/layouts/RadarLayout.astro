---
import "../styles/global.css";
import "../styles/app-shell.css";
import { Button } from "@/components/starwind/button";
import { ButtonGroup } from "@/components/starwind/button-group";
import { DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN, absoluteUrl } from "../public-url";
import { siteJsonLd } from "../seo-site";
import Bolt from "@tabler/icons/outline/bolt.svg";
import RadarIcon from "@tabler/icons/outline/radar-2.svg";
import Building from "@tabler/icons/outline/building.svg";
import Book from "@tabler/icons/outline/book-2.svg";
import Help from "@tabler/icons/outline/help-circle.svg";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  robots?: string;
  /** radar = full-bleed map home; content = article/detail shell */
  shell?: "radar" | "content";
  activeNav?: "radar" | "ratgeber" | "help" | "operators";
}

const {
  title,
  eyebrow = "Stromausfälle Schweiz",
  description = "Aktuelle Hinweise zu Stromausfällen und Netzunterbrüchen in der Schweiz aus öffentlichen Quellen und Google Alerts.",
  canonical,
  ogType = "website",
  ogImage = absoluteUrl(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN),
  robots,
  shell = "content",
  activeNav
} = Astro.props;

const canonicalUrl = canonical ?? absoluteUrl(Astro.url.pathname, SITE_ORIGIN);
const hideTopOnRadarMobile = shell === "radar";

const nav = [
  { href: "/", id: "radar" as const, label: "Radar" },
  { href: "/netzbetreiber/", id: "operators" as const, label: "Betreiber" },
  { href: "/ratgeber/", id: "ratgeber" as const, label: "Ratgeber" },
  { href: "/ratgeber/stromausfall-was-tun/", id: "help" as const, label: "Was tun?" }
];
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23131820'/%3E%3Cpath d='M35 8 17 37h14l-3 19 20-31H35V8Z' fill='none' stroke='%23fff' stroke-width='5' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="https://outage.ch/llms.txt" title="llms.txt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="outage.ch" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f6f4ef" />
    <script type="application/ld+json" set:html={siteJsonLd()} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class:list={["text-foreground", "shell-app", hideTopOnRadarMobile && "shell-radar"]}>
    <a class="skip-link" href="#app-main">Zum Inhalt springen</a>
    <div class="app-frame">
      <header class:list={["app-top", hideTopOnRadarMobile && "app-top--radar-desktop-only"]}>
        <a class="app-top__brand" href="/" aria-label="Zur Radar-Übersicht">
          <span class="app-top__mark" aria-hidden="true">
            <Bolt class="size-4" />
          </span>
          <span class="min-w-0">
            <span class="app-top__eyebrow">{eyebrow}</span>
            <span class="app-top__word">outage.ch</span>
          </span>
        </a>
        <nav class="app-top__nav" aria-label="Hauptnavigation">
          <ButtonGroup>
            {nav.map((item) => (
              <Button
                as="a"
                href={item.href}
                variant={activeNav === item.id ? "secondary" : "outline"}
                size="sm"
                aria-current={activeNav === item.id ? "page" : undefined}
              >
                {item.label}
              </Button>
            ))}
          </ButtonGroup>
        </nav>
      </header>

      <main id="app-main" class:list={["app-main", shell === "radar" ? "app-main--radar" : "app-main--content"]}>
        <slot />
        {shell === "content" && (
          <nav class="mt-8 flex flex-wrap gap-1" aria-label="Weitere Seiten">
            <Button as="a" href="/ueber/" variant="ghost" size="sm">Methodik</Button>
            <Button as="a" href="/netzbetreiber/" variant="ghost" size="sm">Netzbetreiber</Button>
            <Button as="a" href="/ratgeber/" variant="ghost" size="sm">Ratgeber</Button>
          </nav>
        )}
      </main>

      <nav class="app-dock" aria-label="App">
        <a href="/" aria-current={activeNav === "radar" ? "page" : undefined}>
          <RadarIcon class="size-[1.15rem]" aria-hidden="true" />
          Radar
        </a>
        <a href="/netzbetreiber/" aria-current={activeNav === "operators" ? "page" : undefined}>
          <Building class="size-[1.15rem]" aria-hidden="true" />
          Betreiber
        </a>
        <a href="/ratgeber/" aria-current={activeNav === "ratgeber" ? "page" : undefined}>
          <Book class="size-[1.15rem]" aria-hidden="true" />
          Ratgeber
        </a>
        <a href="/ratgeber/stromausfall-was-tun/" aria-current={activeNav === "help" ? "page" : undefined}>
          <Help class="size-[1.15rem]" aria-hidden="true" />
          Was tun?
        </a>
      </nav>
    </div>
  </body>
</html>
