---
import "../styles/global.css";
import "../styles/app-shell.css";
import { DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN, absoluteUrl } from "../public-url";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  robots?: string;
  /** radar = full-bleed map home; content = article/detail shell */
  shell?: "radar" | "content";
  activeNav?: "radar" | "ratgeber" | "help";
}

const {
  title,
  eyebrow = "Stromausfälle Schweiz",
  description = "Aktuelle Hinweise zu Stromausfällen und Netzunterbrüchen in der Schweiz aus öffentlichen Quellen und Google Alerts.",
  canonical,
  ogType = "website",
  ogImage = absoluteUrl(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN),
  robots,
  shell = "content",
  activeNav = "radar"
} = Astro.props;

const canonicalUrl = canonical ?? absoluteUrl(Astro.url.pathname, SITE_ORIGIN);
const hideTopOnRadarMobile = shell === "radar";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%2307131a'/%3E%3Cpath d='M35 8 17 37h14l-3 19 20-31H35V8Z' fill='none' stroke='%23fff' stroke-width='5' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="outage.ch" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f2f6f7" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class:list={["text-ink", "shell-app", hideTopOnRadarMobile && "shell-radar"]}>
    <div class="app-frame">
      <header class:list={["app-top", hideTopOnRadarMobile && "app-top--radar-desktop-only"]}>
        <a class="app-top__brand" href="/" aria-label="Zur Radar-Übersicht">
          <span class="app-top__mark" aria-hidden="true">
            <svg class="icon" viewBox="0 0 24 24" fill="none"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z"/></svg>
          </span>
          <span class="min-w-0">
            <span class="app-top__eyebrow">{eyebrow}</span>
            <span class="app-top__word">outage.ch</span>
          </span>
        </a>
        <nav class="app-top__nav" aria-label="Hauptnavigation">
          <a href="/" aria-current={activeNav === "radar" ? "page" : undefined}>Radar</a>
          <a href="/ratgeber/" aria-current={activeNav === "ratgeber" ? "page" : undefined}>Ratgeber</a>
          <a href="/ratgeber/stromausfall-was-tun/" aria-current={activeNav === "help" ? "page" : undefined}>Was tun?</a>
        </nav>
      </header>

      <main class:list={["app-main", shell === "radar" ? "app-main--radar" : "app-main--content"]}>
        <slot />
      </main>

      <nav class="app-dock" aria-label="App">
        <a href="/" aria-current={activeNav === "radar" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8" opacity=".45"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
          Radar
        </a>
        <a href="/ratgeber/" aria-current={activeNav === "ratgeber" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19.5V6a2 2 0 0 1 2-2h11v15.5"/><path d="M6 19.5h13"/><path d="M8 8h7M8 12h7"/></svg>
          Ratgeber
        </a>
        <a href="/ratgeber/stromausfall-was-tun/" aria-current={activeNav === "help" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.8 2.1c-.8.5-1.3 1-1.3 2"/><path d="M12 17h.01"/></svg>
          Was tun?
        </a>
      </nav>
    </div>
  </body>
</html>

<style is:global>
  .app-top--radar-desktop-only {
    display: none;
  }

  @media (min-width: 900px) {
    .app-top--radar-desktop-only {
      display: flex;
    }
  }

  .app-top__mark .icon {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .app-dock svg {
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
