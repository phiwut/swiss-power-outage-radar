---
import "../styles/global.css";
import { DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN, absoluteUrl } from "../public-url";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  robots?: string;
}

const {
  title,
  eyebrow = "Stromausfälle Schweiz",
  description = "Aktuelle Hinweise zu Stromausfällen und Netzunterbrüchen in der Schweiz aus öffentlichen Quellen und Google Alerts.",
  canonical,
  ogType = "website",
  ogImage = absoluteUrl(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN),
  robots
} = Astro.props;

const canonicalUrl = canonical ?? absoluteUrl(Astro.url.pathname, SITE_ORIGIN);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%2307131a'/%3E%3Cpath d='M35 8 17 37h14l-3 19 20-31H35V8Z' fill='none' stroke='%23fff' stroke-width='5' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="outage.ch" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="text-ink">
    <main class="page-enter mx-auto min-h-screen w-full max-w-7xl px-4 py-4 sm:px-6">
      <header class="mx-auto flex max-w-[960px] items-center justify-between border-b border-rule py-3">
        <a href="/" class="group inline-flex min-w-0 items-center gap-3" aria-label="Zur Ereignisübersicht">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-md bg-ink text-surface">
            <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block font-mono text-[10px] uppercase tracking-[0.12em] text-muted">{eyebrow}</span>
            <span class="block truncate font-display text-xl font-bold leading-tight group-hover:text-accent">outage.ch</span>
          </span>
        </a>
        <nav aria-label="Hauptnavigation" class="flex items-center gap-4 text-sm font-semibold">
          <a href="/" class="text-muted no-underline hover:text-ink">Meldungen</a>
          <a href="/ratgeber/" class="text-muted no-underline hover:text-ink">Ratgeber</a>
        </nav>
      </header>
      <slot />
    </main>
  </body>
</html>
