{
  "name": "swiss-power-outage-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --persist-to .wrangler/state",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply swiss-power-outage-radar --local",
    "db:migrate:remote": "wrangler d1 migrations apply swiss-power-outage-radar --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "astro": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@starwind-ui/astro": "^1.1.0",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "maplibre-gl": "^5.24.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
